{
  "description": "Prototype hooks: append a line on PreToolUse(Bash) and Stop.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/append.sh\" plugin-PreToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/append.sh\" plugin-Stop",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
