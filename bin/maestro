#!/usr/bin/env bash
# BottegaStack runtime CLI (shipped in the plugin's bin/; Claude Code's Bash
# tool has it on PATH, while hook shells call it through CLAUDE_PLUGIN_ROOT).
# Runs, worktrees, builds, guard hooks, project init/upgrade/seed.
# Run state lives outside the repo in a per-repo state directory.
set -euo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
STAMP="$(date +%Y%m%d-%H%M%S)"

usage() {
  cat <<'EOF'
Usage:
  maestro --version | -V | version
  maestro doctor
  maestro init [path]
  maestro seed <Name>
  maestro upgrade [path]
  maestro start "<title>"
  maestro hold <run> "<reason>" | --clear <run>
  maestro resume <run>
  maestro spec <run> [file]
  maestro check <run>
  maestro gate <run> [--allow-dirty] [--proof]
  maestro log <run> [<phase> <decision> <why> <evidence> <result>]
  maestro verify record <run> <AC> PASS|FAIL|INCONCLUSIVE --by <role> [--evidence <file>] [--note <text>]
  maestro verify waive <run> <AC> "<reason>" | list <run>
  maestro report [--retro] [--exit-code] | --close <run> [--playbook <p>] [--risk <r>] [--outcome <o>] | --finding <run> "<title>" | --trust [n]
  maestro build <run> <task> [--revise <file|->] [--block|--wait]
  maestro build --here <slug> --task "<text>" [--revise <file|->] [--block|--wait]
  maestro build --review <run> <task> | --here <slug> [--block|--wait]
  maestro build --init | --check
  maestro build --status <run>
  maestro watch <run> | --line
  maestro lab [trivial|bugfix|feature-fix|pause-resume] [--keep]
  maestro worktree create <run> <task> [--branch <name> [--base <ref>]]
  maestro worktree prune <run> [--force]
  maestro hooks install|uninstall [path]
  maestro skills list | install <name>... | install --all
  maestro skills uninstall <name>... | uninstall --all
  maestro tools install [--yes] | hint
  maestro statusline install [--yes] | status

Any command with --help or -h prints this help and changes nothing.

BottegaStack is a Claude Code plugin. The plugin puts `maestro` on PATH and ships
the agents, commands, skills, hooks, and the `resources/` templates beside it.

A run is one execution of a playbook. Its id is the slug; its branch is
the one you are on (`start --branch <name>` creates one). Run state lives outside the repo in
`${BOTTEGA_STATE_DIR:-${TMPDIR:-/tmp}/bottega-$(id -u)}/<repo-id>/<slug>/`.
Nothing is written into the repo or a worktree.

`maestro report --close <run> --outcome paused` logs the trust line and keeps the
run's state directory with a dated `paused` marker, so `spec`, `build --status`,
and `verify list` still resolve it and a resume can use it. Closing later with
`merged`, `pr`, or `rejected` removes the directory as usual.

Headless builder:
  `maestro build` runs the Claude Code `builder` agent headless on a third-party
  model. Credentials live in ~/.config/bottega/builder.env (create it with
  `maestro build --init`); they are never stored in the repo.
  `maestro build --here <slug>` is the light path: no run, spec, or worktree; it
  builds in the current checkout and keeps state in the state directory under
  quick/<slug>/.
  `maestro build --review <run> <task>` (or `--review --here <slug>` on the light path) runs the read-only `review-code` agent
  in the task worktree and writes build/<task>.review2.md.

Lab (opt-in, never in CI):
  `maestro lab` runs the real master on sonnet/low against a scenario in a
  scratch HOME, config, state, and temp dir. The builder is stubbed, so only the
  master calls a model. It needs CLAUDE_CODE_OAUTH_TOKEN or ANTHROPIC_API_KEY.

The skills stay organized by category; the plugin manifest points at each
category directory so Claude Code discovers the skills inside.
EOF
}

# The plugin version from the manifest beside bin/, or `unknown` when the file
# or field is missing. Read-only: version output must touch no state or builder.
maestro_version() {
  local file="$ROOT/.claude-plugin/plugin.json" ver=""
  if [ -f "$file" ]; then
    ver="$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$file" | head -1)"
  fi
  printf '%s\n' "${ver:-unknown}"
}

config_dir() {
  local dir=""
  case "$1" in
    claude)
      if [ -n "${CLAUDE_CONFIG_DIR:-}" ]; then
        dir="$CLAUDE_CONFIG_DIR"
      elif [ -n "${HOME:-}" ]; then
        dir="$HOME/.claude"
      fi
      printf '%s\n' "$dir"
      ;;
    *) echo "unknown target: $1" >&2; return 1 ;;
  esac
}

# ---- Standalone skills ------------------------------------------------------
# The checked-in list `skills/standalone.txt` decides which skills run without
# the stack. `install` copies a skill folder to <config>/skills/<name> and adds
# a `.bottega-managed` marker, so a copy can be listed, refreshed and removed
# without touching a user's own skill of the same name.
skills_dest() {
  local dir
  dir="$(config_dir claude)" || dir=""
  if [ -z "$dir" ]; then
    echo 'maestro skills: cannot find the Claude config dir; set CLAUDE_CONFIG_DIR or HOME' >&2
    return 1
  fi
  printf '%s\n' "$dir/skills"
}

skills_list_path() {
  printf '%s\n' "$ROOT/skills/standalone.txt"
}

skills_usage() {
  cat <<'EOF'
Usage: maestro skills list | install <name>... | install --all
       maestro skills uninstall <name>... | uninstall --all
  list       print every standalone skill and whether it is installed
  install    copy the named standalone skills, plus the standalone skills they
             Load, into <config>/skills/
  uninstall  remove the named managed copies; never touches an unmanaged dir
  --all      install: exactly the skills in skills/standalone.txt;
             uninstall: every managed copy
EOF
}

# Names are folder names: lowercase letters, digits, and hyphens, never leading
# with a hyphen. This is checked before any path is built. The class is spelled
# out because a [a-z] range matches uppercase under a UTF-8 locale on bash 3.2.
skill_name_ok() {
  case "$1" in
    ""|*[!abcdefghijklmnopqrstuvwxyz0123456789-]*|[!abcdefghijklmnopqrstuvwxyz0123456789]*) return 1 ;;
  esac
  return 0
}

skill_is_standalone() {
  local file
  file="$(skills_list_path)"
  [ -f "$file" ] && grep -qxF -- "$1" "$file"
}

# The source folder for a skill name (a directory holding SKILL.md), or nothing.
skill_src() {
  local d
  for d in "$ROOT"/skills/*/"$1"; do
    if [ -d "$d" ] && [ -f "$d/SKILL.md" ]; then
      printf '%s\n' "$d"
      return 0
    fi
  done
  return 1
}

# The `Load` targets a skill folder names, one per line and C-sorted. Same rule
# as scripts/standalone-skills.sh, so install and the standalone scan agree.
skill_loads() {
  grep -rhoE '([Ll]oad|loads)( the)? `[a-z0-9][a-z0-9-]*`' "$1" 2>/dev/null \
    | grep -oE '`[a-z0-9][a-z0-9-]*`' | tr -d '`' | LC_ALL=C sort -u
}

# The named skills plus the standalone skills they Load, transitively, in
# install order: the names in argument order, then each dependency once. Sets
# SKILLS_CLOSURE and SKILLS_LOADED ("<dep> <parent>" lines, first parent wins).
# A Load target that is unknown or not standalone is an error.
skills_closure() {
  local queue="" seen="" name dir dep deps
  SKILLS_CLOSURE=""
  SKILLS_LOADED=""
  for name in "$@"; do
    if printf '%s' "$seen" | grep -qxF -- "$name"; then
      continue
    fi
    SKILLS_CLOSURE="${SKILLS_CLOSURE}${name}"$'\n'
    seen="${seen}${name}"$'\n'
    queue="${queue}${name}"$'\n'
  done
  while [ -n "$queue" ]; do
    name="${queue%%$'\n'*}"
    queue="${queue#*$'\n'}"
    dir="$(skill_src "$name")" || return 1
    deps="$(skill_loads "$dir" || true)"
    for dep in $deps; do
      if printf '%s' "$seen" | grep -qxF -- "$dep"; then
        continue
      fi
      if ! skill_src "$dep" >/dev/null; then
        echo "maestro skills: unknown skill: $dep (loaded by $name)" >&2
        return 1
      fi
      if ! skill_is_standalone "$dep"; then
        echo "maestro skills: $dep uses the BottegaStack stack and is not standalone" >&2
        return 1
      fi
      seen="${seen}${dep}"$'\n'
      SKILLS_CLOSURE="${SKILLS_CLOSURE}${dep}"$'\n'
      SKILLS_LOADED="${SKILLS_LOADED}${dep} ${name}"$'\n'
      queue="${queue}${dep}"$'\n'
    done
  done
}

# A managed copy is a real directory (never a symlink) holding a regular marker.
skill_marked() {
  [ -d "$1" ] && [ ! -L "$1" ] && [ -f "$1/.bottega-managed" ] && [ ! -L "$1/.bottega-managed" ]
}

skill_status() {
  local name="$1" path ver
  path="$(skills_dest)/$name"
  if [ ! -e "$path" ] && [ ! -L "$path" ]; then
    printf 'not installed\n'
  elif skill_marked "$path"; then
    ver="$(sed -n '1s/^bottega[[:space:]]*//p' "$path/.bottega-managed" 2>/dev/null)"
    printf 'installed %s\n' "${ver:-unknown}"
  else
    printf 'unmanaged copy\n'
  fi
}

skills_print() {
  local file name status
  file="$(skills_list_path)"
  [ -f "$file" ] || return 1
  while IFS= read -r name || [ -n "$name" ]; do
    [ -n "$name" ] || continue
    status="$(skill_status "$name")"
    printf '%-28s %s\n' "$name" "$status"
  done < "$file"
}

# The mode of a directory as a chmod symbolic clause, e.g. "u=rwx,g=rx,o=rx".
# `ls -ld` is used instead of stat flags, which differ between macOS and Linux;
# only plain read/write/execute bits are accepted, and an unusual mode makes the
# caller fall back to 755.
skill_dir_mode() {
  local perms
  perms="$(ls -ld "$1" 2>/dev/null | awk '{print $1}')" || return 1
  perms="$(printf '%s' "$perms" | cut -c2-10)"
  case "$perms" in
    [r-][w-][x-][r-][w-][x-][r-][w-][x-]) ;;
    *) return 1 ;;
  esac
  printf 'u=%s,g=%s,o=%s\n' \
    "$(printf '%s' "$perms" | cut -c1-3 | tr -d -)" \
    "$(printf '%s' "$perms" | cut -c4-6 | tr -d -)" \
    "$(printf '%s' "$perms" | cut -c7-9 | tr -d -)"
}

# Copy a skill into the destination through a temp dir beside it: a failed copy
# leaves any existing managed copy in place. Only called for an absent or
# already-marked target; the marker is written before the old copy is removed.
skill_copy() {
  local name="$1" src="$2" dest tmp ver mode
  dest="$(skills_dest)" || return 1
  mkdir -p "$dest" || return 1
  tmp="$(mktemp -d "$dest/.bottega-tmp.XXXXXX")" || return 1
  # mktemp -d creates the temp dir 0700 and it is moved into place, so match the
  # source directory's mode (or 755 when it is unusual) before the move.
  if mode="$(skill_dir_mode "$src")"; then
    chmod "$mode" "$tmp" || { rm -rf "$tmp"; return 1; }
  else
    chmod 755 "$tmp" || { rm -rf "$tmp"; return 1; }
  fi
  if ! cp -R "$src/." "$tmp/"; then
    rm -rf "$tmp"
    return 1
  fi
  ver="$(maestro_version)"
  if ! printf 'bottega %s\n' "$ver" > "$tmp/.bottega-managed"; then
    rm -rf "$tmp"
    return 1
  fi
  if [ -e "$dest/$name" ] || [ -L "$dest/$name" ]; then
    rm -rf "$dest/$name" || { rm -rf "$tmp"; return 1; }
  fi
  mv "$tmp" "$dest/$name" || { rm -rf "$tmp"; return 1; }
}

# The standalone list in file order, one name per line.
skills_all_names() {
  local file name
  file="$(skills_list_path)"
  if [ ! -f "$file" ]; then
    echo "maestro skills: no standalone skill list at $file" >&2
    return 1
  fi
  while IFS= read -r name || [ -n "$name" ]; do
    [ -n "$name" ] || continue
    printf '%s\n' "$name"
  done < "$file"
}

# Validate a newline-separated name list before any write: name syntax, a real
# skill folder, and standalone.
skills_validate() {
  local names="$1" name
  while IFS= read -r name; do
    [ -n "$name" ] || continue
    if ! skill_name_ok "$name"; then
      echo "maestro skills: invalid skill name: $name" >&2
      return 1
    fi
    if ! skill_src "$name" >/dev/null; then
      echo "maestro skills: unknown skill: $name" >&2
      return 1
    fi
    if ! skill_is_standalone "$name"; then
      echo "maestro skills: $name uses the BottegaStack stack and is not standalone" >&2
      return 1
    fi
  done <<< "$names"
}

# Install a newline-separated name list. The second argument holds the
# newline-separated "<dep> <parent>" lines announced first. Every target is
# checked before the first copy: an unmanaged entry aborts all.
skills_install_list() {
  local names="$1" loaded="$2" name src path dest line dep parent
  dest="$(skills_dest)"
  while IFS= read -r name; do
    [ -n "$name" ] || continue
    path="$dest/$name"
    if { [ -e "$path" ] || [ -L "$path" ]; } && ! skill_marked "$path"; then
      echo "maestro skills: $path exists and is not managed by BottegaStack; move it away first" >&2
      return 1
    fi
  done <<< "$names"
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    dep="${line%% *}"
    parent="${line#* }"
    echo "also installing $dep (loaded by $parent)"
  done <<< "$loaded"
  while IFS= read -r name; do
    [ -n "$name" ] || continue
    src="$(skill_src "$name")" || return 1
    path="$dest/$name"
    if skill_marked "$path"; then
      skill_copy "$name" "$src" || { echo "maestro skills: failed to copy $name" >&2; return 1; }
      echo "refreshed $name -> $path"
    else
      skill_copy "$name" "$src" || { echo "maestro skills: failed to copy $name" >&2; return 1; }
      echo "installed $name -> $path"
    fi
  done <<< "$names"
}

skills_install() {
  local name names
  if [ "$#" -eq 0 ]; then
    skills_print || return 1
    echo 'Nothing installed. Run: maestro skills install <name>... | --all'
    return 0
  fi
  if [ "$1" = "--all" ]; then
    if [ "$#" -ne 1 ]; then
      skills_usage >&2
      return 2
    fi
    names="$(skills_all_names)" || return 1
    skills_validate "$names" || return 1
    # --all installs exactly the listed set: no dependency expansion.
    skills_install_list "$names" "" || return 1
    return 0
  fi
  for name in "$@"; do
    case "$name" in
      -*) skills_usage >&2; return 2 ;;
    esac
  done
  # Each argument is one name: validate them before building the list, so an
  # empty or newline-bearing argument is refused rather than split or skipped.
  for name in "$@"; do
    if ! skill_name_ok "$name"; then
      echo "maestro skills: invalid skill name: $name" >&2
      return 1
    fi
  done
  names=""
  for name in "$@"; do
    names="${names}${name}"$'\n'
  done
  skills_validate "$names" || return 1
  skills_closure "$@" || return 1
  skills_install_list "$SKILLS_CLOSURE" "$SKILLS_LOADED" || return 1
}

# Every managed copy in the destination, one name per line, C-sorted.
skills_managed_names() {
  local dest d
  dest="$(skills_dest)"
  [ -d "$dest" ] || return 0
  for d in "$dest"/*; do
    [ -d "$d" ] || continue
    if skill_marked "$d"; then basename "$d"; fi
  done | LC_ALL=C sort
}

# Remove a newline-separated name list. Every target is checked before the
# first removal, so one unmanaged entry aborts all. An absent name is reported
# and skipped; a managed copy is removed and reported.
skills_uninstall_list() {
  local names="$1" name path
  while IFS= read -r name; do
    [ -n "$name" ] || continue
    path="$(skills_dest)/$name"
    if { [ -e "$path" ] || [ -L "$path" ]; } && ! skill_marked "$path"; then
      echo "maestro skills: $path is not managed by BottegaStack; refusing to remove" >&2
      return 1
    fi
  done <<< "$names"
  while IFS= read -r name; do
    [ -n "$name" ] || continue
    path="$(skills_dest)/$name"
    if [ -e "$path" ] || [ -L "$path" ]; then
      rm -rf "$path" || return 1
      echo "removed $name"
    else
      echo "$name is not installed"
    fi
  done <<< "$names"
}

skills_uninstall() {
  local name names
  if [ "$#" -eq 0 ]; then
    skills_usage >&2
    return 2
  fi
  if [ "$1" = "--all" ]; then
    if [ "$#" -ne 1 ]; then
      skills_usage >&2
      return 2
    fi
    names="$(skills_managed_names)" || return 1
    skills_uninstall_list "$names" || return 1
    return 0
  fi
  for name in "$@"; do
    case "$name" in
      -*) skills_usage >&2; return 2 ;;
    esac
  done
  # Mirror install: each argument is one validated name, refused before any
  # removal so a bad name beside a valid one leaves every copy in place.
  for name in "$@"; do
    if ! skill_name_ok "$name"; then
      echo "maestro skills: invalid skill name: $name" >&2
      return 1
    fi
  done
  names=""
  for name in "$@"; do
    names="${names}${name}"$'\n'
  done
  skills_validate "$names" || return 1
  skills_uninstall_list "$names" || return 1
}

cmd_skills() {
  local sub="${1:-}"
  shift || true
  # Every subcommand needs the config dir. Resolve it before dispatch: with no
  # CLAUDE_CONFIG_DIR and no HOME there is nowhere to write, and failing here
  # keeps a path like /skills from ever reaching a mkdir.
  skills_dest >/dev/null || return 1
  case "$sub" in
    list)
      if [ "$#" -gt 0 ]; then
        skills_usage >&2
        return 2
      fi
      skills_print
      ;;
    install) skills_install "$@" ;;
    uninstall) skills_uninstall "$@" ;;
    *)
      skills_usage >&2
      return 2
      ;;
  esac
}

# ---- State directory --------------------------------------------------------
# A run's state lives outside the repo. One directory per git common dir, so
# every worktree of a repo shares it:
#   <base>/<repo basename>-<first 8 hex of sha1(realpath(git-common-dir))>
# where <base> is BOTTEGA_STATE_DIR or ${TMPDIR:-/tmp}/maestro-<uid>.
state_dir() {
  local root common real name id base
  root="$(git rev-parse --show-toplevel 2>/dev/null)" || return 1
  common="$(git -C "$root" rev-parse --git-common-dir 2>/dev/null)" || return 1
  case "$common" in
    /*) ;;
    *) common="$root/$common" ;;
  esac
  real="$(cd "$common" 2>/dev/null && pwd -P)" || return 1
  name="$(basename "$(dirname "$real")")"
  if command -v sha1sum >/dev/null 2>&1; then
    id="$(printf '%s' "$real" | sha1sum | cut -c1-8)"
  elif command -v shasum >/dev/null 2>&1; then
    id="$(printf '%s' "$real" | shasum -a 1 | cut -c1-8)"
  else
    id="$(printf '%s' "$real" | git hash-object --stdin | cut -c1-8)"
  fi
  base="${BOTTEGA_STATE_DIR:-${TMPDIR:-/tmp}/bottega-$(id -u)}"
  base="${base%/}"
  printf '%s/%s-%s\n' "$base" "$name" "$id"
}

# Same as state_dir, but creates it mode 700 (umask 077 covers new directories).
ensure_state_dir() {
  local dir
  dir="$(state_dir)" || return 1
  (umask 077; mkdir -p "$dir")
  printf '%s\n' "$dir"
}

# Run ids are folder names: lowercase letters, digits, and hyphens, never empty
# and never leading with a hyphen. The class is spelled out because a [a-z] range
# matches uppercase under a UTF-8 locale on bash 3.2.
run_id_ok() {
  case "$1" in
    ''|-*|*[!abcdefghijklmnopqrstuvwxyz0123456789-]*) return 1 ;;
  esac
  return 0
}

# Refuse a bad run id before a command builds a path from it. Prints on stderr
# and exits 2, so every run-taking command reports the same way.
require_run_id() {
  local label="$1" id="$2"
  run_id_ok "$id" && return 0
  printf 'maestro %s: bad run id: %s\n' "$label" "$id" >&2
  exit 2
}

# The run's branch: the name saved by `start`, else bottega/<slug>.
run_branch() {
  local slug="$1" dir b=""
  dir="$(state_dir 2>/dev/null)" && [ -f "$dir/$slug/branch" ] && b="$(cat "$dir/$slug/branch")"
  printf '%s\n' "${b:-bottega/$slug}"
}

# $STATE/<slug>, creating the state directory (used by `start`).
run_dir() {
  printf '%s/%s\n' "$(ensure_state_dir)" "$1"
}

# $STATE/<slug> without creating anything (commands that read an existing run).
# Returns 3 for a bad run id so a caller can tell it from "not a git repository".
run_state_dir() {
  local base
  run_id_ok "$1" || return 3
  base="$(state_dir)" || return 1
  printf '%s/%s\n' "$base" "$1"
}

# $STATE/quick/<slug> — the light path. Creates the directory.
light_dir() {
  local dir
  dir="$(ensure_state_dir)" || return 1
  (umask 077; mkdir -p "$dir/quick/$1")
  printf '%s/quick/%s\n' "$dir" "$1"
}

# Resolve a slug to its state directory wherever a run or a light-path slug is
# accepted: $STATE/<slug> for a run, else $STATE/quick/<slug> for the light
# path. Prints the directory; returns 1 when neither exists, 2 outside a git
# repository, and 3 for a bad run id.
resolve_run_dir() {
  local base dir
  run_id_ok "$1" || return 3
  base="$(state_dir)" || return 2
  dir="$base/$1"
  if [ -d "$dir" ]; then printf '%s\n' "$dir"; return 0; fi
  dir="$base/quick/$1"
  if [ -d "$dir" ]; then printf '%s\n' "$dir"; return 0; fi
  return 1
}

# The reason recorded in a run's hold file ($STATE/<run>/hold or
# $STATE/quick/<slug>/hold), or nothing when the run is not on hold.
run_hold_reason() {
  [ -f "$1/hold" ] || return 0
  cut -f2- "$1/hold" 2>/dev/null | head -1
}

# `maestro start "<title>" [--branch <name>]`: create the state directory and the
# run id (the slug). The run works on the branch you are on; only `--branch`
# creates one. Auto-inits the project on first use and requires no changes to
# tracked files; untracked files are ignored because a run builds from HEAD.
cmd_start() {
  local title="" newbranch=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --branch) newbranch="${2:?--branch needs a name}"; shift 2 ;;
      -*) echo "maestro start: unknown flag: $1" >&2; exit 2 ;;
      *) title="$1"; shift ;;
    esac
  done
  [ -n "$title" ] || { echo 'usage: maestro start "<title>" [--branch <name>]' >&2; exit 2; }
  git rev-parse --show-toplevel >/dev/null 2>&1 || { echo "maestro start: not a git repository" >&2; exit 1; }
  local repo
  repo="$(git rev-parse --show-toplevel)"
  cd "$repo"
  # Validate every rule before writing anything: a refused start must leave the
  # repo byte-for-byte unchanged, so no auto-init happens until all of them pass.
  if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
    echo "working tree is dirty; commit or stash first" >&2
    exit 1
  fi

  local slug base n=1
  slug="$(printf '%s' "$title" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-//; s/-$//' | cut -c1-40 | sed 's/-*$//')"
  [ -n "$slug" ] || slug="run"
  base="$(git branch --show-current 2>/dev/null || true)"
  [ -n "$base" ] || base="HEAD"
  local branch="$newbranch"
  if [ -n "$newbranch" ]; then
    if git show-ref --verify --quiet "refs/heads/$newbranch"; then
      echo "maestro start: branch already exists: $newbranch" >&2
      exit 1
    fi
    git switch -c "$newbranch" >/dev/null 2>&1 || git checkout -b "$newbranch" >/dev/null 2>&1 || {
      echo "maestro start: could not create branch $newbranch (base: $base)" >&2
      exit 1
    }
  else
    branch="$base"
    case "$branch" in
      ''|HEAD|main|master)
        echo "maestro start: you are on '${branch:-detached HEAD}'. Switch to your working branch, or pass --branch <name> to create one." >&2
        exit 1 ;;
    esac
  fi
  # /maestro is the only command you need: set the project up on first use, now
  # that every rule has passed. init only creates what is missing.
  if [ ! -f AGENTS.md ] || [ ! -x scripts/check ] || [ ! -f .claude/settings.json ]; then
    cmd_init "$repo" | tail -1
  fi
  local dir
  while [ -d "$(state_dir)/$slug" ]; do
    n=$((n + 1))
    slug="${slug%-$((n - 1))}-$n"
  done
  dir="$(run_dir "$slug")" || { echo "maestro start: could not create the state directory" >&2; exit 1; }
  (umask 077; mkdir -p "$dir/build" "$dir/tasks"; printf '%s\n' "$branch" > "$dir/branch")
  echo "run: $slug"
  echo "branch: $branch"
  echo "state: $dir"
}

# `maestro hold <run> "<reason>"`: record an escalation in the run's state
# directory (a `hold` file with the reason and a timestamp), so the Stop hook
# can let the session end instead of forcing the master to complete its todos.
# `maestro hold --clear <run>` removes it when the run resumes.
cmd_hold() {
  local clear=0 slug="" reason="" rc dir npos=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --clear) clear=1; shift ;;
      --*) echo 'usage: maestro hold <run> "<reason>" | --clear <run>' >&2; exit 2 ;;
      -*) require_run_id "hold" "$1" ;;
      *)
        case "$npos" in
          0) slug="$1" ;;
          1) reason="$1" ;;
          *) echo 'usage: maestro hold <run> "<reason>" | --clear <run>' >&2; exit 2 ;;
        esac
        npos=$((npos + 1)); shift ;;
    esac
  done
  require_run_id "hold" "$slug"
  if [ "$clear" = "1" ]; then
    [ -z "$reason" ] || { echo 'usage: maestro hold --clear <run>' >&2; exit 2; }
  else
    [ -n "$reason" ] || { echo 'usage: maestro hold <run> "<reason>"' >&2; exit 2; }
  fi
  dir="$(resolve_run_dir "$slug")" || {
    rc=$?
    if [ "$rc" -eq 2 ]; then echo "maestro hold: not in a git repository" >&2; else echo "maestro hold: no such run: $slug" >&2; fi
    exit 1
  }
  if [ "$clear" = "1" ]; then
    rm -f "$dir/hold"
    echo "hold cleared: $slug"
    return 0
  fi
  reason="$(printf '%s' "$reason" | tr '\t\n\r' '   ')"
  printf '%s\t%s\n' "$(date -Iseconds)" "$reason" > "$dir/hold"
  echo "run $slug is on hold: $reason"
}

# `maestro resume <run>`: clear a paused marker and any hold so `guard stop`
# tracks the run again. Works for a run or a light-path slug. A merged, pr, or
# rejected close still removes the whole state directory.
cmd_resume() {
  local slug="${1:-}" rc dir
  [ "$#" -eq 1 ] || { echo "usage: maestro resume <run>" >&2; exit 2; }
  require_run_id "resume" "$slug"
  dir="$(resolve_run_dir "$slug")" || {
    rc=$?
    if [ "$rc" -eq 2 ]; then echo "maestro resume: not in a git repository" >&2; else echo "maestro resume: no such run: $slug" >&2; fi
    exit 1
  }
  if [ -f "$dir/paused" ]; then
    rm -f "$dir/paused" "$dir/hold"
    echo "resumed: $slug"
  else
    rm -f "$dir/hold"
    echo "resumed: $slug (not paused)"
  fi
}

# `maestro spec <run> [file]`: save the spec and extract each `### Task <n>`
# section into tasks/<n>.md. Prints the task count.
cmd_spec() {
  local slug="${1:-}" file="${2:-}"
  require_run_id "spec" "$slug"
  local dir
  dir="$(run_state_dir "$slug")" || { echo "maestro spec: not in a git repository" >&2; exit 1; }
  [ -d "$dir" ] || { echo "maestro spec: no such run: $slug (run: maestro start \"<title>\")" >&2; exit 1; }
  local spec="$dir/spec.md"
  if [ -n "$file" ]; then
    [ -f "$file" ] || { echo "maestro spec: no such file: $file" >&2; exit 1; }
    cat "$file" > "$spec"
  else
    cat > "$spec"
  fi
  local tasks="$dir/tasks"
  mkdir -p "$tasks"
  rm -f "$tasks"/*.md 2>/dev/null || true
  awk -v dir="$tasks" '
    /^###[ \t]+Task[ \t]+[0-9]+/ {
      if (out != "") close(out)
      line = $0
      sub(/^###[ \t]+Task[ \t]+/, "", line)
      sub(/[^0-9].*$/, "", line)
      out = dir "/" line ".md"
      print > out
      next
    }
    /^##[ \t]/ { if (out != "") { close(out); out = "" } next }
    out != "" { print > out }
  ' "$spec"
  local count
  count="$(find "$tasks" -maxdepth 1 -name '[0-9]*.md' 2>/dev/null | wc -l | tr -d ' ')"
  echo "$count"
}

# `maestro check <run>`: run scripts/check from the current worktree and record
# the result under the state directory, keyed by HEAD so parallel worktrees keep
# their own record. `checks.result` mirrors the latest record.
cmd_check() {
  local slug="${1:-}"
  require_run_id "check" "$slug"
  local dir repo rc
  dir="$(resolve_run_dir "$slug")" || {
    rc=$?
    if [ "$rc" -eq 2 ]; then echo "maestro check: not in a git repository" >&2; else echo "maestro check: no such run: $slug" >&2; fi
    exit 1
  }
  repo="$(git rev-parse --show-toplevel)"
  cd "$repo"
  [ -x scripts/check ] || { echo "scripts/check not found or not executable" >&2; exit 1; }
  local start end duration sha result code output
  start="$(date +%s)"
  set +e
  output="$(./scripts/check 2>&1)"
  code=$?
  set -e
  end="$(date +%s)"
  duration=$((end - start))
  sha="$(git rev-parse HEAD 2>/dev/null || echo unknown)"
  if [ "$code" -eq 0 ]; then result="PASS"; else result="FAIL"; fi
  mkdir -p "$dir"
  (umask 077; mkdir -p "$dir/checks")
  local record tmp
  record="$(printf 'RESULT: %s\nHEAD: %s\nEXIT: %s\nSECONDS: %s' "$result" "$sha" "$code" "$duration")"
  tmp="$dir/checks/.$sha.result.$$"
  printf '%s\n' "$record" > "$tmp"
  mv "$tmp" "$dir/checks/$sha.result"
  tmp="$dir/checks.result.$$"
  printf '%s\n' "$record" > "$tmp"
  mv "$tmp" "$dir/checks.result"
  {
    printf '%s HEAD %s RESULT %s EXIT %s SECONDS %s\n' "$(date -Iseconds)" "$sha" "$result" "$code" "$duration"
    echo '```'
    echo "$output"
    echo '```'
  } > "$dir/checks/$sha.log"
  printf '%s HEAD %s RESULT %s EXIT %s SECONDS %s\n' "$(date -Iseconds)" "$sha" "$result" "$code" "$duration" >> "$dir/checks.log"
  echo "check: $result (${duration}s, exit $code)"
  [ "$code" -eq 0 ]
}

# A repo test file: a test/spec directory, or a conventional test filename.
is_test_path() {
  local p="$1" b
  case "$p" in
    test/*|tests/*|spec/*|specs/*|__tests__/*) return 0 ;;
    */test/*|*/tests/*|*/spec/*|*/specs/*|*/__tests__/*) return 0 ;;
  esac
  b="$(basename "$p")"
  case "$b" in
    test|tests|test.*|tests.*|test_*|*_test|*_test.*|*.test.*|*.spec.*|*_spec.*|*Spec.*|*Test.*|*Tests.*) return 0 ;;
  esac
  return 1
}

# The commit the current branch forked from: the run branch for a task
# worktree, else main, master, or the root commit.
branch_base() {
  local slug="${1:-}" cur b base="" rb=""
  cur="$(git branch --show-current 2>/dev/null || true)"
  [ -n "$slug" ] && rb="$(run_branch "$slug")"
  if [ -n "$rb" ] && [ "$cur" != "$rb" ] && git show-ref --verify --quiet "refs/heads/$rb"; then
    base="$(git merge-base HEAD "refs/heads/$rb" 2>/dev/null || true)"
    [ -n "$base" ] && { printf '%s\n' "$base"; return 0; }
  fi
  for b in main master; do
    if git show-ref --verify --quiet "refs/heads/$b"; then
      base="$(git merge-base HEAD "refs/heads/$b" 2>/dev/null || true)"
      [ -n "$base" ] && { printf '%s\n' "$base"; return 0; }
    fi
  done
  git rev-list --max-parents=0 HEAD 2>/dev/null | head -1
}

# Warning, never a failure: a branch that changes tests and non-tests must have a
# test-only commit before the first non-test commit (red before green).
gate_commit_order_warning() {
  local slug="${1:-}" base c p touch_test touch_non test_first=0 saw_non=0 saw_test=0 warn=0
  base="$(branch_base "$slug")"
  [ -n "$base" ] || return 0
  while IFS= read -r c; do
    [ -n "$c" ] || continue
    touch_test=0; touch_non=0
    while IFS= read -r p; do
      [ -n "$p" ] || continue
      if is_test_path "$p"; then touch_test=1; else touch_non=1; fi
    done < <(git show --format= --name-only "$c" 2>/dev/null)
    [ "$touch_test" = "1" ] && saw_test=1
    if [ "$touch_non" = "1" ]; then
      if [ "$saw_non" = "0" ]; then
        [ "$test_first" = "1" ] || warn=1
        saw_non=1
      fi
    elif [ "$touch_test" = "1" ] && [ "$saw_non" = "0" ]; then
      test_first=1
    fi
  done < <(git rev-list --reverse "$base..HEAD" 2>/dev/null)
  if [ "$warn" = "1" ] && [ "$saw_test" = "1" ] && [ "$saw_non" = "1" ]; then
    echo "warning: no failing-test commit before the fix"
  fi
}

cmd_gate() {
  local slug="" allow_dirty=0 proof=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --allow-dirty) allow_dirty=1; shift ;;
      --proof) proof=1; shift ;;
      --*) echo "unknown flag: $1" >&2; exit 1 ;;
      *) slug="$1"; shift ;;
    esac
  done
  require_run_id "gate" "$slug"

  if [ "$allow_dirty" = "0" ] && git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    if [ -n "$(git status --porcelain)" ]; then
      echo "GATE: FAIL (working tree dirty)"
      return 1
    fi
  fi

  local dir file rc
  dir="$(resolve_run_dir "$slug")" || {
    rc=$?
    if [ "$rc" -eq 2 ]; then echo "maestro gate: not in a git repository" >&2; else echo "maestro gate: no such run: $slug" >&2; fi
    return 1
  }
  local result sha head
  head="$(git rev-parse HEAD 2>/dev/null || echo unknown)"
  file="$dir/checks/$head.result"
  if [ ! -f "$file" ]; then
    if [ -f "$dir/checks.result" ]; then
      sha="$(grep -m1 '^HEAD:' "$dir/checks.result" | sed 's/^HEAD:[[:space:]]*//')"
      echo "GATE: FAIL (checks stale: ${sha:-unknown} != $head)"
    else
      echo "GATE: FAIL (no checks.result)"
    fi
    return 1
  fi
  result="$(grep -m1 '^RESULT:' "$file" | sed 's/^RESULT:[[:space:]]*//')"
  sha="$(grep -m1 '^HEAD:' "$file" | sed 's/^HEAD:[[:space:]]*//')"
  if [ "$result" != "PASS" ]; then
    echo "GATE: FAIL (checks result: ${result:-missing})"
    return 1
  fi
  if [ "$sha" != "$head" ]; then
    echo "GATE: FAIL (checks stale: $sha != $head)"
    return 1
  fi
  if [ "$proof" = "1" ]; then
    local pmsg
    pmsg="$(verify_unmet "$slug" "$head")" || { echo "GATE: FAIL (proof: $pmsg)"; return 1; }
  fi
  gate_commit_order_warning "$slug"
  echo "GATE: PASS"
}

# ---- Proof of acceptance criteria ------------------------------------------
# The SPEC marks each criterion `AC<n>: ... Proof: <command> -> <expected>`;
# `Proof: none` opts a criterion out. Rows live in $STATE/<run>/verify/index.tsv:
# time, AC, result, HEAD, by, evidence, note. The latest row per AC wins.

# Criteria ids that need proof, one per line.
verify_required_acs() {
  local spec="$1"
  [ -f "$spec" ] || return 0
  grep -E '^[-*0-9. ]*AC[0-9]+[:.)]' "$spec" \
    | grep -E 'Proof:' | grep -viE 'Proof:[[:space:]]*`?none' \
    | sed -E 's/^[-*0-9. ]*(AC[0-9]+).*/\1/' | sort -u
}

# Print nothing and return 0 when every required criterion has a PASS row for
# $2 (or a WAIVED row); otherwise print the first problem and return 1.
verify_unmet() {
  local slug="$1" head="$2" dir idx ac row result rhead
  dir="$(resolve_run_dir "$slug")" || dir="$(run_state_dir "$slug")" || { echo "not a git repository"; return 1; }
  idx="$dir/verify/index.tsv"
  [ -f "$idx" ] || idx=/dev/null
  while IFS= read -r ac; do
    [ -n "$ac" ] || continue
    row="$(awk -F'\t' -v a="$ac" '$2 == a { last = $0 } END { print last }' "$idx" 2>/dev/null)"
    if [ -z "$row" ]; then echo "$ac has no recorded proof"; return 1; fi
    result="$(printf '%s' "$row" | cut -f3)"
    rhead="$(printf '%s' "$row" | cut -f4)"
    case "$result" in
      WAIVED) ;;
      PASS) [ "$rhead" = "$head" ] || { echo "$ac proof is stale (${rhead:0:9} != ${head:0:9})"; return 1; } ;;
      *) echo "$ac is $result"; return 1 ;;
    esac
  done < <(verify_required_acs "$dir/spec.md")
  return 0
}

# Print the first missing close-out evidence for one open run directory; print
# nothing when the run is ready. A run needs a passing checks.result (head
# freshness is `maestro gate`'s job). A full run with Proof criteria also needs
# the latest row per criterion to be PASS or WAIVED, and at least one
# reviewer/second-opinion row. Reuses verify_required_acs, so `Proof: none` and
# runs without a SPEC are exempt.
run_evidence_gap() {
  local dir="$1" slug result idx ac row acs
  slug="$(basename "$dir")"
  result="$(sed -n 's/^RESULT:[[:space:]]*//p' "$dir/checks.result" 2>/dev/null | head -1)"
  if [ "$result" != "PASS" ]; then
    printf '%s has no passing checks.result; record it with: maestro check %s\n' "$slug" "$slug"
    return 0
  fi
  acs="$(verify_required_acs "$dir/spec.md")"
  [ -n "$acs" ] || return 0
  idx="$dir/verify/index.tsv"
  [ -f "$idx" ] || idx=/dev/null
  while IFS= read -r ac; do
    [ -n "$ac" ] || continue
    row="$(awk -F'\t' -v a="$ac" '$2 == a { last = $0 } END { print last }' "$idx" 2>/dev/null)"
    if [ -z "$row" ]; then
      printf '%s has no proof for %s; record it with: maestro verify record %s %s PASS --by reviewer --evidence <file>\n' "$slug" "$ac" "$slug" "$ac"
      return 0
    fi
    result="$(printf '%s' "$row" | cut -f3)"
    case "$result" in
      PASS|WAIVED) ;;
      *)
        printf '%s has %s for %s; record it with: maestro verify record %s %s PASS --by reviewer --evidence <file>\n' "$slug" "$result" "$ac" "$slug" "$ac"
        return 0
        ;;
    esac
  done <<< "$acs"
  if ! awk -F'\t' '$5 == "reviewer" || $5 == "second-opinion" { found = 1 } END { exit !found }' "$idx" 2>/dev/null; then
    printf '%s has no reviewer or second-opinion verification; record one with: maestro verify record %s <AC> PASS --by reviewer --evidence <file>\n' "$slug" "$slug"
  fi
  return 0
}

# `maestro log <run> <phase> <decision> <why> <evidence> <result>`: append one row
# to the run's decision log ($STATE/decisions/<run>.tsv, kept after the run is
# closed). With only <run> it prints the log as a table. Cells are one line; a
# cell that starts with = + - @ gets a leading quote so a spreadsheet will not
# run it as a formula.
cmd_log() {
  local slug="${1:-}" base file
  require_run_id "log" "$slug"
  base="$(ensure_state_dir)" || { echo "maestro log: not in a git repository" >&2; exit 1; }
  file="$base/decisions/$slug.tsv"
  if [ "$#" -eq 1 ]; then
    [ -s "$file" ] || { echo "no decisions logged for $slug"; return 0; }
    column -t -s "$(printf '\t')" "$file"
    return 0
  fi
  [ "$#" -eq 6 ] || { echo 'usage: maestro log <run> <phase> <decision> <why> <evidence> <result>' >&2; exit 2; }
  (umask 077; mkdir -p "$base/decisions")
  [ -s "$file" ] || printf 'ts\tphase\tdecision\twhy\tevidence\tresult\n' >> "$file"
  local -a cells=() c
  shift
  for c in "$@"; do
    c="$(printf '%s' "$c" | tr '\t\n\r' '   ')"
    case "$c" in =*|+*|-*|@*) c="'$c" ;; esac
    cells+=("$c")
  done
  printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$(date -u +%FT%TZ)" "${cells[@]}" >> "$file"
  echo "logged: $slug ${cells[0]}"
}

cmd_verify() {
  local action="${1:-}"
  shift || true
  local slug="${1:-}" dir idx head rc
  require_run_id "verify" "$slug"
  shift || true
  dir="$(resolve_run_dir "$slug")" || {
    rc=$?
    if [ "$rc" -eq 2 ]; then echo "maestro verify: not a git repository" >&2; else echo "maestro verify: no such run: $slug" >&2; fi
    exit 1
  }
  idx="$dir/verify/index.tsv"
  head="$(git rev-parse HEAD 2>/dev/null || echo unknown)"
  case "$action" in
    record)
      local ac="${1:-}" result="${2:-}" by="" evidence="" note=""
      shift 2 2>/dev/null || true
      while [ "$#" -gt 0 ]; do
        case "$1" in
          --by) by="${2:?--by needs a role}"; shift 2 ;;
          --evidence) evidence="${2:?--evidence needs a file}"; shift 2 ;;
          --note) note="${2:?--note needs text}"; shift 2 ;;
          *) echo "maestro verify record: unknown argument: $1" >&2; exit 2 ;;
        esac
      done
      case "$ac" in AC[0-9]*) ;; *) echo "maestro verify record: criterion must look like AC1" >&2; exit 2 ;; esac
      case "$result" in PASS|FAIL|INCONCLUSIVE) ;; *) echo "maestro verify record: result must be PASS, FAIL, or INCONCLUSIVE" >&2; exit 2 ;; esac
      case "$by" in
        reviewer|second-opinion|master) ;;
        builder) echo "maestro verify record: a builder cannot verify its own work" >&2; exit 2 ;;
        *) echo "maestro verify record: --by must be reviewer, second-opinion, or master" >&2; exit 2 ;;
      esac
      if [ "$result" = "PASS" ] && { [ -z "$evidence" ] || [ ! -f "$evidence" ]; }; then
        echo "maestro verify record: PASS needs --evidence <existing file> (command, output, exit code)" >&2
        exit 2
      fi
      (umask 077; mkdir -p "$dir/verify")
      local kept="-"
      if [ -n "$evidence" ] && [ -f "$evidence" ]; then
        kept="verify/${ac}-$(date +%s)-$(basename "$evidence")"
        cp "$evidence" "$dir/$kept"
      fi
      note="$(printf '%s' "$note" | tr '\t\n' '  ')"
      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$(date +%FT%T)" "$ac" "$result" "$head" "$by" "$kept" "${note:--}" >> "$idx"
      echo "recorded: $ac $result at ${head:0:9}"
      ;;
    waive)
      local ac="${1:-}" reason="${2:-}"
      [ -n "$reason" ] || { echo 'usage: maestro verify waive <run> <AC> "<reason>"' >&2; exit 2; }
      (umask 077; mkdir -p "$dir/verify")
      reason="$(printf '%s' "$reason" | tr '\t\n' '  ')"
      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$(date +%FT%T)" "$ac" "WAIVED" "$head" "user" "-" "$reason" >> "$idx"
      echo "waived: $ac (record the user's approval in the PR body)"
      ;;
    list)
      local ac
      [ -f "$idx" ] || idx=/dev/null
      [ -f "$dir/spec.md" ] || echo "no spec saved yet"
      while IFS= read -r ac; do
        [ -n "$ac" ] || continue
        printf '%s: ' "$ac"
        awk -F'\t' -v a="$ac" -v h="$head" '$2 == a { r = $3 " at " substr($4,1,9) ($4 == h ? "" : " (stale)") " by " $5 } END { print (r == "" ? "no proof" : r) }' "$idx" 2>/dev/null
      done < <(verify_required_acs "$dir/spec.md")
      ;;
    *) echo "usage: maestro verify record|waive|list <run> ..." >&2; exit 2 ;;
  esac
}

# Resolve a file path without `readlink -f` (absent on BSD/macOS): follow
# symlinks with a portable loop, then normalise the directory. Prints the path.
maestro_real_file() {
  local p="$1" dir target n=0
  while [ -L "$p" ] && [ "$n" -lt 40 ]; do
    dir="$(cd "$(dirname "$p")" 2>/dev/null && pwd -P)" || break
    target="$(readlink "$p")" || break
    case "$target" in
      /*) p="$target" ;;
      *) p="$dir/$target" ;;
    esac
    n=$((n + 1))
  done
  dir="$(cd "$(dirname "$p")" 2>/dev/null && pwd -P)" || { printf '%s\n' "$p"; return 0; }
  printf '%s/%s\n' "$dir" "$(basename "$p")"
}

# Warn when more than one `maestro` is on PATH: after a plugin update an older
# copy can still come first and win. Scans PATH in order, skipping empty entries
# and duplicates (same resolved file); names each distinct copy with the version
# from the file's plugin manifest (<dir>/../.claude-plugin/plugin.json), or
# `unknown`. The displayed path stays the PATH entry.
maestro_path_warning() {
  local entry real dir seen=" " ver list="" n=0
  local IFS=:
  for entry in $PATH; do
    [ -n "$entry" ] || continue
    [ -f "$entry/maestro" ] && [ -x "$entry/maestro" ] || continue
    real="$(maestro_real_file "$entry/maestro")"
    case "$seen" in *" $real "*) continue ;; esac
    seen="$seen$real "
    dir="$(dirname "$real")"
    ver="unknown"
    if [ -f "$dir/../.claude-plugin/plugin.json" ]; then
      ver="$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$dir/../.claude-plugin/plugin.json" | head -1)"
      [ -n "$ver" ] || ver="unknown"
    fi
    if [ "$n" -eq 0 ]; then
      list="$entry ($ver) [wins]"
    else
      list="$list, $entry ($ver)"
    fi
    n=$((n + 1))
  done
  [ "$n" -gt 1 ] || return 0
  printf 'warning: %s maestro copies on PATH; the first one wins: %s\n' "$n" "$list"
}

cmd_doctor() {
  echo "BottegaStack doctor"
  echo "root: $ROOT"
  echo "version: $(maestro_version)"
  maestro_path_warning
  local sdir
  if sdir="$(state_dir 2>/dev/null)"; then
    local runs=0
    [ -d "$sdir" ] && runs="$(find "$sdir" -mindepth 1 -maxdepth 1 -type d ! -name quick 2>/dev/null | wc -l | tr -d ' ')"
    echo "state: $sdir"
    echo "runs: $runs"
  fi
  if builder_ready quiet; then
    echo "headless builder: ready ($(builder_env_file))"
  else
    echo "headless builder: not configured (maestro build --init; Claude builder is the fallback)"
  fi
  command -v claude >/dev/null 2>&1 && echo "claude: yes" || echo "claude: no"
  command -v gh >/dev/null 2>&1 && echo "gh: yes" || echo "gh: no"
  command -v agent-browser >/dev/null 2>&1 && echo "agent-browser: yes" || echo "agent-browser: no (install: npm install -g agent-browser)"
  command -v node >/dev/null 2>&1 && echo "node: yes ($(node --version))" || echo "node: no"
  if command -v gitleaks >/dev/null 2>&1; then
    echo "gitleaks: yes"
  else
    echo "gitleaks: no"
    echo "warning: gitleaks is not installed; secret scanning is unavailable (maestro tools install)"
  fi
  command -v rtk >/dev/null 2>&1 && echo "rtk: yes (optional)" || echo "rtk: no (optional; see Token savings in docs/SETUP.md)"

  local skills
  skills="$(find "$ROOT/skills" -mindepth 3 -maxdepth 3 -name SKILL.md | wc -l | tr -d ' ')"
  echo "skills: $skills"


  if [ -f AGENTS.md ]; then
    local lines
    lines="$(wc -l < AGENTS.md | tr -d ' ')"
    echo "AGENTS.md lines: $lines"
    [ "$lines" -gt 200 ] && echo "warning: AGENTS.md is over 200 lines; move detail into skills"
  else
    echo "AGENTS.md: missing (run maestro init)"
  fi

  if [ -d .git ] && git ls-files --error-unmatch .env >/dev/null 2>&1; then
    echo "warning: .env is tracked by git"
  fi

  if has_dependency_manifest; then
    local dep_config=0 dep_file
    if [ -f .github/dependabot.yml ] || [ -f .github/dependabot.yaml ] || [ -f renovate.json ]; then
      dep_config=1
    fi
    for dep_file in .renovaterc*; do
      if [ -e "$dep_file" ]; then dep_config=1; fi
    done
    if [ "$dep_config" = 0 ]; then
      echo "warning: no dependency-update config (.github/dependabot.yml, renovate.json, or .renovaterc)"
    fi
  fi

  if [ -d .github/workflows ]; then
    local ci_security=0 workflow
    for workflow in .github/workflows/*; do
      [ -f "$workflow" ] || continue
      if grep -qiE 'codeql|dependency-review|gitleaks|trivy|osv-scanner' "$workflow"; then
        ci_security=1
        break
      fi
    done
    if [ "$ci_security" = 0 ]; then
      echo "warning: no CI security job (.github/workflows has no codeql, dependency-review, gitleaks, trivy, or osv-scanner)"
    fi
  fi

  if [ -f .claude/settings.json ]; then
    echo "project claude settings: yes"
  else
    echo "project claude settings: missing (run maestro init)"
  fi

  local gitdir hook
  gitdir="$(git -C . rev-parse --git-dir 2>/dev/null || true)"
  if [ -n "$gitdir" ]; then
    case "$gitdir" in
      /*) ;;
      *) gitdir="./$gitdir" ;;
    esac
    for hook in pre-commit pre-push; do
      if [ -f "$gitdir/hooks/$hook" ] && grep -q 'bottega-managed' "$gitdir/hooks/$hook"; then
        echo "$hook hook: yes (bottega-managed)"
      else
        echo "$hook hook: no"
      fi
    done
  else
    echo "git hooks: not a git repository"
  fi

  for t in claude; do
    local config
    config="$(config_dir "$t")"
    echo "$t config: $config"
    [ -d "$config" ] && echo "  exists" || echo "  missing"
  done

  if [ -f "$ROOT/scripts/lint.sh" ]; then
    "$ROOT/scripts/lint.sh"
  else
    echo "lint: skipped (scripts/lint.sh not found)"
  fi
}

# Every path maestro creates in a project. None of them is ever committed: they are
# listed in .git/info/exclude (local, never committed, shared by worktrees) and
# the pre-commit hook rejects staging a new one.
maestro_files() {
  cat <<'LIST'
AGENTS.md
CLAUDE.md
SPEC.md
PLAN.md
BACKLOG.md
GLOSSARY.md
REVIEW.md
mistakes.md
scripts/check
scripts/verify
scripts/verify.conf
.claude
docs/FEATURE-MAP.md
LIST
}

# Write the managed block to the repo's local exclude file. Idempotent. Does not
# touch .gitignore, so the project's tracked files are never modified.
exclude_maestro_files() {
  local dest="$1" common file tmp
  common="$(git -C "$dest" rev-parse --git-common-dir 2>/dev/null)" || {
    echo "note: $dest is not a git repository; nothing excluded"
    return 0
  }
  case "$common" in /*) ;; *) common="$dest/$common" ;; esac
  file="$common/info/exclude"
  mkdir -p "$common/info"
  [ -f "$file" ] || : > "$file"
  tmp="$(mktemp)"
  awk '/^# >>> bottega/{skip=1} !skip{print} /^# <<< bottega/{skip=0}' "$file" > "$tmp"
  {
    echo "# >>> bottega (local only; never committed)"
    maestro_files | sed 's|^|/|'
    echo "# <<< bottega"
  } >> "$tmp"
  if cmp -s "$tmp" "$file"; then rm -f "$tmp"; else mv "$tmp" "$file"; echo "excluded: maestro files ($file)"; fi
}

# Untracked files do not exist in a fresh worktree, so copy the ones the builder
# needs (AGENTS.md, scripts/check, settings, hooks) into it without overwriting.
copy_maestro_files() {
  local from="$1" to="$2" f
  while IFS= read -r f; do
    [ -e "$from/$f" ] || continue
    [ -e "$to/$f" ] && continue
    mkdir -p "$(dirname "$to/$f")"
    cp -R "$from/$f" "$to/$f"
  done < <(maestro_files)
}

# Project files are created on demand: init sets up only what the workflow
# needs to start. Skills call `maestro seed <Name>` for the rest.
cmd_init() {
  local dest="${1:-$PWD}"
  mkdir -p "$dest/scripts" "$dest/.claude"
  [ -f "$dest/AGENTS.md" ] || cp "$ROOT/resources/AGENTS.md" "$dest/AGENTS.md"
  [ -f "$dest/CLAUDE.md" ] || printf '@AGENTS.md\n' > "$dest/CLAUDE.md"
  [ -f "$dest/scripts/check" ] || cp "$ROOT/resources/checks.sh" "$dest/scripts/check"
  [ -f "$dest/.claude/settings.json" ] || cp "$ROOT/resources/claude-settings.json" "$dest/.claude/settings.json"
  chmod +x "$dest/scripts/check"
  exclude_maestro_files "$dest"
  if [ -e "$dest/.git" ]; then
    install_git_hooks "$dest"
  fi
  echo "initialized: $dest"
}

# Create one on-demand project file from its template, only when it is absent.
seed_one() {
  local src="$1" dest="$2"
  if [ -e "$dest" ]; then
    echo "kept: $dest"
    return 1
  fi
  mkdir -p "$(dirname "$dest")"
  cp "$src" "$dest"
  echo "created: $dest"
}

# `maestro seed <Name>`: copy a project-file template in if absent. Idempotent;
# prints created:/kept: for each destination.
cmd_seed() {
  local name="${1:-}" dest
  [ -n "$name" ] || {
    echo "usage: maestro seed SPEC.md|PLAN.md|REVIEW.md|GLOSSARY.md|BACKLOG.md|mistakes.md|FEATURE-MAP.md|verify" >&2
    exit 2
  }
  dest="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
  case "$name" in
    SPEC.md|PLAN.md|REVIEW.md|GLOSSARY.md|BACKLOG.md|mistakes.md)
      seed_one "$ROOT/resources/$name" "$dest/$name" || true
      ;;
    FEATURE-MAP.md)
      seed_one "$ROOT/resources/FEATURE-MAP.md" "$dest/docs/FEATURE-MAP.md" || true
      ;;
    verify)
      seed_one "$ROOT/resources/verify.sh" "$dest/scripts/verify" && chmod +x "$dest/scripts/verify" || true
      seed_one "$ROOT/resources/verify.conf" "$dest/scripts/verify.conf" || true
      ;;
    *)
      echo "maestro seed: unknown project file: $name" >&2
      echo "usage: maestro seed SPEC.md|PLAN.md|REVIEW.md|GLOSSARY.md|BACKLOG.md|mistakes.md|FEATURE-MAP.md|verify" >&2
      exit 2
      ;;
  esac
}

cmd_upgrade() {
  local dest="${1:-$PWD}"
  [ -d "$dest" ] || { echo "maestro upgrade: no such directory: $dest" >&2; exit 1; }
  dest="$(cd "$dest" && pwd)"
  if ! command -v python3 >/dev/null 2>&1; then
    echo "maestro upgrade: python3 is required to merge .claude/settings.json." >&2
    echo "Install python3, then re-run: maestro upgrade $dest" >&2
    exit 1
  fi

  local src_settings="$ROOT/resources/claude-settings.json"

  mkdir -p "$dest/scripts" "$dest/.claude"
  local target="$dest/.claude/settings.json" tmp
  tmp="$(mktemp)"
  python3 - "$src_settings" "$target" "$tmp" <<'PY'
import json, sys
src_path, target_path, out_path = sys.argv[1:4]
with open(src_path) as f:
    src = json.load(f)
try:
    with open(target_path) as f:
        target = json.load(f)
except Exception:
    target = {}
if not isinstance(target, dict):
    target = {}
for k, v in src.items():
    if k not in target:
        target[k] = v
with open(out_path, "w") as f:
    json.dump(target, f, indent=2)
    f.write("\n")
PY
  if [ -f "$target" ] && cmp -s "$tmp" "$target"; then
    rm -f "$tmp"
    echo "unchanged: $target"
  else
    if [ -f "$target" ]; then
      cp "$target" "$target.maestro-backup-$STAMP"
      echo "backup: $target -> $target.maestro-backup-$STAMP"
    fi
    mv "$tmp" "$target"
    echo "updated: $target"
  fi

  exclude_maestro_files "$dest"

  if [ -e "$dest/.git" ]; then
    install_git_hooks "$dest"
  fi
}

# ---- Headless builder -------------------------------------------------------
# `maestro build` runs the Claude Code `builder` agent headless (claude -p) on a
# third-party model. Claude drives; the builder only implements and reports.
# Credentials come from per-machine files, never from the repo.

builder_env_file() {
  printf '%s\n' "${BOTTEGA_BUILDER_ENV:-${XDG_CONFIG_HOME:-$HOME/.config}/bottega/builder.env}"
}

# The key lives in its own mode-600 file and reaches claude through apiKeyHelper
# (`maestro keyget`), so it is never in the builder's environment or argv. An
# ANTHROPIC_AUTH_TOKEN line in builder.env still works as a fallback.
builder_key_file() {
  printf '%s\n' "${BOTTEGA_BUILDER_KEY:-${XDG_CONFIG_HOME:-$HOME/.config}/bottega/builder.key}"
}

cmd_keyget() {
  local f
  f="$(builder_key_file)"
  [ -s "$f" ] || exit 1
  tr -d '\r\n ' < "$f"
}

# Succeeds when the headless builder can run. Prints why not on stderr unless
# quiet. Never prints values from the env or key file.
builder_ready() {
  local quiet="${1:-}" file var missing="" bad=""
  say() { [ "$quiet" = "quiet" ] || echo "$1" >&2; }
  file="$(builder_env_file)"
  has_value() { grep -Eq "^(export[[:space:]]+)?($1)=([^[:space:]\"']|[\"'][^\"']+[\"'])" "$file"; }
  # `KEY= value` is not valid shell: name the line instead of reporting the
  # value as missing.
  space_after_eq() {
    grep -nE "^(export[[:space:]]+)?($1)=[[:space:]]" "$file" 2>/dev/null | head -1 || true
  }
  command -v claude >/dev/null 2>&1 || { say "builder: claude is not installed"; return 1; }
  command -v python3 >/dev/null 2>&1 || { say "builder: python3 is required"; return 1; }
  [ -f "$file" ] || { say "builder: not configured (run: maestro build --init)"; return 1; }
  for var in ANTHROPIC_BASE_URL ANTHROPIC_MODEL; do
    bad="$(space_after_eq "$var")"
    if [ -n "$bad" ]; then
      say "builder: $file:${bad%%:*}: remove the space after '=' in $var (write $var=value)"
      return 1
    fi
  done
  if ! has_value "ANTHROPIC_MODEL"; then
    say "builder: $file has no ANTHROPIC_MODEL value; set it to the model your endpoint serves (see docs/SETUP.md)"
    return 1
  fi
  has_value "ANTHROPIC_BASE_URL" || missing="$missing ANTHROPIC_BASE_URL"
  if [ ! -s "$(builder_key_file)" ] && ! has_value "ANTHROPIC_AUTH_TOKEN|ANTHROPIC_API_KEY"; then
    missing="$missing key($(builder_key_file))"
  fi
  if [ -n "$missing" ]; then
    say "builder: $file is missing a value for:$missing"
    return 1
  fi
  return 0
}

builder_init() {
  local file example keyfile k=""
  file="$(builder_env_file)"
  keyfile="$(builder_key_file)"
  example="$ROOT/resources/builder.env.example"
  [ -f "$example" ] || { echo "maestro build --init: $example not found" >&2; exit 1; }
  mkdir -p "$(dirname "$file")"
  if [ -f "$file" ]; then
    echo "exists: $file"
  else
    (umask 077 && cp "$example" "$file")
    chmod 600 "$file"
    echo "created: $file"
  fi
  if [ -s "$keyfile" ]; then
    echo "exists: $keyfile"
  else
    if [ -t 0 ]; then
      read -rsp "Builder API key (hidden; Enter to skip): " k || true
      echo
    else
      read -r k || true
    fi
    if [ -n "$k" ]; then
      (umask 077 && printf '%s\n' "$k" > "$keyfile")
      chmod 600 "$keyfile"
      echo "created: $keyfile"
    else
      echo "skipped: no key entered. Add it later: write it to $keyfile (mode 600)."
    fi
  fi
  echo "Set ANTHROPIC_BASE_URL and the model names in $file, then check with: maestro build --check"
}

# maestro build <run> <task> [--revise <findings>] [--block | --wait]
#   default  wait up to BOTTEGA_BUILD_WAIT seconds (540), then print RUNNING, exit 5
#   --wait   attach to a running build, same bounded wait
#   --block  wait until the build ends; for a background Bash task. The builder
#            itself is capped by BOTTEGA_BUILD_TIMEOUT (default 1800 s = 30 min).
# The median of a sorted list of numbers on stdin; prints nothing for none.
median_of() {
  awk '{ a[NR] = $1 + 0 } END {
    if (NR == 0) exit
    if (NR % 2) print a[(NR + 1) / 2] + 0
    else print (a[NR / 2] + a[NR / 2 + 1]) / 2
  }'
}

# watch_snapshot <rundir>: one pass over the run's events.tsv plus its task
# files, shared by `maestro watch` and each status line. Prints tab-separated
# facts, then one `task <name> <state> <steps> <start> <last>` row per task:
#   mode total complete running queued stalled percent eta elapsed state status label
# States are queued, running, stalled (a running task with no builder event for
# 120 s), and done. Percent and ETA need three steps.tsv samples of role builder
# on the newest builder path: f = 1 done, min(steps/median, 0.95) started,
# 0 queued; percent caps at 95 while tasks remain. ETA minutes =
# ceil(remaining seconds / max(running,1) / 60). `-` when there is no estimate.
watch_snapshot() {
  local rundir="$1" events="$1/events.tsv" bdir mode label="" light=0
  local total=0 complete=0 running=0 queued=0 stalled=0 elapsed=0 state_all=done status=""
  local now tasks stats rows="" t st steps start lastev last first_start="" row
  local root steps_file path nsteps nsecs median_steps median_secs percent="-" eta="-"
  now="$(now_epoch)"
  if [ ! -d "$rundir/tasks" ] \
    && { [ -f "$rundir/run" ] || [ -f "$rundir/report.md" ] || [ -f "$events" ]; }; then
    light=1
  fi
  if [ "$light" = 1 ]; then
    mode=light
    label="$(basename "$rundir")"
    total=1
    bdir="$rundir"
    tasks="-"
    if [ -f "$rundir/report.md" ]; then
      status="$(grep -m1 -o 'STATUS: [A-Z_]*' "$rundir/report.md" 2>/dev/null || true)"
      [ -n "$status" ] || status="STATUS: UNKNOWN"
    fi
  else
    mode=full
    bdir="$rundir/build"
    total="$(find "$rundir/tasks" -maxdepth 1 -name '[0-9]*.md' 2>/dev/null | wc -l | tr -d ' ')"
    # Task files plus whatever a builder wrote, sorted like `build --status`.
    tasks="$({
      for f in "$rundir"/tasks/[0-9]*.md; do
        [ -f "$f" ] || continue
        t="${f##*/}"; printf '%s\n' "${t%.md}"
      done
      for f in "$bdir"/*.report.md; do
        [ -f "$f" ] || continue
        t="${f##*/}"; printf '%s\n' "${t%.report.md}"
      done
      for f in "$bdir"/*.run; do
        [ -f "$f" ] || continue
        t="${f##*/}"; t="${t%.run}"
        [ "${t%.review2}" = "$t" ] || continue
        printf '%s\n' "$t"
      done
    } | sort -u | tr '\n' ' ')"
    [ "$total" -gt 0 ] || { set -- $tasks; total="$#"; }
  fi
  stats=""
  if [ -n "$tasks" ]; then
    if [ -f "$events" ]; then
      stats="$(awk -F'\t' -v tasks="$tasks" '
        BEGIN {
          n = split(tasks, a, " ")
          for (i = 1; i <= n; i++) { steps[a[i]] = 0; first[a[i]] = ""; lastev[a[i]] = "" }
        }
        $4 == "builder" {
          t = $3
          if (!(t in steps)) next
          if ($5 == "step") { steps[t]++; last[t] = $6 }
          if ($5 == "start" && first[t] == "") first[t] = $1 + 0
          if ($1 + 0 > lastev[t] + 0) lastev[t] = $1 + 0
        }
        END {
          for (i = 1; i <= n; i++)
            printf "%s\t%d\t%s\t%s\t%s\n", a[i], steps[a[i]], first[a[i]], lastev[a[i]], last[a[i]]
        }
      ' "$events")"
    else
      stats="$(awk -v tasks="$tasks" 'BEGIN {
        n = split(tasks, a, " ")
        for (i = 1; i <= n; i++) printf "%s\t0\t\t\t\n", a[i]
      }')"
    fi
  fi
  rows=""
  while IFS="$(printf '\t')" read -r t steps start lastev last; do
    [ -n "$t" ] || continue
    if [ "$light" = 1 ]; then
      if [ -f "$rundir/run" ] && [ ! -f "$rundir/rc" ]; then st=running; else st=done; fi
    elif [ -f "$bdir/$t.report.md" ] && grep -q 'STATUS: DONE' "$bdir/$t.report.md" 2>/dev/null; then
      st=done
    elif [ -f "$bdir/$t.rc" ]; then
      # The builder has exited but its caller has not collected the report yet:
      # for progress it is a finished task, not a queued one.
      st=done
    elif [ -f "$bdir/$t.run" ]; then
      st=running
    else
      st=queued
    fi
    case "$start" in ''|*[!0-9]*) start="" ;; esac
    case "$lastev" in ''|*[!0-9]*) lastev="" ;; esac
    case "$steps" in ''|*[!0-9]*) steps=0 ;; esac
    if [ "$st" = running ] && [ -n "$lastev" ] && [ $((now - lastev)) -gt 120 ]; then
      st=stalled
    fi
    case "$st" in
      done) complete=$((complete + 1)) ;;
      running) running=$((running + 1)) ;;
      stalled) running=$((running + 1)); stalled=$((stalled + 1)) ;;
    esac
    if [ -n "$start" ] && { [ -z "$first_start" ] || [ "$start" -lt "$first_start" ]; }; then
      first_start="$start"
    fi
    printf -v row 'task\t%s\t%s\t%s\t%s\t%s\n' "$t" "$st" "$steps" "$start" "$last"
    rows="$rows$row"
  done <<EOF
$stats
EOF
  [ -z "$first_start" ] || elapsed=$((now - first_start))
  queued=$((total - complete - running)); [ "$queued" -ge 0 ] || queued=0
  if [ "$total" -gt 0 ] && [ "$complete" -ge "$total" ]; then state_all=done
  elif [ "$running" -gt 0 ] && [ "$stalled" -eq "$running" ]; then state_all=stalled
  elif [ "$running" -gt 0 ]; then state_all=running
  elif [ "$queued" -gt 0 ]; then state_all=queued
  fi

  case "$rundir" in
    */quick/*) root="$(dirname "$(dirname "$rundir")")" ;;
    *) root="$(dirname "$rundir")" ;;
  esac
  steps_file="$root/steps.tsv"
  if [ -f "$steps_file" ]; then
    path="$(awk -F'\t' '$2 == "builder" && $4 ~ /^[0-9]+$/ && $5 ~ /^[0-9]+$/ {
      if ($1 + 0 >= max) { max = $1 + 0; p = $3 }
    } END { print p }' "$steps_file" 2>/dev/null || true)"
    if [ -n "$path" ]; then
      nsteps="$(awk -F'\t' -v p="$path" '$2 == "builder" && $3 == p && $4 ~ /^[0-9]+$/ { print $4 }' "$steps_file" 2>/dev/null | grep -c . || true)"
      nsecs="$(awk -F'\t' -v p="$path" '$2 == "builder" && $3 == p && $5 ~ /^[0-9]+$/ { print $5 }' "$steps_file" 2>/dev/null | grep -c . || true)"
      if [ "$nsteps" -ge 3 ] && [ "$nsecs" -ge 3 ] && [ "$total" -gt 0 ]; then
        median_steps="$(awk -F'\t' -v p="$path" '$2 == "builder" && $3 == p && $4 ~ /^[0-9]+$/ { print $4 }' "$steps_file" | sort -n | median_of)"
        median_secs="$(awk -F'\t' -v p="$path" '$2 == "builder" && $3 == p && $5 ~ /^[0-9]+$/ { print $5 }' "$steps_file" | sort -n | median_of)"
        if [ "$median_steps" != "0" ]; then
          percent="$(printf '%s\n' "$rows" | awk -F'\t' -v m="$median_steps" -v n="$total" -v d="$complete" '
          $1 == "task" {
            if ($3 == "done") f = 1
            else if ($3 == "running" || $3 == "stalled") { f = ($4 + 0) / m; if (f > 0.95) f = 0.95 }
            else f = 0
            sum += f
          }
          END {
            p = int(sum / n * 100 + 0.5)
            if (p > 95 && d < n) p = 95
            print p + 0
          }')"
          eta="$(printf '%s\n' "$rows" | awk -F'\t' -v ms="$median_secs" -v now="$now" -v r="$running" '
          $1 == "task" {
            if ($3 == "running" || $3 == "stalled") { x = ms - (now - $5); if (x < 0) x = 0; rem += x }
            else if ($3 == "queued") rem += ms
          }
          END {
            d = (r > 0) ? r : 1
            m = rem / d / 60
            e = int(m)
            if (e < m) e++
            print e + 0
          }')"
        fi
      fi
    fi
  fi

  printf 'mode\t%s\n' "$mode"
  printf 'total\t%s\n' "$total"
  printf 'complete\t%s\n' "$complete"
  printf 'running\t%s\n' "$running"
  printf 'queued\t%s\n' "$queued"
  printf 'stalled\t%s\n' "$stalled"
  printf 'percent\t%s\n' "$percent"
  printf 'eta\t%s\n' "$eta"
  printf 'elapsed\t%s\n' "$elapsed"
  printf 'state\t%s\n' "$state_all"
  printf 'status\t%s\n' "$status"
  printf 'label\t%s\n' "$label"
  printf '%s' "$rows"
}

# One status line for a run: done/running/queued counts plus running tasks.
build_status_line() {
  local rundir="$1" snap k a b c d e mode total complete running queued status label
  local rows="" t steps last out sl row tab
  tab="$(printf '\t')"
  snap="$(watch_snapshot "$rundir")"
  mode=""; total=0; complete=0; running=0; queued=0; status=""; label=""
  while IFS="$(printf '\t')" read -r k a b c d e; do
    case "$k" in
      mode) mode="$a" ;;
      total) total="$a" ;;
      complete) complete="$a" ;;
      running) running="$a" ;;
      queued) queued="$a" ;;
      status) status="$a" ;;
      label) label="$a" ;;
      task)
        case "$b" in
          running|stalled)
            printf -v row '%s\t%s\t%s\n' "$a" "$c" "$e"
            rows="$rows$row" ;;
        esac ;;
    esac
  done <<EOF
$snap
EOF
  if [ "$mode" = light ]; then
    sl=""
    if [ "$running" -gt 0 ]; then
      IFS="$tab" read -r t steps last <<EOF
$rows
EOF
      sl=" │ $label: $steps steps, last ${last:--}"
    elif [ -n "$status" ]; then
      sl=" │ $label: $status"
    fi
    echo "Builders $complete/$total done · $running running · $queued queued$sl"
    return 0
  fi
  out="Builders $complete/$total done · $running running · $queued queued"
  while IFS="$(printf '\t')" read -r t steps last; do
    [ -n "$t" ] || continue
    out="$out │ $t: $steps steps, last ${last:--}"
  done <<EOF
$rows
EOF
  echo "$out"
}

# `maestro build --status <run>`: one reading of the run's events and tasks.
# The live view moved to `maestro watch <run>`; `--every` is rejected so an old
# invocation names the replacement instead of silently polling.
build_status() {
  local slug="" dir rc
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --every) echo "maestro build --status: --every was removed; use maestro watch <run> for a live view" >&2; exit 2 ;;
      --*) echo "maestro build --status: unknown flag: $1" >&2; exit 2 ;;
      *) slug="$1"; shift ;;
    esac
  done
  require_run_id "build --status" "$slug"
  dir="$(resolve_run_dir "$slug")" || {
    rc=$?
    if [ "$rc" -eq 2 ]; then echo "maestro build --status: not in a git repository" >&2; else echo "no such run: $slug" >&2; fi
    exit 2
  }
  [ -f "$dir/hold" ] && echo "HOLD: $(run_hold_reason "$dir")"
  build_status_line "$dir"
}

# `maestro watch --line`: the one-line form for Claude Code's status line. It
# reads the hook JSON on stdin, takes workspace.current_dir, picks the newest
# open non-paused run by events.tsv mtime, and prints one line. Nothing to show
# (no JSON, outside a repo, no run) prints nothing. Always exits 0.
watch_line() {
  local input dir base newest f snap k a b total=0 complete=0 stalled=0
  local percent="-" eta="-" suffix=""
  input="$(cat 2>/dev/null || true)"
  dir="$(printf '%s' "$input" | sed -n 's/.*"current_dir"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)"
  [ -n "$dir" ] && [ -d "$dir" ] || return 0
  cd "$dir" 2>/dev/null || return 0
  base="$(state_dir 2>/dev/null)" || return 0
  [ -d "$base" ] || return 0
  newest=""
  for f in "$base"/*/events.tsv "$base"/quick/*/events.tsv; do
    [ -f "$f" ] || continue
    if [ -f "$(dirname "$f")/paused" ]; then continue; fi
    if [ -z "$newest" ] || [ "$f" -nt "$newest" ]; then newest="$f"; fi
  done
  [ -n "$newest" ] || return 0
  snap="$(watch_snapshot "$(dirname "$newest")")"
  while IFS="$(printf '\t')" read -r k a b; do
    case "$k" in
      total) total="$a" ;;
      complete) complete="$a" ;;
      stalled) stalled="$a" ;;
      percent) percent="$a" ;;
      eta) eta="$a" ;;
    esac
  done <<EOF
$snap
EOF
  if [ "$percent" = "-" ] || [ "$eta" = "-" ]; then
    printf '%s/%s tasks\n' "$complete" "$total"
    return 0
  fi
  if [ "$stalled" -gt 0 ]; then suffix=" · stalled"; fi
  printf '%s/%s tasks · ~%s%% · ETA %sm%s\n' "$complete" "$total" "$percent" "$eta" "$suffix"
  return 0
}

# Elapsed seconds as a short label: 45s, 12m, 1h5m.
fmt_elapsed() {
  local s="$1"
  case "$s" in ''|*[!0-9]*) s=0 ;; esac
  if [ "$s" -lt 60 ]; then
    printf '%ss\n' "$s"
  elif [ "$s" -lt 3600 ]; then
    printf '%sm\n' "$((s / 60))"
  else
    printf '%sh%sm\n' "$((s / 3600))" "$(((s % 3600) / 60))"
  fi
}

# watch_progress <rundir>: two lines for the plain view. The first is the change
# key `<n>/<N> <state>`; the second is the `progress:` line to post. The caller
# prints the line only when the key changes, so a steady build stays quiet.
watch_progress() {
  local rundir="$1" snap k a b c d e complete=0 total=0 state="" stalled=0
  local percent="-" eta="-" line=""
  snap="$(watch_snapshot "$rundir")"
  while IFS="$(printf '\t')" read -r k a b c d e; do
    case "$k" in
      total) total="$a" ;;
      complete) complete="$a" ;;
      state) state="$a" ;;
      stalled) stalled="$a" ;;
      percent) percent="$a" ;;
      eta) eta="$a" ;;
    esac
  done <<EOF
$snap
EOF
  line="progress: $complete/$total tasks"
  if [ "$percent" != "-" ] && [ "$eta" != "-" ]; then
    line="$line · ~$percent% · ETA ${eta}m"
  fi
  [ "$stalled" -gt 0 ] && line="$line · stalled"
  printf '%s\n%s\n' "$complete/$total $state" "$line"
}

# watch_frame <rundir>: the full view. A header with the task count, the
# estimate-labelled percent and ETA, and elapsed time, then one row per task.
watch_frame() {
  local rundir="$1" snap k a b c d e total=0 complete=0 state="" stalled=0
  local percent="-" eta="-" elapsed=0 label="" rows="" row header est
  snap="$(watch_snapshot "$rundir")"
  while IFS="$(printf '\t')" read -r k a b c d e; do
    case "$k" in
      total) total="$a" ;;
      complete) complete="$a" ;;
      state) state="$a" ;;
      stalled) stalled="$a" ;;
      percent) percent="$a" ;;
      eta) eta="$a" ;;
      elapsed) elapsed="$a" ;;
      label) label="$a" ;;
      task)
        case "$b" in
          done) printf -v row '  %s  done  %s steps\n' "$a" "$c" ;;
          running) printf -v row '  %s  running  %s steps, last %s\n' "$a" "$c" "${e:--}" ;;
          stalled) printf -v row '  %s  stalled  %s steps, last %s\n' "$a" "$c" "${e:--}" ;;
          *) printf -v row '  %s  queued\n' "$a" ;;
        esac
        rows="$rows$row" ;;
    esac
  done <<EOF
$snap
EOF
  [ -n "$label" ] || label="$(basename "$rundir")"
  if [ "$percent" = "-" ] || [ "$eta" = "-" ]; then
    est='~?% · ETA ?m (estimate)'
  else
    est="~$percent% · ETA ${eta}m (estimate)"
  fi
  header="Watch $label: $complete/$total tasks · $est · elapsed $(fmt_elapsed "$elapsed")"
  printf '%s\n%s' "$header" "$rows"
}

# `maestro watch <run>`: follow a run until it is done, held, or closed. On a
# TTY it redraws the full view every BOTTEGA_WATCH_EVERY seconds (default 30);
# piped, it polls every 5 seconds and prints a `progress:` line only when the
# task count or state changes. BOTTEGA_WATCH_TTY=1|0 and BOTTEGA_WATCH_ONCE=1
# are test seams. An unknown run exits 2.
watch_run() {
  local slug="$1" dir tty=0 once=0 every poll out key line last="" rc
  dir="$(resolve_run_dir "$slug")" || {
    rc=$?
    if [ "$rc" -eq 2 ]; then echo "maestro watch: not in a git repository" >&2; else echo "no such run: $slug" >&2; fi
    exit 2
  }
  case "${BOTTEGA_WATCH_TTY:-}" in
    1) tty=1 ;;
    0) tty=0 ;;
    *) if [ -t 1 ]; then tty=1; fi ;;
  esac
  if [ "${BOTTEGA_WATCH_ONCE:-}" = "1" ]; then once=1; fi
  case "${BOTTEGA_WATCH_EVERY:-}" in
    ''|*[!0-9]*) every=30 ;;
    *) every="$BOTTEGA_WATCH_EVERY" ;;
  esac
  poll="$every"; [ "$tty" = 1 ] || poll="${BOTTEGA_WATCH_EVERY:-5}"
  while :; do
    [ -d "$dir" ] || return 0
    if [ -f "$dir/hold" ]; then
      echo "HOLD: $(run_hold_reason "$dir")"
      return 0
    fi
    out="$(watch_progress "$dir")"
    key="$(printf '%s\n' "$out" | sed -n '1p')"
    line="$(printf '%s\n' "$out" | sed -n '2p')"
    if [ "$tty" = 1 ]; then
      [ "$once" = 1 ] || printf '\033[H\033[2J'
      watch_frame "$dir"
    elif [ "$key" != "$last" ]; then
      printf '%s\n' "$line"
      last="$key"
    fi
    [ "$once" = 1 ] && return 0
    case "$key" in *" done") return 0 ;; esac
    sleep "$poll"
  done
}

cmd_watch() {
  case "${1:-}" in
    --line) watch_line; return ;;
  esac
  require_run_id "watch" "${1:-}"
  watch_run "$@"
}

# Start a detached headless run, so a timeout or kill of the caller cannot stop
# it. The optional agent and tool arguments default to the builder's.
# with_timeout <seconds> <cmd...>: GNU timeout, Homebrew gtimeout, or a perl
# alarm on a stock macOS (exit 142 there instead of 124).
with_timeout() {
  if command -v timeout >/dev/null 2>&1; then timeout "$@"
  elif command -v gtimeout >/dev/null 2>&1; then gtimeout "$@"
  else perl -e 'alarm shift; exec @ARGV' "$@"
  fi
}

start_build_exec() {
  local wt="$1" envfile="$2" promptfile="$3" log="$4" rcfile="$5" events="$6" profile="$7" sid="${8:-}"
  # Empty strings fall back to the builder defaults in cmd_build_exec.
  # setsid detaches the builder from the caller's session; macOS has no setsid,
  # so fall back to nohup there.
  local detach=nohup
  command -v setsid >/dev/null 2>&1 && detach=setsid
  "$detach" "$SELF" _build-exec "$wt" "$envfile" "$promptfile" "$log" "$rcfile" "$events" "$profile" "$sid" \
    "${9:-}" "${10:-}" "${11:-}" "${12:-}" "${13:-}" "${14:--}" "${15:-builder}" \
    </dev/null >/dev/null 2>&1 &
}

# Bounded wait shared by every build flavour. --block waits for the builder's
# own timeout (plus a minute) so a background task ends when the build ends.
build_wait_limit() {
  if [ "${1:-0}" = "1" ]; then
    echo $(( ${BOTTEGA_BUILD_TIMEOUT:-1800} + 60 ))
  else
    echo "${BOTTEGA_BUILD_WAIT:-540}"
  fi
}

# Shared by every build flavour: mark a build whose process died (no .rc after
# six hours) as failed, wait (bounded), and collect the result.
build_mark_stale() {
  [ -f "$2" ] || [ -z "$(find "$1" -mmin +360 2>/dev/null)" ] || echo 1 > "$2"
}

# build_lost_collect <rcfile> <what> <report> <marker> <limit>: another caller
# won the collect claim. Wait (bounded) for it to finish: it removes the claimed
# rc file and the run marker only after the report is written, so the report
# path this prints always names an existing file. Then print the reply and exit 0.
build_lost_collect() {
  local rcfile="$1" what="$2" report="$3" marker="${4:-}" limit="$5" waited=0 owned
  while [ "$waited" -lt "$limit" ]; do
    if ls "$rcfile".collecting.* >/dev/null 2>&1; then
      owned=1
    else
      owned=0
      [ -n "$marker" ] && [ -f "$marker" ] && owned=1
    fi
    [ "$owned" -eq 1 ] || break
    sleep 2
    waited=$((waited + 2))
  done
  echo "$what"
  echo "already collected by another caller"
  [ -n "$report" ] && [ -f "$report" ] && echo "report: $report"
  exit 0
}

# build_wait_or_exit <rcfile> <block> <events> <task> <role> <what> <again> [run-marker] [report]:
# wait; if another caller collected the result, say so and exit 0; if the build
# is still going, print where it stands and exit 5.
build_wait_or_exit() {
  local rcfile="$1" block="$2" events="$3" task="$4" role="$5" what="$6" again="$7" marker="${8:-}" report="${9:-}" last tickdir=""
  if [ -n "$events" ]; then tickdir="$(dirname "$events")"; fi
  build_wait "$rcfile" "$(build_wait_limit "$block")" "$marker" "$tickdir"
  [ -f "$rcfile" ] && return 0
  if [ -n "$marker" ] && [ ! -f "$marker" ]; then
    build_lost_collect "$rcfile" "$what" "$report" "$marker" "$(build_wait_limit "$block")"
  fi
  echo "RUNNING $what (still going; call again: $again)"
  echo "steps so far: $(build_steps "$events" "$task" "$role")"
  last="$(build_last_step "$events" "$task" "$role")"
  [ -n "$last" ] && echo "last step: $last"
  echo "events: $events"
  exit 5
}

# Print the first error line from a log or its report file. Called via $( ), so
# it must not be a heredoc: bash 3.2 (macOS) cannot parse a heredoc inside a
# command substitution. A single-quoted `python3 -c` string is portable.
build_first_error() {
  python3 -c '
import json, os, sys
log_path, report_path = sys.argv[1:3]

def first_log_line():
    if not os.path.isfile(log_path):
        return ""
    with open(log_path, errors="replace") as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            try:
                ev = json.loads(line)
            except Exception:
                return line  # plain stderr output: the endpoint error
            if isinstance(ev, dict) and ev.get("type") == "result":
                for key in ("error", "result"):
                    msg = ev.get(key)
                    if isinstance(msg, str) and msg.strip():
                        return msg.strip().splitlines()[0].strip()
    return ""

line = first_log_line()
if not line and os.path.isfile(report_path):
    with open(report_path, errors="replace") as f:
        for raw in f:
            if raw.strip():
                line = raw.strip()
                break
if line:
    print(line)
' "$1" "$2"
}

# A failed run that spent no tokens was rejected before it did any work (model,
# endpoint, or key). Print the first plain error line on stderr so the API error
# is on the console instead of only in the log or report file.
build_failure_note() {
  local rc="$1" log="$2" report="$3" first
  [ "$rc" -ne 0 ] || return 0
  case "$(build_tokens "$log")" in
    "in 0 out 0"|unknown) ;;
    *) return 0 ;;
  esac
  first="$(build_first_error "$log" "$report")"
  [ -n "$first" ] && printf 'error: %s\n' "$first" >&2
  return 0
}

# build_collect <rcfile> <run> <log> <out>: claim the rc file, print the exit
# code, and turn the log into the final reply at <out>. The rename is atomic, so
# when two callers attach to one build exactly one collects; the loser returns 1
# and its caller prints the already-collected reply. The run marker is removed
# last, after the report is written, so a waiting caller never sees a finished
# build whose report is still missing.
build_collect() {
  local claimed="$1.collecting.$$" rc
  mv "$1" "$claimed" 2>/dev/null || return 1
  rc="$(cat "$claimed")"
  cap_log "$3"
  build_result_text "$3" "$4"
  build_failure_note "$rc" "$3" "$4"
  rm -f "$claimed" "$1" "$2"
  printf '%s\n' "$rc"
}

# build_usage_lines <who> <rc> <log> <events> <task>
build_usage_lines() {
  local note=""
  if [ "$2" = 124 ] || [ "$2" = 142 ]; then note=" (timed out)"; fi
  echo "$1 exit: $2$note"
  echo "tokens: $(build_tokens "$3")"
  echo "steps: $(build_steps "$4" "$5" "$1")"
}

# build_progress_tick <rundir>: print one `progress:` line when the done count or
# the overall state changes. Called by build_wait before it starts, on every 2 s
# poll, and once more before the result is collected, so every headless build
# shows progress without the master running anything.
build_progress_tick() {
  local rundir="$1" out key line
  [ -n "$rundir" ] && [ -d "$rundir" ] || return 0
  out="$(watch_progress "$rundir")"
  key="$(printf '%s\n' "$out" | sed -n '1p')"
  line="$(printf '%s\n' "$out" | sed -n '2p')"
  [ "$key" != "${_BOTTEGA_PROGRESS_LAST:-}" ] || return 0
  _BOTTEGA_PROGRESS_LAST="$key"
  printf '%s\n' "$line"
}

# Wait for the rc file. When a run marker is given, stop early if it disappears:
# another caller collected the result and removed both files. <tickdir> is the
# run directory whose progress is printed on change.
build_wait() {
  local rcfile="$1" limit="$2" marker="${3:-}" tickdir="${4:-}" waited=0
  build_progress_tick "$tickdir"
  while [ ! -f "$rcfile" ] && { [ -z "$marker" ] || [ -f "$marker" ]; } \
    && [ "$waited" -lt "$limit" ]; do
    sleep 2
    waited=$((waited + 2))
    build_progress_tick "$tickdir"
  done
  build_progress_tick "$tickdir"
}

# Token usage from the final stream result event: input includes cache reads and
# writes. Prints `in <n> out <n>`, or `unknown` when the log has no usage.
build_tokens() {
  local log="$1"
  [ -f "$log" ] || { echo unknown; return 0; }
  python3 - "$log" <<'PY'
import json, sys
tokens = None
with open(sys.argv[1], errors="replace") as f:
    for line in f:
        try:
            ev = json.loads(line)
        except Exception:
            continue
        if ev.get("type") != "result":
            continue
        usage = ev.get("usage")
        if not isinstance(usage, dict):
            tokens = None
            continue
        inp = usage.get("input_tokens")
        out = usage.get("output_tokens")
        if inp is None and out is None:
            tokens = None
            continue
        inp = (inp or 0) + (usage.get("cache_read_input_tokens") or 0) \
            + (usage.get("cache_creation_input_tokens") or 0)
        tokens = "in %d out %d" % (inp, out or 0)
print(tokens or "unknown")
PY
}

# Current time as epoch seconds. BOTTEGA_NOW overrides it for tests.
now_epoch() {
  case "${BOTTEGA_NOW:-}" in
    ''|*[!0-9]*) date +%s ;;
    *) printf '%s\n' "$BOTTEGA_NOW" ;;
  esac
}

# One event-log field: tabs, CR, and LF would break the TSV, so they become
# spaces. Appends are a single short write with O_APPEND, so parallel builders
# do not interleave lines.
event_field() {
  printf '%s' "$1" | tr '\t\r\n' '   '
}

# event_log <events> <run> <task> <role> <kind> <step>
# `time run task role kind step`, six tab-separated fields, no header.
event_log() {
  local events="$1"
  [ -n "$events" ] || return 0
  printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$(now_epoch)" \
    "$(event_field "$2")" "$(event_field "$3")" "$(event_field "$4")" \
    "$(event_field "$5")" "$(event_field "$6")" >> "$events"
}

# Number of step events for one task and role; 0 when the log is missing.
build_steps() {
  local events="$1" task="$2" role="$3"
  [ -f "$events" ] || { echo 0; return 0; }
  awk -F'\t' -v t="$task" -v r="$role" \
    '$5 == "step" && $3 == t && $4 == r { n++ } END { print n + 0 }' "$events"
}

# The last step event's text for one task and role, or nothing.
build_last_step() {
  local events="$1" task="$2" role="$3"
  [ -f "$events" ] || return 0
  awk -F'\t' -v t="$task" -v r="$role" \
    '$5 == "step" && $3 == t && $4 == r { s = $6 } END { if (s != "") print s }' "$events"
}

# The report status carried by the stream's final result event, or MISSING.
build_log_status() {
  local log="$1"
  [ -f "$log" ] || { echo MISSING; return 0; }
  python3 - "$log" <<'PY'
import json, re, sys
status = "MISSING"
try:
    with open(sys.argv[1], errors="replace") as f:
        for line in f:
            try:
                ev = json.loads(line)
            except Exception:
                continue
            if not isinstance(ev, dict) or ev.get("type") != "result":
                continue
            text = ev.get("result")
            if isinstance(text, str):
                m = re.search(r"STATUS: ([A-Z_]+)", text)
                if m:
                    status = m.group(1)
except Exception:
    pass
print(status)
PY
}

# Append a finished rev-0 builder build to the state root's steps history:
# `time role path steps seconds`. The root outlives the run (report --close
# removes only the run directory), so later runs can use it for estimates.
steps_record() {
  local base="$1" role="$2" path="$3" steps="$4" seconds="$5"
  [ -n "$base" ] && [ -d "$base" ] || return 0
  printf '%s\t%s\t%s\t%s\t%s\n' "$(now_epoch)" "$role" "$(event_field "$path")" \
    "$steps" "$seconds" >> "$base/steps.tsv"
}

# Effort for a role from the routing rule file written by `/maestro-models`:
# one line per role as `role: value, effort`, where effort is low, medium, or
# high. Prints the effort, or nothing when the file or role is missing. A
# malformed line is skipped and a later valid line is still read. The file's
# contents are never printed.
model_effort() {
  local role="$1" file line key value effort
  file="$(config_dir claude)/rules/bottega-models.md"
  [ -f "$file" ] || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%%#*}"
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [ -n "$line" ] || continue
    case "$line" in
      *:*) ;;
      *) continue ;;
    esac
    key="${line%%:*}"
    key="${key%"${key##*[![:space:]]}"}"
    [ "$key" = "$role" ] || continue
    value="${line#*:}"
    case "$value" in
      *,*) ;;
      *) continue ;;
    esac
    value="${value%%,*}"
    effort="${line##*,}"
    value="$(printf '%s' "$value" | tr -d '[:space:]')"
    effort="$(printf '%s' "$effort" | tr -d '[:space:]')"
    [ -n "$value" ] || continue
    case "$effort" in
      low|medium|high) printf '%s\n' "$effort"; return 0 ;;
    esac
  done < "$file"
}

# The final assistant text in a stream-json log, written to a file. Used by the
# read-only second-opinion review: the reviewer has no Write tool, so its reply
# is captured here.
build_result_text() {
  local log="$1" out="$2"
  [ -f "$log" ] || return 0
  python3 - "$log" "$out" <<'PY'
import json, sys
log_path, out_path = sys.argv[1:3]
text = ""
with open(log_path, errors="replace") as f:
    for line in f:
        try:
            ev = json.loads(line)
        except Exception:
            continue
        if ev.get("type") == "result":
            result = ev.get("result")
            if isinstance(result, str) and result.strip():
                text = result
if text:
    with open(out_path, "w") as f:
        f.write(text.rstrip() + "\n")
PY
}

# Cap a builder log: over 20 MB, keep only the last 5 MB.
cap_log() {
  local log="$1" size
  [ -f "$log" ] || return 0
  size="$(wc -c < "$log" | tr -d ' ')"
  [ "$size" -gt 20971520 ] || return 0
  tail -c 5242880 "$log" > "$log.tmp" && mv "$log.tmp" "$log"
}

# `maestro build --here <slug> --task "<text>" [--revise <file|->] [--block|--wait]`:
# the light path. No run, spec, or worktree; the builder works in the current
# checkout and commits on the current branch. All state lives in the state
# directory. A revision resumes the first build's session (max two).
build_here() {
  local slug="" text="" findings="" block=0 have_text=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --task) text="${2:?--task needs text}"; have_text=1; shift 2 ;;
      --revise) findings="${2:?findings file required}"; shift 2 ;;
      --block) block=1; shift ;;
      --wait) shift ;;
      --*) echo "maestro build --here: unknown flag: $1" >&2; exit 2 ;;
      *)
        [ -z "$slug" ] || { echo "maestro build --here: one slug only" >&2; exit 2; }
        slug="$1"; shift ;;
    esac
  done
  if ! run_id_ok "$slug"; then
    # Keep the wording an existing e2e case pins for an uppercase slug.
    case "$slug" in
      *[ABCDEFGHIJKLMNOPQRSTUVWXYZ]*) echo "maestro build --here: slug must be lowercase letters, digits, and hyphens: $slug" >&2 ;;
      *) require_run_id "build --here" "$slug" ;;
    esac
    exit 2
  fi

  local repo branch qdir
  repo="$(git rev-parse --show-toplevel 2>/dev/null)" || { echo "maestro build --here: not a git repository" >&2; exit 3; }
  branch="$(git -C "$repo" branch --show-current)"
  [ -n "$branch" ] || { echo "maestro build --here: detached HEAD; switch to a branch first" >&2; exit 3; }
  qdir="$(light_dir "$slug")" || { echo "maestro build --here: could not create the state directory" >&2; exit 3; }

  local run="$qdir/run" rcfile="$qdir/rc" events="$qdir/events.tsv"
  local prompt="$qdir/prompt" log="$qdir/builder.log" profile="$qdir/settings.json"
  local report="$qdir/report.md" base="" state="$qdir/light.builder"
  local max_rev=2 rev=0 sid="" findings_text="" t0=""

  if [ -f "$run" ]; then
    base="$(sed -n 's/^base=//p' "$run")"
    rev="$(sed -n 's/^rev=//p' "$run")"; rev="${rev:-0}"
    sid="$(sed -n 's/^sid=//p' "$run")"
  elif [ "$have_text" = "0" ] && [ -z "$findings" ]; then
    echo 'usage: maestro build --here <slug> --task "<text>" [--revise <file|->] [--block|--wait]' >&2
    exit 2
  fi

  if [ -n "$findings" ]; then
    if [ "$findings" = "-" ]; then
      findings_text="$(cat)"
    else
      [ -f "$findings" ] || { echo "maestro build --here: findings file not found: $findings" >&2; exit 3; }
      findings_text="$(cat "$findings")"
    fi
  fi

  builder_ready || exit 3

  if [ -f "$run" ]; then
    # Already running or finished but not collected: attach.
    build_mark_stale "$run" "$rcfile"
  else
    local msg
    if [ -n "$findings" ]; then
      [ -f "$state" ] || { echo "maestro build --here: no session for $slug; run a first build" >&2; exit 3; }
      sid="$(sed -n 's/^session=//p' "$state")"
      rev="$(sed -n 's/^revisions=//p' "$state")"; rev="${rev:-0}"
      base="$(sed -n 's/^base=//p' "$state")"
      if [ "$rev" -ge "$max_rev" ]; then
        echo "maestro build --here: $max_rev revisions used; escalate to the human (workflow rule: max two fix rounds)" >&2
        exit 4
      fi
      rev=$((rev + 1))
      msg="Revision $rev for light-path run $slug.
Checkout: $repo
Branch: $branch
Fix every finding below, nothing else. Stay inside Allowed files. Do not edit or weaken tests. Commit locally on $branch. Never push or merge. Write no report file: end your final reply with the report in the format of the implementation skill (first line: STATUS: READY|DONE|BLOCKED).

## Findings
$findings_text"
    else
      base="$(git -C "$repo" rev-parse HEAD)"
      msg="Quick task: $text
Checkout: $repo
Branch: $branch
No run folder and no separate worktree: work in this checkout only.
Stay inside the Allowed files for the task.
Commit locally on $branch. Never push or merge.
Write no report file: end your final reply with the report in the format of the implementation skill (first line: STATUS: READY|DONE|BLOCKED)."
    fi
    printf '%s\n' "$msg" > "$prompt"
    rm -f "$rcfile" "$report"
    printf 'base=%s\nrev=%s\nsid=%s\n' "$base" "$rev" "$sid" > "$run"
    event_log "$events" "$slug" - builder start "rev=$rev"
    t0="$(now_epoch)"
    start_build_exec "$repo" "$(builder_env_file)" "$prompt" "$log" "$rcfile" "$events" "$profile" "$sid" \
      "" "" "" "" "$slug" - builder
  fi

  build_wait_or_exit "$rcfile" "$block" "$events" - builder "task: $slug" "maestro build --here $slug --task \"<text>\" --wait" "$run" "$report"

  local rc status="MISSING" commits=0 secs=0
  rc="$(build_collect "$rcfile" "$run" "$log" "$report")" \
    || build_lost_collect "$rcfile" "task: $slug" "$report" "$run" "$(build_wait_limit "$block")"
  if [ -z "$sid" ]; then
    sid="$(grep -o '"session_id":"[^"]*"' "$log" | head -1 | cut -d'"' -f4 || true)"
  fi
  printf 'session=%s\nrevisions=%s\nagent=builder\nbase=%s\n' "$sid" "$rev" "$base" > "$state"
  [ -s "$report" ] && status="$(grep -m1 -o 'STATUS: [A-Z_]*' "$report" || echo UNKNOWN)"
  [ -n "$base" ] && commits="$(git -C "$repo" rev-list --count "$base"..HEAD 2>/dev/null || echo 0)"
  [ -n "$t0" ] && secs=$(( $(now_epoch) - t0 ))
  [ "$rev" -eq 0 ] && [ "$rc" -eq 0 ] && [ "$status" = "STATUS: DONE" ] \
    && steps_record "$(state_dir)" builder "$repo" "$(build_steps "$events" - builder)" "$secs"

  echo "task: $slug"
  echo "session: ${sid:-none}"
  echo "revisions: $rev/$max_rev"
  build_usage_lines builder "$rc" "$log" "$events" -
  echo "report: $report ($status)"
  echo "commits on $branch: $commits"
  echo "files changed:"; git -C "$repo" diff --name-only "$base"...HEAD 2>/dev/null | sed 's/^/  /'
  [ "$rc" -eq 0 ] && [ "$status" != "MISSING" ] || exit 1
}

# `maestro build --review <run> <task> [--block|--wait]`: a read-only second
# opinion from the review-code agent in the task worktree. Its reply lands in
# the run's build/<task>.review2.md.
# The base ref a light-path review diffs against: the default branch, else the root commit.
default_base_ref() {
  local repo="$1" r
  for r in "$(git -C "$repo" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null)" main master; do
    if [ -n "$r" ] && git -C "$repo" rev-parse --verify -q "$r" >/dev/null 2>&1; then
      printf '%s\n' "$r"
      return
    fi
  done
  git -C "$repo" rev-list --max-parents=0 HEAD | head -1
}

build_review() {
  local slug="" task="" block=0 here=0 npos=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --block) block=1; shift ;;
      --wait) shift ;;
      --here) here=1; shift ;;
      --*) echo "maestro build --review: unknown flag: $1" >&2; exit 2 ;;
      *)
        case "$npos" in
          0) slug="$1" ;;
          1) task="$1" ;;
          *) echo "maestro build --review: unexpected argument: $1" >&2; exit 2 ;;
        esac
        npos=$((npos + 1)); shift ;;
    esac
  done
  if [ "$here" = "1" ]; then
    require_run_id "build --review --here" "$slug"
    [ -z "$task" ] || { echo "usage: maestro build --review --here <slug> [--block|--wait]" >&2; exit 2; }
  else
    require_run_id "build --review" "$slug"
    [ -n "$task" ] || { echo "usage: maestro build --review <run> <task> | --here <slug> [--block|--wait]" >&2; exit 2; }
  fi

  local repo name dir wt bdir pre findings again base
  repo="$(git rev-parse --show-toplevel 2>/dev/null)" || { echo "maestro build --review: not a git repository" >&2; exit 3; }
  if [ "$here" = "1" ]; then
    # Light path: review the current checkout; state sits beside the quick run.
    # Resolve the state read-only: an unknown slug must fail before the builder
    # starts (so before any model call), not create a directory and run.
    base="$(state_dir)" || { echo "maestro build --review: not in a git repository" >&2; exit 3; }
    dir="$base/quick/$slug"
    [ -d "$dir" ] || { echo "maestro build --review: no such run: $slug" >&2; exit 1; }
    wt="$repo"
    bdir="$dir"; pre="review"; findings="$dir/review.md"
    again="maestro build --review --here $slug --wait"
  else
    name="$(basename "$repo")"
    dir="$(run_state_dir "$slug")" || { echo "maestro build --review: not in a git repository" >&2; exit 3; }
    wt="$(cd "$repo/.." && pwd)/$name-bottega/$slug/$task"
    [ -d "$dir" ] || { echo "maestro build --review: no such run: $slug" >&2; exit 1; }
    [ -d "$wt" ] || { echo "maestro build --review: no worktree $wt (run: maestro worktree create $slug $task)" >&2; exit 3; }
    bdir="$dir/build"; pre="$task.review2"; findings="$bdir/$task.review2.md"
    again="maestro build --review $slug $task --wait"
  fi
  builder_ready || exit 3
  local run="$bdir/$pre.run"
  local rcfile="$bdir/$pre.rc"
  local events="$dir/events.tsv"
  local prompt="$bdir/$pre.prompt"
  local log="$bdir/$pre.log"
  local profile="$bdir/$pre.settings.json"
  local evtask="$task"
  [ "$here" = "1" ] && evtask="-"
  mkdir -p "$bdir"

  if [ -f "$run" ]; then
    build_mark_stale "$run" "$rcfile"
  else
    local diff_base
    if [ "$here" = "1" ]; then
      diff_base="$(default_base_ref "$wt")"
    elif git -C "$wt" rev-parse --verify -q "$(run_branch "$slug")" >/dev/null 2>&1; then
      diff_base="$(run_branch "$slug")"
    else
      diff_base="$(git -C "$wt" rev-list --max-parents=0 HEAD | head -1)"
    fi
    if [ "$here" = "1" ]; then
      cat > "$prompt" <<EOF
Second opinion for the light-path run $slug.
Checkout: $wt
Diff: git diff $diff_base...HEAD (in the checkout)
Review only: never edit code, never commit, never push.
Do not write any file. Reply with the full findings as your final message, in markdown.
EOF
    else
    cat > "$prompt" <<EOF
Second opinion for run $slug, task $task.
Worktree: $wt
Run state (outside the repo): $dir
Spec: $dir/spec.md
Task text: $dir/tasks/$task.md
Builder report: $bdir/$task.report.md
Diff: git diff $diff_base...HEAD (in the worktree)
Review only: never edit code, never commit, never push.
Do not write any file. Reply with the full findings as your final message, in markdown.
EOF
    fi
    rm -f "$rcfile" "$findings"
    printf 'sid=\n' > "$run"
    event_log "$events" "$slug" "$evtask" reviewer start "rev=0"
    start_build_exec "$wt" "$(builder_env_file)" "$prompt" "$log" "$rcfile" "$events" "$profile" "" \
      "bottega:review-code" "Read,Grep,Glob,Bash" "Read,Grep,Glob,Bash" \
      "Edit,Write,NotebookEdit,Bash(git commit:*),Bash(git add:*),Bash(git push:*),Bash(git merge:*),Bash(git reset:*),Bash(git clean:*),Bash(sudo:*),Bash(rm -rf:*),Bash(gh:*)" \
      "$slug" "$evtask" reviewer
  fi

  build_wait_or_exit "$rcfile" "$block" "$events" "$evtask" reviewer "review: $slug $task" "$again"

  local rc
  rc="$(build_collect "$rcfile" "$run" "$log" "$findings")" \
    || build_lost_collect "$rcfile" "review: $slug $task" "$findings" "" "$(build_wait_limit "$block")"

  echo "review: $slug $task"
  build_usage_lines reviewer "$rc" "$log" "$events" "$evtask"
  echo "findings: $findings ($([ -s "$findings" ] && echo present || echo missing))"
  [ "$rc" -eq 0 ] && [ -s "$findings" ] || exit 1
}

cmd_build() {
  case "${1:-}" in
    --status) shift; build_status "$@"; return ;;
    --init) builder_init; return ;;
    --check)
      if builder_ready; then echo "builder: ready ($(builder_env_file))"; else exit 1; fi
      return
      ;;
    --here) shift; build_here "$@"; return ;;
    --review) shift; build_review "$@"; return ;;
  esac

  local usage="usage: maestro build <run> <task> [--revise <file|->] [--block|--wait] | --here <slug> --task \"<text>\" [--revise <file|->] [--block|--wait] | --review <run> <task> [--block|--wait] | --init | --check | --status <run>"
  [ "$#" -ge 2 ] || { echo "$usage" >&2; exit 2; }
  local slug="$1" task="$2" findings="" block=0
  shift 2
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --revise) findings="${2:?findings file required}"; shift 2 ;;
      --wait) shift ;;
      --block) block=1; shift ;;
      *) echo "$usage" >&2; exit 2 ;;
    esac
  done

  require_run_id "build" "$slug"
  builder_ready || exit 3
  local envfile repo name dir wt max_rev=2
  envfile="$(builder_env_file)"
  repo="$(git rev-parse --show-toplevel)"
  name="$(basename "$repo")"
  dir="$(run_state_dir "$slug")" || { echo "maestro build: not in a git repository" >&2; exit 3; }
  wt="$(cd "$repo/.." && pwd)/$name-bottega/$slug/$task"
  local bdir="$dir/build"
  local report="$bdir/$task.report.md"
  local state="$bdir/$task.builder"
  local log="$bdir/$task.builder.log"
  local run="$bdir/$task.run"
  local rcfile="$bdir/$task.rc"
  local events="$dir/events.tsv"
  local profile="$bdir/$task.settings.json"
  local promptfile="$bdir/$task.prompt"
  local taskfile="$dir/tasks/$task.md"

  [ -d "$dir" ] || { echo "maestro build: no such run: $slug (run: maestro start \"<title>\")" >&2; exit 3; }
  [ -f "$taskfile" ] || { echo "maestro build: no such task: $task (run: maestro spec $slug)" >&2; exit 3; }
  [ -d "$wt" ] || { echo "maestro build: no worktree $wt (run: maestro worktree create $slug $task)" >&2; exit 3; }
  mkdir -p "$bdir"
  local branch rev=0 sid="" findings_text="" t0=""
  branch="$(git -C "$wt" branch --show-current)"

  if [ -n "$findings" ]; then
    if [ "$findings" = "-" ]; then
      findings_text="$(cat)"
    else
      [ -f "$findings" ] || { echo "maestro build: findings file not found: $findings" >&2; exit 3; }
      findings_text="$(cat "$findings")"
    fi
  fi

  if [ -f "$run" ]; then
    # A build for this task is running or finished but not collected: attach.
    rev="$(sed -n 's/^rev=//p' "$run")"; rev="${rev:-0}"
    sid="$(sed -n 's/^sid=//p' "$run")"
    build_mark_stale "$run" "$rcfile"
  else
    local msg
    if [ -n "$findings" ]; then
      [ -f "$state" ] || { echo "maestro build: no session for $task; run a first build" >&2; exit 3; }
      sid="$(sed -n 's/^session=//p' "$state")"
      rev="$(sed -n 's/^revisions=//p' "$state")"; rev="${rev:-0}"
      if [ "$rev" -ge "$max_rev" ]; then
        echo "maestro build: $max_rev revisions used; escalate to the human (workflow rule: max two fix rounds)" >&2
        exit 4
      fi
      rev=$((rev + 1))
      msg="Revision $rev for run $slug, task $task.
Worktree: $wt
Branch: $branch
Fix every finding below, nothing else. Stay inside Allowed files. Do not edit or weaken tests. Commit locally on $branch. Never push or merge. Write no report file: end your final reply with the report in the format of the implementation skill (first line: STATUS: READY|DONE|BLOCKED).

## Findings
$findings_text"
    else
      msg="Run: $slug
Task: $task
Worktree: $wt
Branch: $branch
Work only in the worktree. The run state lives outside the repo: $dir
Stay inside Allowed files. Commit locally on $branch. Never push or merge.
Write no report file: end your final reply with the report in the format of the implementation skill (first line: STATUS: READY|DONE|BLOCKED).

## Task $task
$(cat "$taskfile")"
    fi
    printf '%s\n' "$msg" > "$promptfile"
    rm -f "$rcfile"
    printf 'rev=%s\nsid=%s\n' "$rev" "$sid" > "$run"
    event_log "$events" "$slug" "$task" builder start "rev=$rev"
    t0="$(now_epoch)"
    start_build_exec "$wt" "$envfile" "$promptfile" "$log" "$rcfile" "$events" "$profile" "$sid" \
      "" "" "" "" "$slug" "$task" builder
  fi

  build_wait_or_exit "$rcfile" "$block" "$events" "$task" builder "task: $task" "maestro build $slug $task --wait" "$run" "$report"

  local rc
  rc="$(build_collect "$rcfile" "$run" "$log" "$report")" \
    || build_lost_collect "$rcfile" "task: $task" "$report" "$run" "$(build_wait_limit "$block")"
  if [ -z "$sid" ]; then
    sid="$(grep -o '"session_id":"[^"]*"' "$log" | head -1 | cut -d'"' -f4 || true)"
  fi
  printf 'session=%s\nrevisions=%s\nagent=builder\n' "$sid" "$rev" > "$state"

  local status="MISSING" commits secs=0
  [ -s "$report" ] && status="$(grep -m1 -o 'STATUS: [A-Z_]*' "$report" || echo UNKNOWN)"
  commits="$(git -C "$wt" log --oneline "$(run_branch "$slug")..HEAD" 2>/dev/null | wc -l | tr -d ' ')"
  [ -n "$t0" ] && secs=$(( $(now_epoch) - t0 ))
  [ "$rev" -eq 0 ] && [ "$rc" -eq 0 ] && [ "$status" = "STATUS: DONE" ] \
    && steps_record "$(state_dir)" builder "$wt" "$(build_steps "$events" "$task" builder)" "$secs"

  echo "task: $task"
  echo "run: $slug"
  echo "session: ${sid:-none}"
  echo "revisions: $rev/$max_rev"
  build_usage_lines builder "$rc" "$log" "$events" "$task"
  echo "report: $report ($status)"
  echo "commits on $branch: $commits"
  echo "files changed:"; git -C "$wt" diff --name-only "$(run_branch "$slug")...HEAD" 2>/dev/null | sed 's/^/  /'
  [ "$rc" -eq 0 ] && [ "$status" != "MISSING" ] || exit 1
}

# Internal: run the headless builder and record its exit code. Started detached
# by cmd_build. A per-run settings profile (--settings outranks user and project
# settings) pins the endpoint and models and, when builder.key exists, an
# apiKeyHelper, with the auth env vars blanked so no settings `env` block can
# inject a credential. builder.env is sourced in a subshell only; nothing is
# echoed. Stream events are logged; tool calls also become step events in the
# run's events.tsv.
cmd_build_exec() {
  local wt="$1" envfile="$2" promptfile="$3" log="$4" rcfile="$5" events="$6" profile="$7" sid="${8:-}" rc helper=""
  # Plugin agents are namespaced; a bare name only exists in an old copy-install.
  local agent="${9:-bottega:builder}"
  local tools="${10:-Bash,Edit,Glob,Grep,Read,Skill,Write,TodoWrite}"
  local allowed="${11:-Read,Grep,Glob,Edit,Write,Bash,Skill,TodoWrite}"
  local disallowed="${12:-Bash(git push:*),Bash(git merge:*),Bash(git reset --hard:*),Bash(git clean:*),Bash(sudo:*),Bash(rm -rf:*),Bash(gh:*)}"
  local run="${13:-}" task="${14:--}" evrole="${15:-builder}"
  local -a resume=()
  [ -n "$sid" ] && resume=(--resume "$sid")
  # The headless runner's effort comes from the routing file: the builder line
  # for implementations, the second-opinion line for reviews.
  local role="builder" effort
  case "$agent" in *review-code) role="second-opinion" ;; esac
  effort="$(model_effort "$role")"
  local -a effort_arg=()
  [ -n "$effort" ] && effort_arg=(--effort "$effort")
  # BOTTEGA_PLUGIN_DIR loads a checkout of the stack as the plugin (used by the eval playbook).
  local -a plugin_arg=()
  [ -n "${BOTTEGA_PLUGIN_DIR:-}" ] && plugin_arg=(--plugin-dir "$BOTTEGA_PLUGIN_DIR")
  [ -s "$(builder_key_file)" ] && helper="\"$SELF\" keyget"
  trap 'event_log "$events" "$run" "$task" "$evrole" "end" "rc=143 MISSING"; echo 143 > "$rcfile"; exit 143' TERM HUP
  set +e
  (
    unset ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN CLAUDE_CODE_OAUTH_TOKEN
    # builder.env is the source for the tier aliases too: a Claude Code session's
    # ambient aliases must not leak into a third-party build.
    unset ANTHROPIC_DEFAULT_OPUS_MODEL ANTHROPIC_DEFAULT_SONNET_MODEL \
      ANTHROPIC_DEFAULT_HAIKU_MODEL CLAUDE_CODE_SUBAGENT_MODEL
    set -a; . "$envfile"; set +a
    # The builder agent asks for a Claude tier alias; on a third-party endpoint
    # every alias must name the served model. Explicit values still win.
    if [ -n "${ANTHROPIC_MODEL:-}" ]; then
      : "${ANTHROPIC_DEFAULT_OPUS_MODEL:=$ANTHROPIC_MODEL}"
      : "${ANTHROPIC_DEFAULT_SONNET_MODEL:=$ANTHROPIC_MODEL}"
      : "${ANTHROPIC_DEFAULT_HAIKU_MODEL:=$ANTHROPIC_MODEL}"
      : "${CLAUDE_CODE_SUBAGENT_MODEL:=$ANTHROPIC_MODEL}"
      export ANTHROPIC_DEFAULT_OPUS_MODEL ANTHROPIC_DEFAULT_SONNET_MODEL \
        ANTHROPIC_DEFAULT_HAIKU_MODEL CLAUDE_CODE_SUBAGENT_MODEL
    fi
    python3 - "$profile" "$helper" <<'PY'
import json, os, sys
path, helper = sys.argv[1:3]
names = ("ANTHROPIC_BASE_URL", "ANTHROPIC_MODEL", "ANTHROPIC_DEFAULT_OPUS_MODEL",
         "ANTHROPIC_DEFAULT_SONNET_MODEL", "ANTHROPIC_DEFAULT_HAIKU_MODEL",
         "CLAUDE_CODE_SUBAGENT_MODEL")
env = {k: os.environ[k] for k in names if os.environ.get(k)}
env["CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC"] = "1"
env["BOTTEGA_HEADLESS"] = "1"
prof = {"env": env}
if helper:
    prof["apiKeyHelper"] = helper
    env["ANTHROPIC_AUTH_TOKEN"] = ""
    env["ANTHROPIC_API_KEY"] = ""
with open(path, "w") as f:
    json.dump(prof, f)
PY
    export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
    export BOTTEGA_HEADLESS=1
    cd "$wt" && with_timeout "${BOTTEGA_BUILD_TIMEOUT:-1800}" claude -p "$(cat "$promptfile")" --agent "$agent" \
      ${effort_arg[@]+"${effort_arg[@]}"} ${plugin_arg[@]+"${plugin_arg[@]}"} \
      --output-format stream-json --verbose \
      ${resume[@]+"${resume[@]}"} \
      --settings "$profile" \
      --permission-mode acceptEdits \
      --tools "$tools" --strict-mcp-config \
      --allowedTools "$allowed" \
      --disallowedTools "$disallowed"
  ) 2>&1 | tee "$log" | python3 -c '
import json, os, sys, time
events, run, task, evrole = sys.argv[1:5]
fixed = os.environ.get("BOTTEGA_NOW", "")

def stamp():
    return fixed if fixed.isdigit() else str(int(time.time()))

def clean(value):
    return str(value).replace("\t", " ").replace("\r", " ").replace("\n", " ")

with open(events, "a") as out:
    for line in sys.stdin:
        try:
            ev = json.loads(line)
        except Exception:
            continue
        if ev.get("type") != "assistant":
            continue
        for b in (ev.get("message") or {}).get("content") or []:
            if isinstance(b, dict) and b.get("type") == "tool_use":
                i = b.get("input") or {}
                arg = i.get("file_path") or i.get("command") or i.get("pattern") or i.get("path") or ""
                step = clean("%s: %s" % (b.get("name"), arg))[:100]
                out.write("%s\t%s\t%s\t%s\tstep\t%s\n" % (stamp(), run, task, evrole, step))
                out.flush()
' "$events" "$run" "$task" "$evrole" >/dev/null
  rc=${PIPESTATUS[0]}
  event_log "$events" "$run" "$task" "$evrole" "end" "rc=$rc $(build_log_status "$log")"
  echo "$rc" > "$rcfile"
}

# Hooks used by the /maestro command (frontmatter, so they only apply while
# /maestro runs).
#   guard builder  PreToolUse: deny the Claude-model builder when the headless
#                  builder is configured; allow it otherwise (fallback).
#   guard stop     Stop: do not let the master end its turn between steps. It
#                  blocks only while a run is mid-pipeline with nothing running;
#                  when every open run is on hold, it lets the session end.
cmd_guard() {
  # Headless builder/reviewer sessions load the same plugin hooks: stay out of their way.
  [ -z "${BOTTEGA_HEADLESS:-}" ] || exit 0
  case "${1:-}" in
    builder) guard_builder ;;
    stop) guard_stop ;;
    *) echo "usage: maestro guard builder|stop" >&2; exit 2 ;;
  esac
}

guard_builder() {
  local input parsed
  input="$(cat)"
  # Python parses the hook payload. Bad JSON or a shape we do not recognise
  # fails open: a silent hook is harmless, one that blocks every Agent call is not.
  command -v python3 >/dev/null 2>&1 || exit 0
  parsed="$(printf '%s' "$input" | python3 -c '
import json, sys

try:
    hook = json.load(sys.stdin)
except Exception:
    sys.exit(0)
if not isinstance(hook, dict):
    sys.exit(0)
tool = hook.get("tool_input")
if not isinstance(tool, dict):
    sys.exit(0)
kind = tool.get("subagent_type")
if not isinstance(kind, str) or not kind:
    sys.exit(0)
missing = [k for k in ("model", "effort")
           if not isinstance(tool.get(k), str) or not tool.get(k).strip()]
if kind.startswith("bottega:") and missing:
    print("missing:" + ",".join(missing))
else:
    print("kind:" + kind)
')" || exit 0
  # Every bottega agent call names both parameters, so the master cannot fall
  # back to the harness default by accident.
  case "$parsed" in
    missing:*)
      printf '%s\n' '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"Every BottegaStack agent call must pass the Agent tool model and effort parameters, routed from ~/.claude/rules/bottega-models.md (see agents/master.md). Add both."}}'
      exit 0
      ;;
  esac
  # Plugin agents are namespaced (bottega:builder); accept either form.
  case "${parsed#kind:}" in builder|*:builder) ;; *) exit 0 ;; esac
  builder_ready quiet || exit 0
  printf '%s\n' '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"The headless builder is configured. Do not spawn the Claude-model builder: create the worktree with `maestro worktree create <run> <task>`, then run `maestro build <run> <task> --block` as a background Bash task (see Step 2)."}}'
}

# The todo list is the source of truth: the master must keep going while an
# item is pending or in_progress. The list comes from the transcript (TodoWrite,
# or TaskCreate/TaskUpdate when TodoWrite is unavailable). Anything unexpected
# fails open: a silent hook is harmless, a hook that blocks forever is not.
guard_stop() {
  local input sdir r todo_out gap
  input="$(cat)"
  command -v python3 >/dev/null 2>&1 || exit 0
  # Never block a stop the harness already blocked once.
  printf '%s' "$input" | tr -d '\n' | grep -Eq '"stop_hook_active"[[:space:]]*:[[:space:]]*true' && exit 0
  # Only act while this repo has an open run (a run or light-path folder that
  # `maestro report --close` has not removed): the plugin hook is global, and an
  # ordinary session with open todos must not be nudged. A paused run is closed
  # until it is resumed, so its marker takes it out of this check. The logs kept
  # in the state root (trust.log, findings.log, decisions/) do not count.
  sdir="$(state_dir 2>/dev/null || true)"
  [ -n "$sdir" ] && [ -d "$sdir" ] || exit 0
  local active=0 held=0 hold_slug="" hold_reason="" active_dirs=""
  for r in "$sdir"/*/ "$sdir"/quick/*/; do
    [ -d "$r" ] || continue
    case "$r" in "$sdir"/decisions/|"$sdir"/quick/) continue ;; esac
    [ -f "$r/paused" ] && continue
    active=$((active + 1))
    if [ -f "$r/hold" ]; then
      held=$((held + 1))
      if [ -z "$hold_slug" ]; then
        hold_slug="$(basename "$r")"
        hold_reason="$(run_hold_reason "$r")"
      fi
    else
      active_dirs="$active_dirs$r
"
    fi
  done
  [ "$active" -gt 0 ] || exit 0
  # Every open run is on hold: the master escalated, so let the turn end.
  if [ "$held" -eq "$active" ]; then
    echo "run $hold_slug is on hold: $hold_reason"
    exit 0
  fi
  # A builder is running (a .run with no .rc yet): let the turn end while it works.
  for r in "$sdir"/*/build/*.run "$sdir"/quick/*/*.run; do
    [ -f "$r" ] || continue
    [ -f "${r%.run}.rc" ] || exit 0
  done
  todo_out="$(printf '%s' "$input" | python3 -c '
import json, sys

try:
    hook = json.load(sys.stdin)
except Exception:
    sys.exit(0)
if not isinstance(hook, dict):
    sys.exit(0)
if hook.get("stop_hook_active") is True:
    sys.exit(0)
background = hook.get("background_tasks")
if isinstance(background, list) and background:
    sys.exit(0)
path = hook.get("transcript_path")
if not isinstance(path, str) or not path:
    sys.exit(0)

items = []
next_id = 1
try:
    with open(path, "r", encoding="utf-8") as fh:
        for line in fh:
            line = line.strip()
            if not line:
                continue
            try:
                ev = json.loads(line)
            except Exception:
                continue
            if not isinstance(ev, dict) or ev.get("type") != "assistant":
                continue
            content = (ev.get("message") or {}).get("content") or []
            if not isinstance(content, list):
                continue
            for b in content:
                if not isinstance(b, dict) or b.get("type") != "tool_use":
                    continue
                name = b.get("name")
                inp = b.get("input") or {}
                if not isinstance(inp, dict):
                    continue
                if name == "TodoWrite":
                    todos = inp.get("todos")
                    if not isinstance(todos, list):
                        continue
                    items = []
                    for t in todos:
                        if not isinstance(t, dict):
                            continue
                        items.append({
                            "id": None,
                            "subject": str(t.get("content", "")),
                            "status": str(t.get("status", "")),
                        })
                elif name == "TaskCreate":
                    items.append({
                        "id": next_id,
                        "subject": str(inp.get("subject", "")),
                        "status": str(inp.get("status", "pending")),
                    })
                    next_id += 1
                elif name == "TaskUpdate":
                    tid = inp.get("taskId")
                    status = inp.get("status")
                    for it in items:
                        if it["id"] is not None and str(it["id"]) == str(tid):
                            if status:
                                it["status"] = str(status)
                            break
except Exception:
    sys.exit(0)

for it in items:
    if it["status"] in ("pending", "in_progress"):
        subject = it["subject"] or "an open todo item"
        print(json.dumps({
            "decision": "block",
            "reason": "Todo item %s is still open. Continue to the next step now without asking the user to proceed; if you are truly blocked, ask with AskUserQuestion." % json.dumps(subject),
        }))
        sys.exit(0)
print("ALL_DONE")
sys.exit(0)
')"
  case "$todo_out" in
    ALL_DONE) ;;
    '') exit 0 ;;
    *) printf '%s\n' "$todo_out"; exit 0 ;;
  esac
  # Every todo is complete, so the session may end only once each open run has
  # recorded its close-out evidence. Runs on hold are exempt (already escalated);
  # paused runs never reached this point.
  while IFS= read -r r; do
    [ -n "$r" ] || continue
    gap="$(run_evidence_gap "$r")"
    [ -n "$gap" ] || continue
    printf '%s' "$gap" | python3 -c 'import json, sys; print(json.dumps({"decision": "block", "reason": sys.stdin.read().strip()}))'
    exit 0
  done <<< "$active_dirs"
  exit 0
}

cmd_worktree() {
  local action="${1:-}"
  case "$action" in
    create)
      local slug="${2-}" task="${3-}"
      if [ "$#" -gt 3 ]; then shift 3; else set --; fi
      require_run_id "worktree create" "$slug"
      [ -n "$task" ] || { echo "maestro worktree create: task required" >&2; exit 2; }
      local newbranch="" newbase=""
      while [ "$#" -gt 0 ]; do
        case "$1" in
          --branch) newbranch="${2:?--branch needs a name}"; shift 2 ;;
          --base) newbase="${2:?--base needs a ref}"; shift 2 ;;
          *) echo "maestro worktree create: unknown argument: $1" >&2; exit 2 ;;
        esac
      done
      local repo name base
      repo="$(git rev-parse --show-toplevel)"
      name="$(basename "$repo")"
      base="$(git branch --show-current)"
      if [ -n "$newbranch" ]; then
        # A named branch (orchestrate units): the user's name, from --base or the
        # current branch. prune never deletes it; it is the unit's PR branch.
        if git show-ref --verify --quiet "refs/heads/$newbranch"; then
          echo "maestro worktree create: branch already exists: $newbranch" >&2; exit 1
        fi
        git worktree add -b "$newbranch" "../$name-bottega/$slug/$task" "${newbase:-$base}" || exit 1
      else
      local rb
      rb="$(run_branch "$slug")"
      git worktree add -b "$rb-$task" "../$name-bottega/$slug/$task" "$rb" 2>/dev/null \
        || git worktree add -b "$rb-$task" "../$name-bottega/$slug/$task" "$base"
      fi
      local path="../$name-bottega/$slug/$task"
      copy_maestro_files "$repo" "$repo/$path"
      local port=$((5100 + ($(printf '%s' "$path" | cksum | awk '{print $1}') % 400)))
      echo "worktree: $path"
      echo "port: $port"
      ;;
    prune)
      local slug="" force=0
      shift || true
      while [ "$#" -gt 0 ]; do
        case "$1" in
          --force) force=1; shift ;;
          --*) echo "unknown flag: $1" >&2; exit 1 ;;
          *) slug="$1"; shift ;;
        esac
      done
      require_run_id "worktree prune" "$slug"
      local repo name root wt
      repo="$(git rev-parse --show-toplevel)"
      name="$(basename "$repo")"
      root="../$name-bottega/$slug"
      if [ -d "$root" ]; then
        local rb tb
        rb="$(run_branch "$slug")"
        for wt in "$root"/*; do
          [ -d "$wt" ] || continue
          tb="$rb-$(basename "$wt")"
          local fflag=""
          [ "$force" = "1" ] && fflag="--force"
          if git worktree remove $fflag "$wt" 2>/dev/null; then
            echo "removed: $wt"
            # Delete only the local task branch, and only when it is merged (-d
            # refuses otherwise). The run branch and remotes are never touched.
            if [ "$tb" != "$rb" ] && git show-ref --verify --quiet "refs/heads/$tb"; then
              if git branch -d "$tb" >/dev/null 2>&1; then
                echo "deleted branch: $tb"
              else
                echo "kept branch: $tb (not merged)"
              fi
            fi
          else
            echo "failed: $wt (uncommitted changes; use --force)"
          fi
        done
      else
        echo "no worktrees for $slug"
      fi
      ;;
    *)
      echo "usage: maestro worktree create <run> <task> | prune <run> [--force]" >&2
      exit 1
      ;;
  esac
}

cmd_report() {
  local retro=0 exit_code=0 close="" finding_run="" finding_title="" trust=0 trust_n=10
  local close_set=0 finding_set=0 t_playbook="" t_risk="" t_outcome=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --retro) retro=1; shift ;;
      --exit-code) retro=1; exit_code=1; shift ;;
      --close) close="${2-}"; close_set=1; shift; if [ "$#" -gt 0 ]; then shift; fi ;;
      --playbook) t_playbook="${2:?--playbook needs a value}"; shift 2 ;;
      --risk) t_risk="${2:?--risk needs a value}"; shift 2 ;;
      --outcome) t_outcome="${2:?--outcome needs a value}"; shift 2 ;;
      --trust) trust=1; shift; case "${1:-}" in ''|-*) ;; *[!0-9]*) ;; *) trust_n="$1"; shift ;; esac ;;
      --finding) finding_run="${2-}"; finding_title="${3-}"; finding_set=1; shift; if [ "$#" -gt 0 ]; then shift; fi; if [ "$#" -gt 0 ]; then shift; fi ;;
      -*) echo "unknown flag: $1" >&2; exit 1 ;;
      *) echo "unknown argument: $1" >&2; exit 1 ;;
    esac
  done
  if [ "$trust" = "1" ]; then
    cmd_trust "$trust_n"
    return
  fi
  if [ "$close_set" = "1" ]; then
    cmd_close "$close" "$t_playbook" "$t_risk" "$t_outcome"
    return
  fi
  if [ "$finding_set" = "1" ]; then
    cmd_finding "$finding_run" "$finding_title"
    return
  fi
  if [ "$retro" = "1" ]; then
    local -a retro_args=()
    [ "$exit_code" = "1" ] && retro_args+=(--exit-code)
    cmd_retro_scan ${retro_args[@]+"${retro_args[@]}"}
    return
  fi
  cmd_status
}

# `maestro report --finding <run> "<title>"`: record one blocking review finding
# so the retro scan can spot a finding that repeats across runs. The log lives
# in the state directory root, so closing a run does not remove it.
cmd_finding() {
  local slug="${1:-}" title="${2:-}" base
  require_run_id "report --finding" "$slug"
  title="$(printf '%s' "$title" | tr '\t\n' '  ')"
  [ -n "$title" ] || { echo "maestro report --finding: empty title" >&2; exit 2; }
  base="$(ensure_state_dir)" || { echo "maestro report --finding: not in a git repository" >&2; exit 1; }
  printf '%s\t%s\n' "$slug" "$title" >> "$base/findings.log"
  echo "noted: $title"
}

# `maestro report --close <run> [--playbook p --risk r --outcome o]`: append one
# line to the trust log (state-directory root, so it outlives the run), then
# remove the run's state directory. `--outcome paused` keeps the directory and
# writes a dated `paused` marker so a resume can use it; a later close with any
# other outcome removes it. The master calls this at close.
cmd_close() {
  local slug="${1:-}" playbook="${2:-}" risk="${3:-}" outcome="${4:-}" base dir
  require_run_id "report --close" "$slug"
  base="$(ensure_state_dir)" || { echo "maestro report --close: not in a git repository" >&2; exit 1; }
  dir="$base/$slug"
  # A light-path run lives in quick/<slug>; close it the same way.
  [ -d "$dir" ] || dir="$base/quick/$slug"
  if [ -d "$dir" ]; then
    local rounds=0 r f checks
    for f in "$dir"/build/*.builder "$dir"/*.builder; do
      [ -f "$f" ] || continue
      r="$(sed -n 's/^revisions=//p' "$f")"; rounds=$((rounds + ${r:-0}))
    done
    checks="none"
    [ -f "$dir/checks.result" ] && checks="$(sed -n 's/^RESULT:[[:space:]]*//p' "$dir/checks.result" | head -1)"
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$(date +%F)" "$slug" "${playbook:--}" "${risk:--}" "$rounds" "${checks:-none}" "${outcome:--}" \
      | tr -d '\r' >> "$base/trust.log"
    if [ "$outcome" = "paused" ]; then
      (umask 077; printf '%s\n' "$(date +%F)" > "$dir/paused")
      echo "paused: $dir"
    else
      rm -rf -- "$dir"
      echo "closed: $dir"
    fi
  else
    echo "no such run: $slug" >&2
    exit 1
  fi
}

# `maestro report --trust [n]`: summarize the last n closed runs (default 10)
# from the trust log. It only reports; nothing is switched on by it.
cmd_trust() {
  local n="${1:-10}" base log total clean reworked rejected
  base="$(ensure_state_dir)" || { echo "maestro report --trust: not in a git repository" >&2; exit 1; }
  log="$base/trust.log"
  [ -s "$log" ] || { echo "no closed runs recorded yet"; return 0; }
  echo "last runs (date, run, playbook, risk, fix rounds, checks, outcome):"
  tail -n "$n" "$log" | column -t -s "$(printf '\t')"
  tail -n "$n" "$log" | awk -F'\t' '
    { t++; if ($5 == 0 && $6 == "PASS") clean++; else if ($5 > 0) rework++; if ($7 == "rejected") rej++ }
    END { printf "summary: %d runs, %d clean (no fix rounds, checks PASS), %d needed fix rounds, %d rejected\n", t, clean, rework, rej }'
}

cmd_status() {
  local base d name found=0 ntasks ndone checks
  base="$(ensure_state_dir)" || { echo "not in a git repository" >&2; return 1; }
  for d in "$base"/*/; do
    [ -d "$d" ] || continue
    name="$(basename "$d")"
    [ "$name" = quick ] && continue
    found=1
    ntasks="$(find "$d/tasks" -maxdepth 1 -name '[0-9]*.md' 2>/dev/null | wc -l | tr -d ' ')"
    ndone="$(grep -l 'STATUS: DONE' "$d"/build/*.report.md 2>/dev/null | wc -l | tr -d ' ' || true)"
    checks="none"
    [ -f "$d/checks.result" ] && checks="$(sed -n 's/^RESULT:[[:space:]]*//p' "$d/checks.result" | head -1)"
    printf '%-32s tasks=%s done=%s checks=%s\n' "$name" "${ntasks:-0}" "${ndone:-0}" "${checks:-none}"
  done
  [ "$found" = "1" ] || echo "no runs"
}


git_dir_for() {
  local repo="$1" gitdir
  [ -d "$repo" ] || { echo "maestro hooks: no such directory: $repo" >&2; exit 1; }
  repo="$(cd "$repo" && pwd)"
  if ! gitdir="$(git -C "$repo" rev-parse --git-dir 2>/dev/null)"; then
    echo "maestro hooks: not a git repository: $repo" >&2
    exit 1
  fi
  case "$gitdir" in
    /*) ;;
    *) gitdir="$repo/$gitdir" ;;
  esac
  printf '%s\n' "$gitdir"
}

install_git_hooks() {
  local repo="$1" gitdir hooks
  gitdir="$(git_dir_for "$repo")"
  hooks="$gitdir/hooks"
  mkdir -p "$hooks"
  # Record this binary so the hook has a fallback outside a Claude session. The
  # cache path is versioned, so the hook also checks the cache at run time.
  local hook src dest tmp path
  path="$(printf '%s\n' "$SELF" | sed 's/[\\&|]/\\&/g')"
  for hook in pre-commit pre-push; do
    src="$ROOT/resources/git-hooks/$hook"
    dest="$hooks/$hook"
    if [ -e "$dest" ] && ! grep -q 'bottega-managed' "$dest" 2>/dev/null; then
      cp -p "$dest" "$dest.maestro-backup-$STAMP"
      echo "backup: $dest -> $dest.maestro-backup-$STAMP"
    fi
    tmp="$dest.maestro-tmp-$STAMP"
    sed -e "s|^MAESTRO_BIN=.*|MAESTRO_BIN=\"$path\"|" "$src" > "$tmp"
    mv "$tmp" "$dest"
    chmod +x "$dest"
    echo "installed: $dest"
  done
}

uninstall_git_hooks() {
  local repo="$1" gitdir hooks
  gitdir="$(git_dir_for "$repo")"
  hooks="$gitdir/hooks"
  local hook dest
  for hook in pre-commit pre-push; do
    dest="$hooks/$hook"
    if [ -f "$dest" ] && grep -q 'bottega-managed' "$dest" 2>/dev/null; then
      rm -f "$dest"
      echo "removed: $dest"
    else
      echo "skipped: $dest (not bottega-managed)"
    fi
  done
}


cmd_hooks() {
  local action="${1:-}" path="${2:-$PWD}"
  case "$action" in
    install) install_git_hooks "$path" ;;
    uninstall) uninstall_git_hooks "$path" ;;
    *)
      echo "usage: maestro hooks install|uninstall [path]" >&2
      exit 1
      ;;
  esac
}



cmd_retro_scan() {
  local exit_code=0 state
  [ "${1:-}" = "--exit-code" ] && exit_code=1
  state="$(ensure_state_dir)" || { echo "retro-scan: not in a git repository" >&2; exit 1; }
  # findings.log holds one "<run>\t<title>" line per blocking finding; a title
  # (case-insensitive) recorded in two or more runs is a repeat.
  [ -s "$state/findings.log" ] || { echo "retro-scan: no repeated findings"; return 0; }
  local out
  out="$(awk -F'\t' 'NF >= 2 && $2 != "" { t = tolower($2); if (!seen[t SUBSEP $1]++) { n[t]++; title[t] = $2; runs[t] = runs[t] " " $1 } }
    END { for (t in n) if (n[t] >= 2) printf "%d runs: %s (runs:%s)\n", n[t], title[t], runs[t] }' "$state/findings.log" 2>/dev/null | sort -rn)"
  if [ -z "$out" ]; then
    echo "retro-scan: no repeated findings"
    return 0
  fi
  printf '%s\n' "$out"
  [ "$exit_code" = "1" ] && return 1
  return 0
}

# True when the project has a dependency manifest that an update bot could watch.
has_dependency_manifest() {
  local f
  for f in package.json pyproject.toml requirements.txt Pipfile go.mod Cargo.toml Gemfile composer.json pom.xml build.gradle build.gradle.kts mix.exs pubspec.yaml; do
    [ -f "$f" ] && return 0
  done
  return 1
}

# Optional tools: rtk (token savings) and gitleaks (pre-commit secret scan).
tools_missing() {
  local t out=""
  for t in rtk gitleaks; do command -v "$t" >/dev/null 2>&1 || out="$out $t"; done
  printf '%s\n' "${out# }"
}

tools_ask() {
  [ "${TOOLS_YES:-0}" = "1" ] && return 0
  local ans
  printf '%s [y/N] ' "$1" >&2
  read -r ans 2>/dev/null </dev/tty || return 1
  case "$ans" in y|Y|yes) return 0 ;; *) return 1 ;; esac
}

tools_install_cmd() {
  case "$1" in
    gitleaks)
      if command -v brew >/dev/null 2>&1; then echo "brew install gitleaks"
      elif command -v dnf >/dev/null 2>&1; then echo "sudo dnf install -y gitleaks"
      elif command -v apt-get >/dev/null 2>&1; then echo "sudo apt-get install -y gitleaks"
      elif command -v go >/dev/null 2>&1; then echo "go install github.com/zricethezav/gitleaks/v8@latest"
      fi ;;
    rtk)
      if command -v brew >/dev/null 2>&1; then echo "brew install rtk"
      elif command -v cargo >/dev/null 2>&1; then echo "cargo install --locked --git https://github.com/rtk-ai/rtk"
      elif command -v curl >/dev/null 2>&1; then echo "installer"
      fi ;;
  esac
}

tools_install_rtk_script() {
  local f
  f="$(mktemp "${TMPDIR:-/tmp}/rtk-install.XXXXXX")"
  curl -fsSL https://raw.githubusercontent.com/rtk-ai/rtk/refs/heads/master/install.sh -o "$f" || { rm -f "$f"; return 1; }
  echo "Downloaded the rtk installer to $f. Read it before running it." >&2
  if tools_ask "Run $f with sh?"; then sh "$f"; local rc=$?; rm -f "$f"; return $rc; fi
  rm -f "$f"; return 1
}

# One settings reader for the SessionStart hint and `maestro statusline`.
# Prints four tab-separated fields: statusLine (set|unset), refreshInterval
# (<n>|unset), command class (maestro|custom|none), and the command. A missing
# file reads as empty settings; unreadable or invalid JSON, or a missing
# python3, returns 1. `maestro` means the command is <config>/statusline.sh and
# that file carries the bottega marker.
statusline_read() {
  local file="$1" cfg
  cfg="$(dirname "$file")"
  command -v python3 >/dev/null 2>&1 || return 1
  python3 -c '
import json, os, sys
path, cfg = sys.argv[1], sys.argv[2]
if not os.path.exists(path):
    sys.stdout.write("unset\tunset\tnone\n")
    sys.exit(0)
try:
    with open(path) as f:
        data = json.load(f)
except (OSError, ValueError):
    sys.exit(1)
if not isinstance(data, dict):
    sys.exit(1)
cmd, sl_set, ri = "", "unset", "unset"
sl = data.get("statusLine")
if isinstance(sl, dict):
    cmd = sl.get("command") if isinstance(sl.get("command"), str) else ""
    r = sl.get("refreshInterval")
    if isinstance(r, int) and not isinstance(r, bool):
        ri = str(r)
if cmd:
    sl_set = "set"
klass = "none"
if cmd:
    if cmd == os.path.join(cfg, "statusline.sh"):
        try:
            with open(cmd) as f:
                marked = "# bottega-managed statusline" in f.read()
        except OSError:
            marked = False
        klass = "maestro" if marked else "custom"
    else:
        klass = "custom"
sys.stdout.write("%s\t%s\t%s\t%s\n" % (sl_set, ri, klass, cmd))
' "$file" "$cfg"
}

# One tab-separated field from `statusline_read`, without a heredoc (bash 3.2
# cannot parse a heredoc inside a command substitution).
statusline_field() {
  printf '%s\n' "$2" | cut -f"$1"
}

# The managed status-line script: shell, marker, absolute maestro path, 700.
statusline_script_body() {
  local qp
  qp="$(printf '%s' "$SELF" | sed "s/'/'\\\\''/g")"
  printf '#!/bin/sh\n# bottega-managed statusline\np=%s\n[ -x "$p" ] || exit 0\nexec "$p" watch --line\n' "'$qp'"
}

statusline_write_script() {
  local script="$1" tmp="$1.tmp.$$"
  statusline_script_body > "$tmp" || { rm -f "$tmp"; return 1; }
  chmod 700 "$tmp" || { rm -f "$tmp"; return 1; }
  mv "$tmp" "$script"
}

statusline_merge() {
  local settings="$1" plan="$2" script="$3" tmp="$1.tmp.$$"
  if [ -f "$settings" ]; then
    cp -p "$settings" "$settings.bak.$(date +%s)" || return 1
    cp -p "$settings" "$tmp" || { rm -f "$tmp"; return 1; }
  fi
  python3 -c '
import json, sys
path, tmp, plan, script = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
try:
    with open(path) as f:
        data = json.load(f)
except FileNotFoundError:
    data = {}
except (OSError, ValueError):
    sys.exit(1)
if not isinstance(data, dict):
    sys.exit(1)
sl = data.get("statusLine")
if not isinstance(sl, dict):
    sl = {}
if plan == "full":
    sl["type"] = "command"
    sl["command"] = script
    sl["refreshInterval"] = 10
else:
    sl["refreshInterval"] = 10
data["statusLine"] = sl
with open(tmp, "w") as f:
    json.dump(data, f, indent=2)
    f.write("\n")
' "$settings" "$tmp" "$plan" "$script" || { rm -f "$tmp"; return 1; }
  mv "$tmp" "$settings"
}

statusline_install() {
  local yes=0 cfg settings script sr sl="" ri="" klass="" cmd="" plan="" ans=""
  [ "${1:-}" = "--yes" ] && yes=1
  cfg="$(config_dir claude)"
  if [ -z "$cfg" ]; then
    echo 'maestro statusline: cannot find the Claude config dir; set CLAUDE_CONFIG_DIR or HOME' >&2
    return 1
  fi
  settings="$cfg/settings.json"
  script="$cfg/statusline.sh"
  if ! sr="$(statusline_read "$settings")"; then
    echo "statusline: cannot read settings: $settings" >&2
    return 1
  fi
  sl="$(statusline_field 1 "$sr")"; ri="$(statusline_field 2 "$sr")"
  klass="$(statusline_field 3 "$sr")"; cmd="$(statusline_field 4 "$sr")"
  if [ -f "$script" ] && ! grep -qx '# bottega-managed statusline' "$script" \
    && [ "$cmd" != "$script" ]; then
    echo "statusline: $script exists and is not managed by bottega; leaving it alone" >&2
    return 1
  fi
  if [ "$klass" = maestro ] && [ "$ri" != unset ]; then
    echo "statusline: already installed"
    return 0
  fi
  if [ "$klass" = custom ] && [ "$ri" != unset ]; then
    echo "statusline: already configured"
    return 0
  fi
  if [ "$klass" = none ]; then plan="full"; else plan="refresh"; fi
  if [ "$plan" = full ]; then
    printf '{\n  "statusLine": {\n    "type": "command",\n    "command": "%s",\n    "refreshInterval": 10\n  }\n}\n' "$script"
  else
    printf '{\n  "statusLine": {\n    "refreshInterval": 10\n  }\n}\n'
  fi
  if [ "$yes" != 1 ]; then
    printf 'Apply? [y/N] ' >&2
    read -r ans || ans=""
    case "$ans" in
      y|Y|yes|YES) ;;
      *) echo "statusline: nothing written" >&2; return 1 ;;
    esac
  fi
  if [ "$plan" = full ] || [ "$klass" = maestro ]; then
    if [ ! -f "$script" ] || ! grep -qx '# bottega-managed statusline' "$script" \
      || [ "$(cat "$script")" != "$(statusline_script_body)" ]; then
      statusline_write_script "$script" || { echo "statusline: cannot write $script" >&2; return 1; }
    fi
  fi
  statusline_merge "$settings" "$plan" "$script" || { echo "statusline: cannot merge settings" >&2; return 1; }
  echo "statusline: installed" >&2
}

statusline_status() {
  local cfg settings sr sl="" ri="" klass=""
  cfg="$(config_dir claude)"
  if [ -z "$cfg" ]; then
    echo 'maestro statusline: cannot find the Claude config dir; set CLAUDE_CONFIG_DIR or HOME' >&2
    return 1
  fi
  settings="$cfg/settings.json"
  if ! sr="$(statusline_read "$settings")"; then
    echo "settings: unreadable"
    return 1
  fi
  sl="$(statusline_field 1 "$sr")"; ri="$(statusline_field 2 "$sr")"
  klass="$(statusline_field 3 "$sr")"
  printf 'statusLine: %s\n' "$sl"
  if [ "$ri" = unset ]; then
    echo "refreshInterval: unset"
  else
    printf 'refreshInterval: set (%s)\n' "$ri"
  fi
  printf 'command: %s\n' "$klass"
  if [ "$klass" = maestro ]; then
    if [ -x "$SELF" ]; then
      printf 'maestro path: %s (ok)\n' "$SELF"
    else
      printf 'maestro path: %s (missing)\n' "$SELF"
    fi
  fi
}

cmd_statusline() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    install) statusline_install "$@" ;;
    status) statusline_status ;;
    *) echo "usage: maestro statusline install [--yes] | status" >&2; return 1 ;;
  esac
}

cmd_tools() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    install)
      [ "${1:-}" = "--yes" ] && TOOLS_YES=1
      local missing t c
      missing="$(tools_missing)"
      [ -n "$missing" ] || { echo "tools: rtk and gitleaks already installed"; return 0; }
      for t in $missing; do
        c="$(tools_install_cmd "$t")"
        if [ -z "$c" ]; then
          echo "$t: no supported installer found (brew, dnf, apt, go, cargo, curl); install it by hand"
          continue
        fi
        if [ "$c" = "installer" ]; then
          tools_install_rtk_script || { echo "rtk: skipped"; continue; }
        elif tools_ask "Install $t with: $c ?"; then
          sh -c "$c" || { echo "$t: install failed"; continue; }
        else
          echo "$t: skipped"; continue
        fi
        if [ "$t" = rtk ] && command -v rtk >/dev/null 2>&1; then
          if tools_ask "Run 'rtk init -g' to enable rtk in every Claude Code session?"; then rtk init -g; fi
        fi
        command -v "$t" >/dev/null 2>&1 && echo "$t: installed" || echo "$t: installed but not on PATH yet (check ~/.local/bin, ~/go/bin, ~/.cargo/bin)"
      done ;;
    hint)
      # SessionStart hook: one line when a tool is missing, an older maestro
      # copy shadows the plugin, or the status line is not set up. Never writes.
      [ -n "${BOTTEGA_NO_TOOL_HINT:-}" ] && return 0
      local missing warn tools_msg status_msg body cfg sr sl="" ri="" tool_msg
      missing="$(tools_missing)"
      warn="$(maestro_path_warning)"
      tools_msg="$warn"
      if [ -n "$missing" ]; then
        tool_msg="$(printf 'bottega: %s not installed; run maestro tools install (silence: BOTTEGA_NO_TOOL_HINT=1)' "$(echo "$missing" | sed 's/ /, /g')")"
        if [ -n "$tools_msg" ]; then tools_msg="$tools_msg; $tool_msg"; else tools_msg="$tool_msg"; fi
      fi
      status_msg=""
      cfg="$(config_dir claude)"
      if [ -n "$cfg" ] && sr="$(statusline_read "$cfg/settings.json")"; then
        sl="$(statusline_field 1 "$sr")"; ri="$(statusline_field 2 "$sr")"
        if [ "$sl" = unset ] || [ "$ri" = unset ]; then
          status_msg='Status line not set up. Run: maestro statusline install'
        fi
      fi
      [ -n "$tools_msg" ] || [ -n "$status_msg" ] || return 0
      tools_msg="$(printf '%s' "$tools_msg" | sed 's/\\/\\\\/g; s/"/\\"/g')"
      status_msg="$(printf '%s' "$status_msg" | sed 's/\\/\\\\/g; s/"/\\"/g')"
      if [ -n "$tools_msg" ] && [ -n "$status_msg" ]; then
        body="$tools_msg\\n$status_msg"
      elif [ -n "$tools_msg" ]; then
        body="$tools_msg"
      else
        body="$status_msg"
      fi
      printf '{"systemMessage":"%s"}\n' "$body" ;;
    *) echo "usage: maestro tools install [--yes] | hint" >&2; return 1 ;;
  esac
}



# `maestro lab [scenario] [--keep]`: opt-in end-to-end rehearsal. lab/run.sh
# builds a scratch HOME, config, state, and temp dir, stubs the builder, and
# runs the real master on sonnet/low. It never runs from scripts/check,
# scripts/validate.sh, or CI.
cmd_lab() {
  local runner="$ROOT/lab/run.sh"
  if [ ! -f "$runner" ]; then
    echo "maestro lab: missing $runner" >&2
    exit 1
  fi
  exec bash "$runner" "$@"
}

# Parse top-level command and flags.
cmd="${1:-}"
shift || true

# --help/-h anywhere in the arguments is a request for usage, never an action:
# print it and exit 0 before a command can touch files, state, the network, or
# the builder key. The internal commands are invoked by maestro itself and keep
# their own arguments.
case "$cmd" in
  _build-exec|_files) ;;
  *)
    for arg in "$cmd" "$@"; do
      case "$arg" in
        --help|-h) usage; exit 0 ;;
      esac
    done
    ;;
esac

# Version is not a command: handle it before dispatch so it never reports an
# unknown command and never touches run state or the builder.
case "$cmd" in
  --version|-V|version) printf 'maestro %s\n' "$(maestro_version)"; exit 0 ;;
esac

case "$cmd" in
  doctor) cmd_doctor ;;
  init) cmd_init "${1:-$PWD}" ;;
  seed) cmd_seed "$@" ;;
  upgrade) cmd_upgrade "${1:-$PWD}" ;;
  start) cmd_start "$@" ;;
  hold) cmd_hold "$@" ;;
  resume) cmd_resume "$@" ;;
  spec) cmd_spec "$@" ;;
  check) cmd_check "$@" ;;
  gate) cmd_gate "$@" ;;
  verify) cmd_verify "$@" ;;
  log) cmd_log "$@" ;;
  report) cmd_report "$@" ;;
  build) cmd_build "$@" ;;
  watch) cmd_watch "$@" ;;
  lab) cmd_lab "$@" ;;
  guard) cmd_guard "$@" ;;
  _build-exec) cmd_build_exec "$@" ;;
  keyget) cmd_keyget ;;
  _files) maestro_files ;;
  worktree) cmd_worktree "$@" ;;
  hooks) cmd_hooks "$@" ;;
  skills) cmd_skills "$@" ;;
  tools) cmd_tools "$@" ;;
  statusline) cmd_statusline "$@" ;;
  help|--help|-h|"") usage ;;
  *) echo "unknown command: $cmd" >&2; usage; exit 1 ;;
esac
