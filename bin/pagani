#!/usr/bin/env bash
# PaganiStack runtime CLI (the installed copy). Jobs, worktrees, builds, guard
# hooks, project init/upgrade. Install and lint live in bin/pagani-setup, which
# is not installed: `pagani install` and `pagani upgrade --self` fetch it.
set -euo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
STAMP="$(date +%Y%m%d-%H%M%S)"

usage() {
  cat <<'EOF'
Usage:
  pagani install [--uninstall] [--target auto|claude] [--copy|--link] [--dry-run] [--yes]
      (installed copy: fetches the recorded source and runs its installer)
  pagani doctor
  pagani init [path]
  pagani upgrade [path]
  pagani upgrade --self [--from <github-url|tarball-url|git-url|path>]
  pagani build <job> <task> [--revise <findings-file>] [--block|--wait]
  pagani build --init | --check
  pagani build --status <job> [--every <seconds>]
  pagani job new|check|gate|report
  pagani job new "<title>"
  pagani job check <job>
  pagani job gate <job> [--allow-dirty]
  pagani job report [--retro] [--write] [--exit-code]
  pagani worktree create <job> <task>
  pagani worktree prune <job> [--force]
  pagani hooks install|uninstall [path]

Target:
  claude    ~/.claude (CLAUDE_CONFIG_DIR is honored)

Install copies real files (--copy, the default) into ~/.claude, including the
CLI itself under ~/.claude/pagani/, so the clone can be deleted afterwards. Use
--link for development: it symlinks into the clone instead.

Headless builder:
  `pagani build` runs the Claude Code `builder` agent headless on a third-party
  model. Credentials live in ~/.config/pagani/builder.env (create it with
  `pagani build --init`); they are never stored in the repo.

The skills source is organized by category. The installer flattens it to
<target>/skills/<name> because both runtimes discover skills at that depth.
EOF
}

config_dir() {
  case "$1" in
    claude) printf '%s\n' "${CLAUDE_CONFIG_DIR:-$HOME/.claude}" ;;
    *) echo "unknown target: $1" >&2; exit 1 ;;
  esac
}

# Fetch the recorded source into a temp dir; sets FETCH_DIR and FETCH_FROM.
fetch_source() {
  local from="$1" who="$2" tmp tarball=""
  case "$from" in
    *.tar.gz|*.tgz) tarball="$from" ;;
    http://github.com/*|https://github.com/*)
      tarball="${from%.git}"; tarball="${tarball%/}/archive/refs/heads/main.tar.gz" ;;
  esac
  tmp="$(mktemp -d)"
  echo "fetching: $from"
  mkdir -p "$tmp/pagani"
  if [ -n "$tarball" ]; then
    command -v curl >/dev/null 2>&1 && command -v tar >/dev/null 2>&1 || { rm -rf "$tmp"; echo "$who: curl and tar are required" >&2; exit 1; }
    if ! curl -fsSL "$tarball" | tar xz --strip-components=1 -C "$tmp/pagani"; then
      rm -rf "$tmp"
      echo "$who: download failed" >&2
      exit 1
    fi
    [ "$tarball" = "$from" ] || from="$tarball"
  else
    command -v git >/dev/null 2>&1 || { rm -rf "$tmp"; echo "$who: git is required" >&2; exit 1; }
    rm -rf "$tmp/pagani"
    if ! git clone --depth 1 --quiet "$from" "$tmp/pagani"; then
      rm -rf "$tmp"
      echo "$who: clone failed" >&2
      exit 1
    fi
  fi
  [ -f "$tmp/pagani/bin/pagani-setup" ] || { rm -rf "$tmp"; echo "$who: fetched source has no bin/pagani-setup" >&2; exit 1; }
  FETCH_DIR="$tmp"
  FETCH_FROM="$from"
}

# Run the installer from a fetched copy of the recorded source, so it is always
# the new version's installer. Args after the first are passed to `install`.
delegate_setup() {
  local who="$1" from="$2"; shift 2
  if [ -z "$from" ]; then
    local d
    for d in "$ROOT" "$(config_dir claude)/pagani"; do
      [ -f "$d/SOURCE" ] && { from="$(head -1 "$d/SOURCE")"; break; }
    done
  fi
  if [ -z "$from" ]; then
    echo "$who: no source recorded for this installed copy." >&2
    echo "Reinstall with get.sh (curl -fsSL <raw get.sh url> | bash) or from a clone (./install.sh)," >&2
    echo "or pass --from <url-or-path>." >&2
    exit 1
  fi
  fetch_source "$from" "$who"
  local rc=0
  PAGANI_SOURCE="$FETCH_FROM" "$FETCH_DIR/pagani/bin/pagani-setup" install "$@" || rc=$?
  rm -rf "$FETCH_DIR"
  exit "$rc"
}

cmd_install() {
  if [ -x "$ROOT/bin/pagani-setup" ]; then
    exec "$ROOT/bin/pagani-setup" install "$@"
  fi
  delegate_setup "pagani install" "${PAGANI_SOURCE:-}" "$@"
}

cmd_self_upgrade() {
  local from="${PAGANI_SOURCE:-}"
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --from) from="${2:?--from needs a URL or path}"; shift 2 ;;
      *) echo "unknown flag: $1" >&2; exit 1 ;;
    esac
  done
  delegate_setup "pagani upgrade --self" "$from" --yes
}

cmd_job_new() {
  local title="${1:?title required}"
  local repo
  repo="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
  cd "$repo"
  # /pagani is the only command you need: set the project up on first use. init
  # only creates what is missing and everything it creates is excluded from git,
  # so the clean-tree check below is unaffected.
  if [ ! -f AGENTS.md ] || [ ! -x scripts/check ] || [ ! -f .claude/settings.json ]; then
    cmd_init "$repo" | tail -1
  fi
  if [ -n "$(git status --porcelain)" ]; then
    echo "working tree is dirty; commit or stash first" >&2
    exit 1
  fi
  mkdir -p pagani/jobs
  local next=001
  local d
  for d in pagani/jobs/*; do
    [ -d "$d" ] || continue
    local n
    n="$(basename "$d" | cut -d- -f1)"
    if [[ "$n" =~ ^[0-9]+$ ]] && [ "$((10#$n))" -ge "$((10#$next))" ]; then
      next="$(printf '%03d' "$((10#$n + 1))")"
    fi
  done
  local slug id
  slug="$(printf '%s' "$title" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]\+/-/g; s/^-//; s/-$//' | cut -c1-40)"
  id="$next-$slug"
  mkdir "pagani/jobs/$id"
  cat > "pagani/jobs/$id/job.md" <<EOF
# Job $id — $title

Stage: setup
Round: 0
Lane: pending
Lane-reason: pending
Branch: pagani/$id
Base: $(git branch --show-current)
EOF
  git switch -c "pagani/$id" >/dev/null 2>&1 || git checkout -b "pagani/$id" >/dev/null 2>&1 || true
  echo "job: $id"
  echo "folder: pagani/jobs/$id"
  echo "branch: pagani/$id"
}





cmd_check() {
  local job="${1:?job id required}"
  local dir="pagani/jobs/$job"
  [ -d "$dir" ] || { echo "job not found: $job" >&2; exit 1; }
  [ -x scripts/check ] || { echo "scripts/check not found or not executable" >&2; exit 1; }
  local start end duration sha result code output
  start="$(date +%s)"
  set +e
  output="$(./scripts/check 2>&1)"
  code=$?
  set -e
  end="$(date +%s)"
  duration=$((end - start))
  sha="$(git rev-parse HEAD 2>/dev/null || echo unknown)"
  if [ "$code" -eq 0 ]; then result="PASS"; else result="FAIL"; fi
  {
    echo "RESULT: $result"
    echo "HEAD: $sha"
    echo "DATE: $(date -Iseconds)"
    echo "DURATION: ${duration}s"
    echo "EXIT: $code"
    echo
    echo "## Output"
    echo '```'
    echo "$output"
    echo '```'
  } > "$dir/checks.md"
  printf '%s\t%s\t%s\t%s\t%s\n' "$(date -Iseconds)" "$sha" "$result" "$code" "${duration}s" >> "$dir/checks.log"
  echo "check: $result (${duration}s, exit $code)"
  [ "$code" -eq 0 ]
}

cmd_gate() {
  local job="" allow_dirty=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --allow-dirty) allow_dirty=1; shift ;;
      -*) echo "unknown flag: $1" >&2; exit 1 ;;
      *) job="$1"; shift ;;
    esac
  done
  [ -n "$job" ] || { echo "usage: pagani job gate <job> [--allow-dirty]" >&2; exit 1; }

  if [ "$allow_dirty" = "0" ] && git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    local line status path dirty=0
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      status="${line:0:2}"
      path="${line:3}"
      case "$status" in
        '??')
          case "$path" in
            pagani/*|.opencode/*) ;;
            *) dirty=1 ;;
          esac
          ;;
        *) dirty=1 ;;
      esac
      [ "$dirty" = "0" ] || break
    done < <(git status --porcelain)
    if [ "$dirty" = "1" ]; then
      echo "GATE: FAIL (working tree dirty)"
      return 1
    fi
  fi

  local file="pagani/jobs/$job/checks.md"
  [ -f "$file" ] || { echo "GATE: FAIL (no checks.md)"; return 1; }
  local result sha head
  result="$(grep -m1 '^RESULT:' "$file" | sed 's/^RESULT:[[:space:]]*//')"
  sha="$(grep -m1 '^HEAD:' "$file" | sed 's/^HEAD:[[:space:]]*//')"
  head="$(git rev-parse HEAD 2>/dev/null || echo unknown)"
  if [ "$result" != "PASS" ]; then
    echo "GATE: FAIL (checks result: ${result:-missing})"
    return 1
  fi
  if [ "$sha" != "$head" ]; then
    echo "GATE: FAIL (checks stale: $sha != $head)"
    return 1
  fi
  echo "GATE: PASS"
}

cmd_doctor() {
  echo "PaganiStack doctor"
  echo "root: $ROOT"
  if [ -f "$ROOT/bin/pagani-setup" ]; then echo "mode: clone"; else echo "mode: installed copy"; fi
  if builder_ready quiet; then
    echo "headless builder: ready ($(builder_env_file))"
  else
    echo "headless builder: not configured (pagani build --init; Claude builder is the fallback)"
  fi
  command -v claude >/dev/null 2>&1 && echo "claude: yes" || echo "claude: no"
  command -v gh >/dev/null 2>&1 && echo "gh: yes" || echo "gh: no"
  command -v agent-browser >/dev/null 2>&1 && echo "agent-browser: yes" || echo "agent-browser: no (install: npm install -g agent-browser)"
  command -v node >/dev/null 2>&1 && echo "node: yes ($(node --version))" || echo "node: no"
  command -v gitleaks >/dev/null 2>&1 && echo "gitleaks: yes" || echo "gitleaks: no"

  local skills
  if [ ! -f "$ROOT/bin/pagani-setup" ]; then
    [ -d "$(config_dir claude)/skills" ] && echo "claude skills: $(find "$(config_dir claude)/skills" -mindepth 1 -maxdepth 1 | wc -l | tr -d ' ')"
    echo "lint: skipped (installed copy; run from a clone for the full check)"
    return 0
  fi
  skills="$(find "$ROOT/skills" -mindepth 3 -maxdepth 3 -name SKILL.md | wc -l | tr -d ' ')"
  echo "skills: $skills"

  local missing=()
  for s in wizard writing-for-agents codebase-design domain-modeling session-handoff session-retro; do
    if ! find "$ROOT/skills" -mindepth 2 -maxdepth 2 -type d -name "$s" | grep -q .; then
      missing+=("$s")
    fi
  done
  if [ "${#missing[@]}" -gt 0 ]; then
    echo "missing upstream skills: ${missing[*]}"
    echo "install with: npx skills add <owner/repo@skill>"
  else
    echo "upstream skills: present"
  fi

  if [ -f AGENTS.md ]; then
    local lines
    lines="$(wc -l < AGENTS.md | tr -d ' ')"
    echo "AGENTS.md lines: $lines"
    [ "$lines" -gt 200 ] && echo "warning: AGENTS.md is over 200 lines; move detail into skills"
  else
    echo "AGENTS.md: missing (run pagani init)"
  fi

  if [ -d .git ] && git ls-files --error-unmatch .env >/dev/null 2>&1; then
    echo "warning: .env is tracked by git"
  fi

  if [ -f .claude/settings.json ]; then
    echo "project claude settings: yes"
  else
    echo "project claude settings: missing (run pagani init)"
  fi

  local gitdir hook
  gitdir="$(git -C . rev-parse --git-dir 2>/dev/null || true)"
  if [ -n "$gitdir" ]; then
    case "$gitdir" in
      /*) ;;
      *) gitdir="./$gitdir" ;;
    esac
    for hook in pre-commit pre-push; do
      if [ -f "$gitdir/hooks/$hook" ] && grep -q 'pagani-managed' "$gitdir/hooks/$hook"; then
        echo "$hook hook: yes (pagani-managed)"
      else
        echo "$hook hook: no"
      fi
    done
  else
    echo "git hooks: not a git repository"
  fi

  for t in claude; do
    local config
    config="$(config_dir "$t")"
    echo "$t config: $config"
    [ -d "$config" ] && echo "  exists" || echo "  missing"
  done

  "$ROOT/bin/pagani-setup" lint || true
}

# Every path pagani creates in a project. None of them is ever committed: they are
# listed in .git/info/exclude (local, never committed, shared by worktrees) and
# the pre-commit hook rejects staging a new one.
pagani_files() {
  cat <<'LIST'
AGENTS.md
CLAUDE.md
SPEC.md
PLAN.md
ROADMAP.md
TASKS.md
BACKLOG.md
GLOSSARY.md
REVIEW.md
CODING_STANDARDS.md
mistakes.md
scripts/check
scripts/verify
scripts/verify.conf
scripts/format
.claude
pagani
docs/FEATURE-MAP.md
docs/adr/0001-record-architecture-decisions.md
.github/pull_request_template.md
LIST
}

# Write the managed block to the repo's local exclude file. Idempotent. Does not
# touch .gitignore, so the project's tracked files are never modified.
exclude_pagani_files() {
  local dest="$1" common file tmp
  common="$(git -C "$dest" rev-parse --git-common-dir 2>/dev/null)" || {
    echo "note: $dest is not a git repository; nothing excluded"
    return 0
  }
  case "$common" in /*) ;; *) common="$dest/$common" ;; esac
  file="$common/info/exclude"
  mkdir -p "$common/info"
  [ -f "$file" ] || : > "$file"
  tmp="$(mktemp)"
  awk '/^# >>> pagani/{skip=1} !skip{print} /^# <<< pagani/{skip=0}' "$file" > "$tmp"
  {
    echo "# >>> pagani (local only; never committed)"
    pagani_files | sed 's|^|/|'
    echo "# <<< pagani"
  } >> "$tmp"
  if cmp -s "$tmp" "$file"; then rm -f "$tmp"; else mv "$tmp" "$file"; echo "excluded: pagani files ($file)"; fi
}

# Untracked files do not exist in a fresh worktree, so copy the ones the builder
# needs (AGENTS.md, scripts/check, settings, hooks) into it without overwriting.
copy_pagani_files() {
  local from="$1" to="$2" f
  while IFS= read -r f; do
    [ "$f" = "pagani" ] && continue
    [ -e "$from/$f" ] || continue
    [ -e "$to/$f" ] && continue
    mkdir -p "$(dirname "$to/$f")"
    cp -R "$from/$f" "$to/$f"
  done < <(pagani_files)
}

cmd_init() {
  local dest="${1:-$PWD}"
  mkdir -p "$dest/scripts" "$dest/docs/adr" "$dest/.claude" "$dest/pagani/jobs"
  [ -f "$dest/AGENTS.md" ] || cp "$ROOT/resources/AGENTS.md" "$dest/AGENTS.md"
  [ -f "$dest/SPEC.md" ] || cp "$ROOT/resources/SPEC.md" "$dest/SPEC.md"
  [ -f "$dest/PLAN.md" ] || cp "$ROOT/resources/PLAN.md" "$dest/PLAN.md"
  [ -f "$dest/scripts/check" ] || cp "$ROOT/resources/checks.sh" "$dest/scripts/check"
  [ -f "$dest/scripts/verify" ] || cp "$ROOT/resources/verify.sh" "$dest/scripts/verify"
  [ -f "$dest/scripts/verify.conf" ] || cp "$ROOT/resources/verify.conf" "$dest/scripts/verify.conf"
  [ -f "$dest/REVIEW.md" ] || cp "$ROOT/resources/REVIEW.md" "$dest/REVIEW.md"
  [ -f "$dest/GLOSSARY.md" ] || cp "$ROOT/resources/GLOSSARY.md" "$dest/GLOSSARY.md"
  [ -f "$dest/BACKLOG.md" ] || cp "$ROOT/resources/BACKLOG.md" "$dest/BACKLOG.md"
  [ -f "$dest/mistakes.md" ] || cp "$ROOT/resources/mistakes.md" "$dest/mistakes.md"
  [ -f "$dest/CLAUDE.md" ] || printf '@AGENTS.md\n' > "$dest/CLAUDE.md"
  [ -f "$dest/docs/FEATURE-MAP.md" ] || cp "$ROOT/resources/FEATURE-MAP.md" "$dest/docs/FEATURE-MAP.md"
  [ -f "$dest/.claude/settings.json" ] || cp "$ROOT/resources/claude-settings.json" "$dest/.claude/settings.json"
  [ -f "$dest/docs/adr/0001-record-architecture-decisions.md" ] || cp "$ROOT/resources/docs/adr/0001-record-architecture-decisions.md" "$dest/docs/adr/0001-record-architecture-decisions.md"
  chmod +x "$dest/scripts/check" "$dest/scripts/verify"
  exclude_pagani_files "$dest"
  if [ -e "$dest/.git" ]; then
    install_git_hooks "$dest"
  fi
  echo "initialized: $dest"
}

cmd_upgrade() {
  local dest="${1:-$PWD}"
  [ -d "$dest" ] || { echo "pagani upgrade: no such directory: $dest" >&2; exit 1; }
  dest="$(cd "$dest" && pwd)"
  if ! command -v python3 >/dev/null 2>&1; then
    echo "pagani upgrade: python3 is required to merge .claude/settings.json." >&2
    echo "Install python3, then re-run: pagani upgrade $dest" >&2
    exit 1
  fi

  local src_settings="$ROOT/resources/claude-settings.json"
  local src_spec="$ROOT/resources/SPEC.md"
  local src_plan="$ROOT/resources/PLAN.md"

  mkdir -p "$dest/scripts" "$dest/.claude" "$dest/pagani"
  # Retired: the format/PreCompact hook script is gone.
  if [ -f "$dest/scripts/claude-hook.sh" ] && [ ! -L "$dest/scripts/claude-hook.sh" ]; then
    rm -f "$dest/scripts/claude-hook.sh"
    echo "removed: $dest/scripts/claude-hook.sh (retired)"
  fi

  # The headless builder is global now (`pagani build`); drop the old per-project wrapper.
  if [ -f "$dest/scripts/opencode-build" ] && [ ! -L "$dest/scripts/opencode-build" ]; then
    rm -f "$dest/scripts/opencode-build"
    echo "removed: $dest/scripts/opencode-build (replaced by: pagani build)"
  fi

  local target="$dest/.claude/settings.json" tmp
  tmp="$(mktemp)"
  python3 - "$src_settings" "$target" "$tmp" <<'PY'
import json, sys
src_path, target_path, out_path = sys.argv[1:4]
with open(src_path) as f:
    src = json.load(f)
try:
    with open(target_path) as f:
        target = json.load(f)
except Exception:
    target = {}
if not isinstance(target, dict):
    target = {}
for k, v in src.items():
    if k != "hooks" and k not in target:
        target[k] = v
# Drop the retired pagani hooks (claude-hook.sh); keep any other hooks.
kept = {}
for event, entries in (target.get("hooks") or {}).items():
    rows = [e for e in entries if "claude-hook.sh" not in json.dumps(e)]
    if rows:
        kept[event] = rows
if kept:
    target["hooks"] = kept
else:
    target.pop("hooks", None)
with open(out_path, "w") as f:
    json.dump(target, f, indent=2)
    f.write("\n")
PY
  if [ -f "$target" ] && cmp -s "$tmp" "$target"; then
    rm -f "$tmp"
    echo "unchanged: $target"
  else
    if [ -f "$target" ]; then
      cp "$target" "$target.pagani-backup-$STAMP"
      echo "backup: $target -> $target.pagani-backup-$STAMP"
    fi
    mv "$tmp" "$target"
    echo "updated: $target"
  fi

  exclude_pagani_files "$dest"

  if [ -e "$dest/.git" ]; then
    install_git_hooks "$dest"
  fi

  if [ -f "$dest/SPEC.md" ]; then
    echo "kept: $dest/SPEC.md"
  else
    cp "$src_spec" "$dest/SPEC.md"
    echo "created: $dest/SPEC.md"
  fi

  if [ -f "$dest/PLAN.md" ] || [ -f "$dest/ROADMAP.md" ]; then
    echo "kept: plan file in $dest"
  else
    cp "$src_plan" "$dest/PLAN.md"
    echo "created: $dest/PLAN.md"
  fi
}

# ---- Headless builder -------------------------------------------------------
# `pagani build` runs the Claude Code `builder` agent headless (claude -p) on a
# third-party model. Claude drives; the builder only implements and reports.
# Credentials come from per-machine files, never from the repo.

builder_env_file() {
  printf '%s\n' "${PAGANI_BUILDER_ENV:-${XDG_CONFIG_HOME:-$HOME/.config}/pagani/builder.env}"
}

# The key lives in its own mode-600 file and reaches claude through apiKeyHelper
# (`pagani keyget`), so it is never in the builder's environment or argv. An
# ANTHROPIC_AUTH_TOKEN line in builder.env still works as a fallback.
builder_key_file() {
  printf '%s\n' "${PAGANI_BUILDER_KEY:-${XDG_CONFIG_HOME:-$HOME/.config}/pagani/builder.key}"
}

cmd_keyget() {
  local f
  f="$(builder_key_file)"
  [ -s "$f" ] || exit 1
  tr -d '\r\n ' < "$f"
}

# Succeeds when the headless builder can run. Prints why not on stderr unless
# quiet. Never prints values from the env or key file.
builder_ready() {
  local quiet="${1:-}" file var missing=""
  say() { [ "$quiet" = "quiet" ] || echo "$1" >&2; }
  file="$(builder_env_file)"
  has_value() { grep -Eq "^(export[[:space:]]+)?($1)=([^[:space:]\"']|[\"'][^\"']+[\"'])" "$file"; }
  command -v claude >/dev/null 2>&1 || { say "builder: claude is not installed"; return 1; }
  command -v python3 >/dev/null 2>&1 || { say "builder: python3 is required"; return 1; }
  [ -f "$file" ] || { say "builder: not configured (run: pagani build --init)"; return 1; }
  for var in ANTHROPIC_BASE_URL ANTHROPIC_MODEL; do
    has_value "$var" || missing="$missing $var"
  done
  if [ ! -s "$(builder_key_file)" ] && ! has_value "ANTHROPIC_AUTH_TOKEN|ANTHROPIC_API_KEY"; then
    missing="$missing key($(builder_key_file))"
  fi
  if [ -n "$missing" ]; then
    say "builder: $file is missing a value for:$missing"
    return 1
  fi
  return 0
}

builder_init() {
  local file example keyfile k=""
  file="$(builder_env_file)"
  keyfile="$(builder_key_file)"
  example="$ROOT/resources/builder.env.example"
  [ -f "$example" ] || { echo "pagani build --init: $example not found" >&2; exit 1; }
  mkdir -p "$(dirname "$file")"
  if [ -f "$file" ]; then
    echo "exists: $file"
  else
    (umask 077 && cp "$example" "$file")
    chmod 600 "$file"
    echo "created: $file"
  fi
  if [ -s "$keyfile" ]; then
    echo "exists: $keyfile"
  else
    if [ -t 0 ]; then
      read -rsp "OpenCode Go API key (hidden; Enter to skip): " k || true
      echo
    else
      read -r k || true
    fi
    if [ -n "$k" ]; then
      (umask 077 && printf '%s\n' "$k" > "$keyfile")
      chmod 600 "$keyfile"
      echo "created: $keyfile"
    else
      echo "skipped: no key entered. Add it later: write it to $keyfile (mode 600)."
    fi
  fi
  echo "Then check with: pagani build --check"
}

# pagani build <job> <task> [--revise <findings>] [--block | --wait]
#   default  wait up to PAGANI_BUILD_WAIT seconds (540), then print RUNNING, exit 5
#   --wait   attach to a running build, same bounded wait
#   --block  wait until the build ends; for a background Bash task. The builder
#            itself is capped by PAGANI_BUILD_TIMEOUT (default 1800 s = 30 min).
# One status line for a job: done/running/queued counts plus running tasks.
build_status_line() {
  local jobdir="$1" bdir="$1/build" n=0 d=0 r=0 q t f sl="" last
  local -A seen=()
  if [ -f "$jobdir/SPEC.md" ]; then
    n="$(grep -cE '^#{2,4} +Task\b' "$jobdir/SPEC.md" || true)"
  fi
  for f in "$bdir"/*.run "$bdir"/*.md "$bdir"/*.progress; do
    [ -e "$f" ] || continue
    t="$(basename "$f")"; t="${t%.*}"
    seen[$t]=1
  done
  [ "$n" -gt 0 ] || n="${#seen[@]}"
  for t in "${!seen[@]}"; do
    if [ -f "$bdir/$t.md" ] && grep -q 'STATUS: DONE' "$bdir/$t.md"; then
      d=$((d + 1))
    elif [ -f "$bdir/$t.run" ] && [ ! -f "$bdir/$t.rc" ]; then
      r=$((r + 1))
      last="$(tail -n 1 "$bdir/$t.progress" 2>/dev/null | cut -c1-60 || true)"
      sl="$sl │ $t: $(wc -l < "$bdir/$t.progress" 2>/dev/null | tr -d ' ' || echo 0) steps, last ${last:--}"
    fi
  done
  q=$((n - d - r)); [ "$q" -ge 0 ] || q=0
  echo "Builders $d/$n done · $r running · $q queued$sl"
  BUILD_STATUS_D=$d; BUILD_STATUS_R=$r; BUILD_STATUS_N=$n
}

build_status() {
  local job="" every="" repo jobdir line now last_print=0 idle=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --every)
        case "${2:-}" in
          ''|*[!0-9]*) every="${PAGANI_STATUS_EVERY:-180}"; shift ;;
          *) every="$2"; shift 2 ;;
        esac ;;
      *) job="$1"; shift ;;
    esac
  done
  [ -n "$job" ] || { echo "usage: pagani build --status <job> [--every <seconds>]" >&2; exit 2; }
  repo="$(git rev-parse --show-toplevel)"
  jobdir="$repo/pagani/jobs/$job"
  [ -d "$jobdir" ] || { echo "no such job: $job" >&2; exit 2; }
  if [ -z "${every:-}" ]; then build_status_line "$jobdir"; return 0; fi
  case "$every" in ''|*[!0-9]*) echo "--every needs a number of seconds" >&2; exit 2 ;; esac
  local pd="" pr=""
  while :; do
    line="$(build_status_line "$jobdir")"
    BUILD_STATUS_D="${line#Builders }"; BUILD_STATUS_D="${BUILD_STATUS_D%%/*}"
    now="$(date +%s)"
    local cur_r="${line#*done · }"; cur_r="${cur_r%% running*}"
    local cur_n="${line#*/}"; cur_n="${cur_n%% done*}"
    if [ -z "$pd" ] || [ "$BUILD_STATUS_D" != "$pd" ] || [ "$cur_r" != "$pr" ] || [ $((now - last_print)) -ge "$every" ]; then
      if [ -n "$pd" ] && [ "$BUILD_STATUS_D" = "$pd" ] && [ "$cur_r" = "$pr" ]; then idle=$((idle + 1)); else idle=0; fi
      echo "$line"
      last_print=$now; pd="$BUILD_STATUS_D"; pr="$cur_r"
      [ "$cur_n" -gt 0 ] && [ "$BUILD_STATUS_D" -ge "$cur_n" ] && return 0
      [ "$cur_r" = 0 ] && [ "$idle" -ge 3 ] && return 0
    fi
    sleep 5
  done
}

cmd_build() {
  case "${1:-}" in
    --status) shift; build_status "$@"; return ;;
    --init) builder_init; return ;;
    --check)
      if builder_ready; then echo "builder: ready ($(builder_env_file))"; else exit 1; fi
      return
      ;;
  esac

  local usage="usage: pagani build <job> <task> [--revise <findings-file>] [--block|--wait] | --init | --check | --status <job> [--every <seconds>]"
  [ "$#" -ge 2 ] || { echo "$usage" >&2; exit 2; }
  local job="$1" task="$2" findings="" block=0
  shift 2
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --revise) findings="${2:?findings file required}"; shift 2 ;;
      --wait) shift ;;
      --block) block=1; shift ;;
      *) echo "$usage" >&2; exit 2 ;;
    esac
  done

  builder_ready || exit 3
  local envfile repo name jobdir wt max_rev=2
  envfile="$(builder_env_file)"
  repo="$(git rev-parse --show-toplevel)"
  name="$(basename "$repo")"
  jobdir="$repo/pagani/jobs/$job"
  wt="$(cd "$repo/.." && pwd)/$name-pagani/$job/$task"
  local report="$jobdir/build/$task.md"
  local wt_report="$wt/pagani/jobs/$job/build/$task.md"
  local state="$jobdir/build/$task.builder"
  local log="$jobdir/build/$task.builder.log"
  local run="$jobdir/build/$task.run" rcfile="$jobdir/build/$task.rc"
  local progress="$jobdir/build/$task.progress" profile="$jobdir/build/$task.settings.json"

  [ -d "$jobdir" ] || { echo "pagani build: no job folder $jobdir" >&2; exit 3; }
  [ -f "$jobdir/SPEC.md" ] || { echo "pagani build: $jobdir/SPEC.md missing" >&2; exit 3; }
  [ -d "$wt" ] || { echo "pagani build: no worktree $wt (run: pagani worktree create $job $task)" >&2; exit 3; }
  mkdir -p "$jobdir/build" "$wt/pagani/jobs/$job/build"
  local branch rev=0 sid=""
  branch="$(git -C "$wt" branch --show-current)"

  if [ -f "$run" ]; then
    # A build for this task is running or finished but not collected: attach.
    rev="$(sed -n 's/^rev=//p' "$run")"; rev="${rev:-0}"
    sid="$(sed -n 's/^sid=//p' "$run")"
    if [ ! -f "$rcfile" ] && [ -n "$(find "$run" -mmin +360 2>/dev/null)" ]; then
      echo 1 > "$rcfile"   # stale: the builder died without writing a result
    fi
  else
    # pagani/jobs is gitignored, so the worktree has no job folder: mirror the
    # job inputs in so the builder never reads or writes outside its worktree.
    local f msg
    for f in SPEC.md job.md interview.md; do
      [ -f "$jobdir/$f" ] && cp "$jobdir/$f" "$wt/pagani/jobs/$job/$f"
    done
    if [ -n "$findings" ]; then
      [ -f "$findings" ] || { echo "pagani build: findings file not found: $findings" >&2; exit 3; }
      cp "$findings" "$wt/pagani/jobs/$job/build/$task.findings.md"
      [ -f "$state" ] || { echo "pagani build: no session for $task; run a first build" >&2; exit 3; }
      sid="$(sed -n 's/^session=//p' "$state")"
      rev="$(sed -n 's/^revisions=//p' "$state")"; rev="${rev:-0}"
      if [ "$rev" -ge "$max_rev" ]; then
        echo "pagani build: $max_rev revisions used; escalate to the human (workflow rule: max two fix rounds)" >&2
        exit 4
      fi
      rev=$((rev + 1))
      msg="Revision $rev for task $task. Fix every finding in pagani/jobs/$job/build/$task.findings.md (read it first), nothing else. Same rules as before: stay inside Allowed files, do not edit or weaken tests, commit locally on $branch, never push or merge. Update the report $wt_report and keep its format."
    else
      msg="Job folder: pagani/jobs/$job (inside the worktree)
Task: $task
Worktree: $wt
Everything stays inside the worktree. The job spec is pagani/jobs/$job/SPEC.md, not the project SPEC.md at the root.
Branch: $branch
Implement exactly this task from pagani/jobs/$job/SPEC.md. Follow your builder instructions. Write the report to $wt_report (inside the worktree; it is gitignored, do not commit it). Commit locally on $branch. Never push or merge."
    fi
    printf '%s' "$msg" > "$jobdir/build/$task.prompt"
    rm -f "$rcfile"
    : > "$progress"
    printf 'rev=%s\nsid=%s\n' "$rev" "$sid" > "$run"
    # Detached (own session): a timeout or kill of the caller cannot stop the builder.
    setsid "$SELF" _build-exec "$wt" "$envfile" "$jobdir/build/$task.prompt" "$log" "$rcfile" "$progress" "$profile" "$sid" \
      </dev/null >/dev/null 2>&1 &
  fi

  # Bounded wait for a foreground caller; --block waits for the builder's own
  # timeout (plus a minute) so a background task ends when the build ends.
  local limit="${PAGANI_BUILD_WAIT:-540}" waited=0
  [ "$block" = "1" ] && limit=$(( ${PAGANI_BUILD_TIMEOUT:-1800} + 60 ))
  while [ ! -f "$rcfile" ] && [ "$waited" -lt "$limit" ]; do
    sleep 2
    waited=$((waited + 2))
  done
  if [ ! -f "$rcfile" ]; then
    echo "RUNNING task: $task (still building; call again: pagani build $job $task --wait)"
    echo "steps so far: $(wc -l < "$progress" 2>/dev/null | tr -d ' ')"
    [ -s "$progress" ] && echo "last step: $(tail -1 "$progress")"
    echo "progress: $progress"
    exit 5
  fi

  local rc
  rc="$(cat "$rcfile")"
  rm -f "$rcfile" "$run"
  if [ -s "$wt_report" ]; then cp "$wt_report" "$report"; fi
  if [ -z "$sid" ]; then
    sid="$(grep -o '"session_id":"[^"]*"' "$log" | head -1 | cut -d'"' -f4 || true)"
  fi
  [ -n "$sid" ] && printf 'session=%s\nrevisions=%s\nagent=builder\n' "$sid" "$rev" > "$state"

  local status="MISSING" commits cost
  [ -s "$report" ] && status="$(grep -m1 -o 'STATUS: [A-Z_]*' "$report" || echo UNKNOWN)"
  commits="$(git -C "$wt" log --oneline "pagani/$job..HEAD" 2>/dev/null | wc -l | tr -d ' ')"
  cost="$(grep -o '"total_cost_usd":[0-9.]*' "$log" | tail -1 | cut -d: -f2 || true)"

  echo "task: $task"
  echo "session: ${sid:-none}"
  echo "revisions: $rev/$max_rev"
  echo "builder exit: $rc$([ "$rc" = 124 ] && echo " (timed out)")"
  [ -n "$cost" ] && echo "cost (estimate): \$$cost"
  echo "report: $report ($status)"
  echo "commits on $branch: $commits"
  echo "files changed:"; git -C "$wt" diff --name-only "pagani/$job...HEAD" 2>/dev/null | sed 's/^/  /'
  [ "$rc" -eq 0 ] && [ "$status" != "MISSING" ] || exit 1
}

# Internal: run the headless builder and record its exit code. Started detached
# by cmd_build. A per-run settings profile (--settings outranks user and project
# settings) pins the endpoint and models and, when builder.key exists, an
# apiKeyHelper, with the auth env vars blanked so no settings `env` block can
# inject a credential. builder.env is sourced in a subshell only; nothing is
# echoed. Stream events are logged and summarised into the progress file.
cmd_build_exec() {
  local wt="$1" envfile="$2" promptfile="$3" log="$4" rcfile="$5" progress="$6" profile="$7" sid="${8:-}" rc helper=""
  local -a resume=()
  [ -n "$sid" ] && resume=(--resume "$sid")
  [ -s "$(builder_key_file)" ] && helper="\"$SELF\" keyget"
  trap 'echo 143 > "$rcfile"; exit 143' TERM HUP
  set +e
  (
    unset ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN CLAUDE_CODE_OAUTH_TOKEN
    set -a; . "$envfile"; set +a
    python3 - "$profile" "$helper" <<'PY'
import json, os, sys
path, helper = sys.argv[1:3]
names = ("ANTHROPIC_BASE_URL", "ANTHROPIC_MODEL", "ANTHROPIC_DEFAULT_OPUS_MODEL",
         "ANTHROPIC_DEFAULT_SONNET_MODEL", "ANTHROPIC_DEFAULT_HAIKU_MODEL",
         "CLAUDE_CODE_SUBAGENT_MODEL")
env = {k: os.environ[k] for k in names if os.environ.get(k)}
env["CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC"] = "1"
prof = {"env": env}
if helper:
    prof["apiKeyHelper"] = helper
    env["ANTHROPIC_AUTH_TOKEN"] = ""
    env["ANTHROPIC_API_KEY"] = ""
with open(path, "w") as f:
    json.dump(prof, f)
PY
    export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
    cd "$wt" && timeout "${PAGANI_BUILD_TIMEOUT:-1800}" claude -p "$(cat "$promptfile")" --agent builder \
      --output-format stream-json --verbose \
      "${resume[@]}" \
      --settings "$profile" \
      --permission-mode acceptEdits \
      --max-budget-usd "${PAGANI_BUILD_BUDGET:-10}" \
      --tools "Bash,Edit,Glob,Grep,Read,Skill,Write,TodoWrite" --strict-mcp-config \
      --allowedTools "Read,Grep,Glob,Edit,Write,Bash,Skill,TodoWrite" \
      --disallowedTools "Bash(git push:*),Bash(git merge:*),Bash(git reset --hard:*),Bash(git clean:*),Bash(sudo:*),Bash(rm -rf:*),Bash(gh:*)"
  ) 2>&1 | tee "$log" | python3 -c '
import json, sys
out = open(sys.argv[1], "a")
for line in sys.stdin:
    try:
        ev = json.loads(line)
    except Exception:
        continue
    if ev.get("type") != "assistant":
        continue
    for b in (ev.get("message") or {}).get("content") or []:
        if isinstance(b, dict) and b.get("type") == "tool_use":
            i = b.get("input") or {}
            arg = i.get("file_path") or i.get("command") or i.get("pattern") or i.get("path") or ""
            out.write("%s: %s\n" % (b.get("name"), str(arg).replace("\n", " ")[:100]))
            out.flush()
' "$progress" >/dev/null
  rc=${PIPESTATUS[0]}
  echo "$rc" > "$rcfile"
}

# Hooks used by the /pagani command (frontmatter, so they only apply while
# /pagani runs).
#   guard builder  PreToolUse: deny the Claude-model builder when the headless
#                  builder is configured; allow it otherwise (fallback).
#   guard stop     Stop: do not let the master end its turn between steps. It
#                  blocks only while a job is mid-pipeline with nothing running.
cmd_guard() {
  case "${1:-}" in
    builder) guard_builder ;;
    stop) guard_stop ;;
    *) echo "usage: pagani guard builder|stop" >&2; exit 2 ;;
  esac
}

guard_builder() {
  local input kind
  input="$(cat)"
  kind="$(printf '%s' "$input" | tr -d '\n' | sed -n 's/.*"subagent_type"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')"
  [ "$kind" = "builder" ] || exit 0
  builder_ready quiet || exit 0
  printf '%s\n' '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"The headless builder is configured. Do not spawn the Claude-model builder: create the worktree with `pagani worktree create <job> <task>`, then run `pagani build <job> <task> --block` as a background Bash task (see Step 2)."}}'
}

# Pipeline stages the master writes to job.md. Only these are "mid-pipeline":
# the master must keep going. awaiting-spec, awaiting-decision, and closed are
# human checkpoints or the end.
guard_stop() {
  local input job stage dir r
  input="$(cat)"
  printf '%s' "$input" | tr -d '\n' | grep -Eq '"stop_hook_active"[[:space:]]*:[[:space:]]*true' && exit 0
  job="$(ls -t pagani/jobs/*/job.md 2>/dev/null | head -1 || true)"
  [ -n "$job" ] || exit 0
  stage="$(grep -m1 '^Stage:' "$job" | sed 's/^Stage:[[:space:]]*//' | tr -d '[:space:]')"
  case "$stage" in build|checks|review|fix) ;; *) exit 0 ;; esac
  dir="$(dirname "$job")"
  for r in "$dir"/build/*.run; do
    [ -f "$r" ] || continue
    [ -f "${r%.run}.rc" ] && continue
    # a builder is still running: idle is correct (a .run older than 360 min is stale)
    [ -n "$(find "$r" -mmin +360 2>/dev/null)" ] || exit 0
  done
  # other legitimate async work (background checks, builders without a .run file)
  if command -v pgrep >/dev/null 2>&1 && pgrep -f '_build-exec|pagani job check|scripts/check' >/dev/null 2>&1; then
    exit 0
  fi
  printf '%s\n' "{\"decision\":\"block\",\"reason\":\"Job $(basename "$dir") is at Stage: $stage and no human checkpoint or running builder is pending. Continue to the next step now; do not stop and do not ask the user to proceed. If you are truly blocked, set Stage to awaiting-decision and ask with AskUserQuestion.\"}"
}

cmd_worktree() {
  local action="${1:-}"
  case "$action" in
    create)
      local job="${2:?job id required}" task="${3:?task required}"
      local repo name base
      repo="$(git rev-parse --show-toplevel)"
      name="$(basename "$repo")"
      base="$(git branch --show-current)"
      git worktree add -b "pagani/$job-$task" "../$name-pagani/$job/$task" "pagani/$job" 2>/dev/null \
        || git worktree add -b "pagani/$job-$task" "../$name-pagani/$job/$task" "$base"
      local path="../$name-pagani/$job/$task"
      copy_pagani_files "$repo" "$repo/$path"
      local port=$((5100 + ($(printf '%s' "$path" | cksum | awk '{print $1}') % 400)))
      echo "worktree: $path"
      echo "port: $port"
      ;;
    prune)
      local job="" force=0
      shift || true
      while [ "$#" -gt 0 ]; do
        case "$1" in
          --force) force=1; shift ;;
          -*) echo "unknown flag: $1" >&2; exit 1 ;;
          *) job="$1"; shift ;;
        esac
      done
      [ -n "$job" ] || { echo "usage: pagani worktree prune <job> [--force]" >&2; exit 1; }
      local repo name root wt
      repo="$(git rev-parse --show-toplevel)"
      name="$(basename "$repo")"
      root="../$name-pagani/$job"
      if [ -d "$root" ]; then
        for wt in "$root"/*; do
          [ -d "$wt" ] || continue
          if [ "$force" = "1" ]; then
            if git worktree remove --force "$wt" 2>/dev/null; then
              echo "removed: $wt"
            else
              echo "failed: $wt (uncommitted changes; use --force)"
            fi
          else
            if git worktree remove "$wt" 2>/dev/null; then
              echo "removed: $wt"
            else
              echo "failed: $wt (uncommitted changes; use --force)"
            fi
          fi
        done
      else
        echo "no worktrees for $job"
      fi
      ;;
    *)
      echo "usage: pagani worktree create <job> <task> | prune <job> [--force]" >&2
      exit 1
      ;;
  esac
}

cmd_report() {
  local retro=0
  local -a retro_args=()
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --retro) retro=1; shift ;;
      --write) retro=1; retro_args+=(--write); shift ;;
      --exit-code) retro=1; retro_args+=(--exit-code); shift ;;
      -*) echo "unknown flag: $1" >&2; exit 1 ;;
      *) echo "unknown argument: $1" >&2; exit 1 ;;
    esac
  done
  if [ "$retro" = "1" ]; then
    cmd_retro_scan "${retro_args[@]}"
    return
  fi
  cmd_status
}

cmd_job() {
  local action="${1:-}"
  [ -n "$action" ] || { echo "usage: pagani job new|check|gate|report"; exit 0; }
  shift || true
  case "$action" in
    new) cmd_job_new "$@" ;;
    check) cmd_check "$@" ;;
    gate) cmd_gate "$@" ;;
    report) cmd_report "$@" ;;
    *) echo "usage: pagani job new|check|gate|report" >&2; exit 1 ;;
  esac
}

cmd_status() {
  local found=0
  for job in pagani/jobs/*/job.md; do
    [ -f "$job" ] || continue
    found=1
    local id stage round lane
    id="$(basename "$(dirname "$job")")"
    stage="$(grep -m1 '^Stage:' "$job" | sed 's/^Stage:[[:space:]]*//')"
    round="$(grep -m1 '^Round:' "$job" | sed 's/^Round:[[:space:]]*//')"
    lane="$(grep -m1 '^Lane:' "$job" | sed 's/^Lane:[[:space:]]*//')"
    printf '%-32s lane=%-10s stage=%-12s round=%s\n' "$id" "${lane:-?}" "${stage:-?}" "${round:-0}"
  done
  [ "$found" = "1" ] || echo "no jobs"
}


git_dir_for() {
  local repo="$1" gitdir
  [ -d "$repo" ] || { echo "pagani hooks: no such directory: $repo" >&2; exit 1; }
  repo="$(cd "$repo" && pwd)"
  if ! gitdir="$(git -C "$repo" rev-parse --git-dir 2>/dev/null)"; then
    echo "pagani hooks: not a git repository: $repo" >&2
    exit 1
  fi
  case "$gitdir" in
    /*) ;;
    *) gitdir="$repo/$gitdir" ;;
  esac
  printf '%s\n' "$gitdir"
}

install_git_hooks() {
  local repo="$1" gitdir hooks
  gitdir="$(git_dir_for "$repo")"
  hooks="$gitdir/hooks"
  mkdir -p "$hooks"
  local hook src dest
  for hook in pre-commit pre-push; do
    src="$ROOT/resources/git-hooks/$hook"
    dest="$hooks/$hook"
    if [ -e "$dest" ] && ! grep -q 'pagani-managed' "$dest" 2>/dev/null; then
      cp -p "$dest" "$dest.pagani-backup-$STAMP"
      echo "backup: $dest -> $dest.pagani-backup-$STAMP"
    fi
    cp "$src" "$dest"
    chmod +x "$dest"
    echo "installed: $dest"
  done
}

uninstall_git_hooks() {
  local repo="$1" gitdir hooks
  gitdir="$(git_dir_for "$repo")"
  hooks="$gitdir/hooks"
  local hook dest
  for hook in pre-commit pre-push; do
    dest="$hooks/$hook"
    if [ -f "$dest" ] && grep -q 'pagani-managed' "$dest" 2>/dev/null; then
      rm -f "$dest"
      echo "removed: $dest"
    else
      echo "skipped: $dest (not pagani-managed)"
    fi
  done
}


cmd_hooks() {
  local action="${1:-}" path="${2:-$PWD}"
  case "$action" in
    install) install_git_hooks "$path" ;;
    uninstall) uninstall_git_hooks "$path" ;;
    *)
      echo "usage: pagani hooks install|uninstall [path]" >&2
      exit 1
      ;;
  esac
}

retro_title() {
  local line="$1"
  line="$(printf '%s\n' "$line" \
    | sed -E 's/^(##|###) //; s/^PROBLEM: //; s/^- PROBLEM: //' \
    | sed -E 's/[[:space:]]*→.*$//' \
    | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')"
  printf '%s\n' "$line"
}

retro_generic() {
  case "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" in
    summary|findings|notes|evidence|verdict|blocking|non-blocking|what|why|how|where|output|tests|test|decision)
      return 0 ;;
    *) return 1 ;;
  esac
}

cmd_retro_scan() {
  local write=0 exit_code=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --write) write=1; shift ;;
      --exit-code) exit_code=1; shift ;;
      *) echo "unknown flag: $1" >&2; exit 1 ;;
    esac
  done

  local -A job_count=() files_for=() seen=()
  local file rel job raw title key
  shopt -s nullglob
  local files=(pagani/jobs/*/round-*/review-code.md)
  shopt -u nullglob
  for file in "${files[@]}"; do
    [ -f "$file" ] || continue
    rel="${file#pagani/jobs/}"
    job="${rel%%/*}"
    while IFS= read -r raw; do
      [ -n "$raw" ] || continue
      title="$(retro_title "$raw")"
      [ -n "$title" ] || continue
      retro_generic "$title" && continue
      key="$title"$'\t'"$job"
      [ -n "${seen[$key]:-}" ] && continue
      seen[$key]=1
      job_count[$title]=$(( ${job_count[$title]:-0} + 1 ))
      files_for[$title]+="$file"$'\n'
    done < <(grep -E '^(##|###) |^PROBLEM: |^- PROBLEM: ' "$file" 2>/dev/null || true)
  done

  local repeats=0
  local -a report=()
  if [ "${#job_count[@]}" -gt 0 ]; then
    while IFS= read -r title; do
      [ -n "$title" ] || continue
      [ "${job_count[$title]}" -ge 2 ] || continue
      repeats=1
      report+=("${job_count[$title]} jobs: $title")
      local shown=0 f
      while IFS= read -r f; do
        [ -n "$f" ] || continue
        [ "$shown" -lt 3 ] || break
        report+=("  $f")
        shown=$((shown + 1))
      done <<< "${files_for[$title]}"
    done < <(printf '%s\n' "${!job_count[@]}" | sort)
  fi

  if [ "$repeats" = "0" ]; then
    echo "retro-scan: no repeated findings"
    report=("retro-scan: no repeated findings")
  else
    printf '%s\n' "${report[@]}"
  fi

  if [ "$write" = "1" ]; then
    mkdir -p pagani
    {
      echo "# Retro scan"
      echo
      echo "Generated: $(date -Iseconds)"
      echo
      printf '%s\n' "${report[@]}"
    } > pagani/retro-scan.md
    echo "wrote: pagani/retro-scan.md"
  fi

  if [ "$exit_code" = "1" ] && [ "$repeats" = "1" ]; then
    return 1
  fi
  return 0
}




# Parse top-level command and flags.
cmd="${1:-}"
shift || true
case "$cmd" in
  install) cmd_install "$@" ;;
  doctor) cmd_doctor ;;
  init) cmd_init "${1:-$PWD}" ;;
  upgrade)
    if [ "${1:-}" = "--self" ]; then shift; cmd_self_upgrade "$@"; else cmd_upgrade "${1:-$PWD}"; fi
    ;;
  build) cmd_build "$@" ;;
  guard) cmd_guard "$@" ;;
  _build-exec) cmd_build_exec "$@" ;;
  keyget) cmd_keyget ;;
  _files) pagani_files ;;
  job) cmd_job "$@" ;;
  worktree) cmd_worktree "$@" ;;
  hooks) cmd_hooks "$@" ;;
  help|--help|-h|"") usage ;;
  *) echo "unknown command: $cmd" >&2; usage; exit 1 ;;
esac
