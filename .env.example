# Copy to .env (secret) and .env.local (non-secret) and fill in. Never commit real values.

# --- .env (secret) ---
# OpenCode Go API key used by the DeepSeek builder session.
OPENCODE_API_KEY=

# --- .env.local (non-secret) ---
PAGANI_BUILDER_BASE_URL=https://opencode.ai/inference/go/anthropic
PAGANI_BUILDER_MODEL=deepseek-v4.1-flash
# Name of the variable in .env that holds the key.
PAGANI_BUILDER_KEY_VAR=OPENCODE_API_KEY
# Max parallel builders.
PAGANI_BUILDER_MAX_PARALLEL=2
