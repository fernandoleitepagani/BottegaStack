#!/usr/bin/env bash
# Deterministic CLI wrapper for Bottega. Collapses multi-turn verification and
# ledger boilerplate into single calls with compact stdout (raw logs go to
# .bottega/last-verify.log). Bash 3.2 compatible, no jq.
#
# Usage:
#   bottega start "<goal>" [--risk normal|high] --condition "<c>" [...]
#   bottega verify --check "<cmd>" [--check ...] [gate-check.sh args...]
#   bottega log <logfile> <phase> <decision> <why> <evidence> <result>
#   bottega ship --draft|--ready --title "<title>" --body "<body>"
#   bottega worktree audit [worktree-audit.sh args...]
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd -P)"
GATE="$SCRIPT_DIR/gate-check.sh"
LOG="$SCRIPT_DIR/log.sh"
WT_AUDIT="$SCRIPT_DIR/worktree-audit.sh"

usage() {
	sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'
	exit "${1:-0}"
}

cmd_start() {
	[ $# -ge 1 ] || { echo "error: bottega start needs a goal and at least one --condition" >&2; exit 2; }
	"$GATE" --start "$@"
	mkdir -p .bottega
	[ -e .bottega/.gitignore ] || printf '*\n' > .bottega/.gitignore
}

cmd_verify() {
	local checks=()
	local gate_args=()
	while [ $# -gt 0 ]; do
		case "$1" in
		--check)
			[ $# -ge 2 ] || { echo "error: --check needs a command" >&2; exit 2; }
			checks+=("$2"); shift 2 ;;
		*)
			gate_args+=("$1"); shift ;;
		esac
	done

	if [ "${#checks[@]}" -eq 0 ]; then
		echo "error: bottega verify needs at least one --check (the repo's test, lint or typecheck command)" >&2
		exit 2
	fi

	mkdir -p .bottega
	[ -e .bottega/.gitignore ] || printf '*\n' > .bottega/.gitignore
	local logfile=".bottega/last-verify.log"
	: > "$logfile"

	local failed=0
	if [ "${#checks[@]}" -gt 0 ]; then
		local c start_line
		for c in "${checks[@]}"; do
			printf '=== %s ===\n' "$c" >> "$logfile"
			start_line=$(( $(wc -l < "$logfile" | tr -d ' ') + 1 ))
			if PYTHONDONTWRITEBYTECODE=1 bash -c "$c" >> "$logfile" 2>&1; then
				printf 'PASS  %s\n' "$c"
			else
				printf 'FAIL  %s (see %s)\n' "$c" "$logfile"
				tail -n +"$start_line" "$logfile" | tail -n 15 | sed 's/^/  | /'
				failed=1
			fi
		done
	fi

	if [ "$failed" -ne 0 ]; then
		echo "bottega verify: checks failed; fix before gating" >&2
		exit 1
	fi

	if [ "${#gate_args[@]}" -gt 0 ]; then
		"$GATE" "${gate_args[@]}"
	else
		"$GATE"
	fi
}

cmd_ship() {
	local mode="" title="" body=""
	while [ $# -gt 0 ]; do
		case "$1" in
		--draft) mode="draft"; shift ;;
		--ready) mode="ready"; shift ;;
		--title) [ $# -ge 2 ] || { echo "error: --title needs a value" >&2; exit 2; }; title="$2"; shift 2 ;;
		--body) [ $# -ge 2 ] || { echo "error: --body needs a value" >&2; exit 2; }; body="$2"; shift 2 ;;
		*) echo "error: unknown ship option: $1" >&2; exit 2 ;;
		esac
	done
	[ -n "$mode" ] && [ -n "$title" ] || { echo "error: bottega ship needs --draft|--ready and --title" >&2; exit 2; }
	local branch
	branch="$(git symbolic-ref --short HEAD 2>/dev/null || true)"
	if [ -z "$branch" ] || [ "$branch" = "main" ] || [ "$branch" = "master" ]; then
		echo "error: create a feature branch before shipping (currently on '${branch:-detached}')" >&2
		exit 1
	fi
	if [ "$mode" = "ready" ]; then
		local base="" cand origin_head=""
		origin_head="$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null || true)"
		for cand in "$origin_head" origin/main origin/master main master; do
			[ -n "$cand" ] || continue
			if git rev-parse --verify --quiet "$cand" >/dev/null 2>&1; then
				base="$cand"
				break
			fi
		done
		if [ -z "$base" ]; then
			echo "error: cannot determine base branch for one-way-door check; --ready is blocked (use --draft / /ship stop)" >&2
			exit 1
		fi
		local changed=""
		changed="$(git diff --name-only "$base"...HEAD 2>/dev/null || true)"
		if [ -n "$changed" ]; then
			local owd
			owd="$(printf '%s\n' "$changed" | grep -Ei '(^|/)(data_)?migrations?(/|\.|_|-|$)|(^|/)(schema|auth|billing|payments?|security|permissions?|deploy|infra|terraform|drop|delete)(/|\.|_|-|$)|\.tf$|^\.github/workflows/' || true)"
			if [ -n "$owd" ]; then
				echo "error: one-way-door files changed; --ready is blocked (use --draft / /ship stop):" >&2
				printf '%s\n' "$owd" | sed 's/^/  - /' >&2
				exit 1
			fi
		fi
	fi
	if [ -n "$(git status --porcelain 2>/dev/null || true)" ]; then
		echo "error: working tree has uncommitted changes; commit or stash before shipping" >&2
		exit 1
	fi
	if ! "$GATE" >/dev/null 2>&1; then
		echo "error: final gate not passed; run bottega verify before shipping" >&2
		exit 1
	fi
	if ! command -v gh >/dev/null 2>&1 || ! gh auth status >/dev/null 2>&1; then
		echo "error: gh CLI is not installed or not authenticated; run 'gh auth login' before shipping" >&2
		exit 1
	fi
	git push -u origin "$branch"
	if [ "$mode" = "draft" ]; then
		gh pr create --draft --title "$title" --body "$body"
	else
		gh pr create --title "$title" --body "$body"
	fi
}

cmd_worktree() {
	[ "${1:-}" = "audit" ] || { echo 'error: usage: bottega worktree audit [worktree-audit.sh args...]' >&2; exit 2; }
	shift
	"$WT_AUDIT" "$@"
}

[ $# -ge 1 ] || usage 2
sub="$1"; shift
case "$sub" in
start)    cmd_start "$@" ;;
verify)   cmd_verify "$@" ;;
log)      "$LOG" "$@" ;;
ship)     cmd_ship "$@" ;;
worktree) cmd_worktree "$@" ;;
-h|--help|help) usage 0 ;;
*) echo "error: unknown subcommand: $sub" >&2; usage 2 ;;
esac
