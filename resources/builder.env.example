# Headless builder settings for `maestro build` (Claude Code harness, third-party model).
# Copy to ~/.config/bottega/builder.env with `maestro build --init`. No secrets go here.
# The API key lives in ~/.config/bottega/builder.key (mode 600, one line); `--init`
# prompts for it. It reaches claude through apiKeyHelper, never the environment.
#
# Point Claude Code at any Anthropic-compatible endpoint and the model it serves.
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=
# The builder agent uses the `sonnet` alias; map every alias to the same model.
ANTHROPIC_DEFAULT_OPUS_MODEL=
ANTHROPIC_DEFAULT_SONNET_MODEL=
ANTHROPIC_DEFAULT_HAIKU_MODEL=
CLAUDE_CODE_SUBAGENT_MODEL=
# Fallback if you do not want a key file: ANTHROPIC_AUTH_TOKEN=<key> (kept in this
# file, so it is visible in the builder's environment). Prefer builder.key.
