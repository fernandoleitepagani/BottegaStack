# Headless builder settings for `pagani build` (Claude Code harness, third-party model).
# Copy to ~/.config/pagani/builder.env with `pagani build --init`. No secrets go here.
# The API key lives in ~/.config/pagani/builder.key (mode 600, one line); `--init`
# prompts for it. It reaches claude through apiKeyHelper, never the environment.
#
# Defaults point Claude Code at OpenCode Go's Anthropic-compatible endpoint.
ANTHROPIC_BASE_URL=https://opencode.ai/inference/go/anthropic
ANTHROPIC_MODEL=deepseek-v4.1-flash
# The builder agent uses the `sonnet` alias; map every alias to the same model.
ANTHROPIC_DEFAULT_OPUS_MODEL=deepseek-v4.1-flash
ANTHROPIC_DEFAULT_SONNET_MODEL=deepseek-v4.1-flash
ANTHROPIC_DEFAULT_HAIKU_MODEL=deepseek-v4.1-flash
CLAUDE_CODE_SUBAGENT_MODEL=deepseek-v4.1-flash
# Fallback if you do not want a key file: ANTHROPIC_AUTH_TOKEN=<key> (kept in this
# file, so it is visible in the builder's environment). Prefer builder.key.
